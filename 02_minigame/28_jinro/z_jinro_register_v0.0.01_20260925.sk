# ============================================================
# Player Sign + Head Mini Test
#
# 看板を右クリック
#   ↓
# プレイヤー名を看板に表示
#   ↓
# 看板の1ブロック上にプレイヤーヘッド
#
# Armor Standなし
# ============================================================


# ============================================================
# RESET
# ============================================================

command /psr [<text>]:
    permission: psr.admin
    trigger:

        if arg-1 is "reset":

            # 登録データ削除
            delete {psr.sign::*}
            delete {psr.name::*}

            # プレイヤーヘッドを削除
            loop all blocks in radius 50 around player:
                if type of loop-block is player head:
                    set loop-block to air

            send "&a[PSR] リセットしました。"
            stop

        send "&e/psr reset &7- リセット"


# ============================================================
# 看板右クリック
# ============================================================

on right click:

    # 看板以外は無視
    if clicked block is not set:
        stop

    if type of clicked block is not oak sign:
        stop

    cancel event

    # --------------------------------------------------------
    # 看板位置
    # --------------------------------------------------------

    set {_sign} to location of clicked block

    # --------------------------------------------------------
    # すでに登録済みか
    # --------------------------------------------------------

    if {psr.sign::%{_sign}%} is set:
        send "&c[PSR] この看板にはすでに登録されています。"
        stop

    # --------------------------------------------------------
    # プレイヤー登録
    # --------------------------------------------------------

    set {psr.sign::%{_sign}%} to player's uuid
    set {psr.name::%{_sign}%} to player's name

    # --------------------------------------------------------
    # 看板を書き換え
    # --------------------------------------------------------

    set line 1 of clicked block to "&6&lPLAYER"
    set line 2 of clicked block to "&f%player's name%"
    set line 3 of clicked block to ""
    set line 4 of clicked block to ""

    # --------------------------------------------------------
    # 看板の上の位置
    # --------------------------------------------------------

    set {_headLoc} to {_sign}

    add 0.5 to x-coordinate of {_headLoc}
    add 1 to y-coordinate of {_headLoc}
    add 0.5 to z-coordinate of {_headLoc}

    # --------------------------------------------------------
    # プレイヤーヘッドを設置
    # --------------------------------------------------------

    set block at {_headLoc} to player's skull

    # --------------------------------------------------------
    # 完了
    # --------------------------------------------------------

    send "&a[PSR] &f%player's name% &aを登録しました。"
