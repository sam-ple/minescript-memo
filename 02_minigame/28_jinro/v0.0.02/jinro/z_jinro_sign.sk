# ============================================================
# Jinro Sign Register - Mini Test
# Version : v0.4.00
#
# ============================================================
#
# 看板とプレイヤーの紐づけ専用システム
#
# PLAYER 1 / PLAYER 2 などの番号管理はしない
#
# 管理するもの
#
#   看板座標
#       ↓
#   プレイヤーUUID
#
#   プレイヤーUUID
#       ↓
#   看板座標
#
#
# /jinrosignsetstart
#   看板登録モード開始
#
# /jinrosignsetend
#   看板登録モード終了
#
# 登録モード中
#
#   未登録看板を右クリック
#       ↓
#   自分と看板を紐づけ
#       ↓
#   看板にプレイヤー名表示
#   看板の1ブロック上にプレイヤーヘッド
#
#
# 自分の登録済み看板を右クリック
#
#       ↓
#   登録解除
#   看板の文字を全消去
#   プレイヤーヘッドを削除
#   紐づけ削除
#
#
# /jinrosignreset
#
#   登録されている全看板について
#
#   ・看板文字を全消去
#   ・プレイヤーヘッドを削除
#   ・看板 → UUID 削除
#   ・UUID → 看板 削除
#
# ============================================================


# ============================================================
# SET START
# ============================================================

command /jinrosignsetstart:

    trigger:

        set {jinro.sign.registering} to true

        send "&a[JINRO] 看板登録モードを開始しました。"
        send "&7未登録の看板を右クリックしてください。"
        send "&7自分の登録看板を再度クリックすると解除できます。"


# ============================================================
# SET END
# ============================================================

command /jinrosignsetend:

    trigger:

        set {jinro.sign.registering} to false

        send "&e[JINRO] 看板登録モードを終了しました。"


# ============================================================
# RESET
#
# 看板登録情報だけでなく、
# 登録済み看板の表示も完全に消去する
# ============================================================

command /jinrosignreset:

    trigger:

        # ----------------------------------------------------
        # 登録されている全看板を処理
        # ----------------------------------------------------

        loop {jinro.sign.player::*}:

            set {_sign} to loop-index

            # -----------------------------------------------
            # 看板文字を消去
            # -----------------------------------------------

            execute console command "data modify block %{_sign}% front_text.messages set value ['{\"text\":\"\"}','{\"text\":\"\"}','{\"text\":\"\"}','{\"text\":\"\"}']"

            execute console command "data modify block %{_sign}% back_text.messages set value ['{\"text\":\"\"}','{\"text\":\"\"}','{\"text\":\"\"}','{\"text\":\"\"}']"


            # -----------------------------------------------
            # プレイヤーヘッド位置
            # -----------------------------------------------

            set {_headLoc} to {_sign}
            add 1 to y-coordinate of {_headLoc}

            set block at {_headLoc} to air


        # ----------------------------------------------------
        # 登録データ削除
        # ----------------------------------------------------

        delete {jinro.sign.player::*}
        delete {jinro.player.sign::*}
        delete {jinro.player.name::*}

        # ----------------------------------------------------
        # 登録モード終了
        # ----------------------------------------------------

        set {jinro.sign.registering} to false

        send "&a[JINRO] 看板登録情報をリセットしました。"
        send "&7看板文字・プレイヤーヘッドも削除しました。"


# ============================================================
# INFO
# ============================================================

command /jinrosigninfo:

    trigger:

        send "&6&m--------------------------------"
        send "&6[JINRO SIGN INFO]"
        send "&6&m--------------------------------"


        # ----------------------------------------------------
        # 登録モード
        # ----------------------------------------------------

        if {jinro.sign.registering} is true:

            send "&e登録モード: &aON"

        else:

            send "&e登録モード: &cOFF"


        # ----------------------------------------------------
        # 登録人数
        # ----------------------------------------------------

        set {_count} to 0

        loop {jinro.sign.player::*}:

            add 1 to {_count}


        send "&e登録人数: &f%{_count}%"
        send ""


        # ----------------------------------------------------
        # 看板一覧
        # ----------------------------------------------------

        if {_count} is 0:

            send "&7登録看板: なし"

        else:

            loop {jinro.sign.player::*}:

                set {_sign} to loop-index
                set {_uuid} to loop-value

                if {jinro.player.name::%{_uuid}%} is set:

                    set {_name} to {jinro.player.name::%{_uuid}%}

                else:

                    set {_name} to "UNKNOWN"

                send "&e%{_name}% &7→ &f%{_sign}%"


        send "&6&m--------------------------------"


# ============================================================
# 看板右クリック
# ============================================================

on right click:

    # --------------------------------------------------------
    # 看板以外は無視
    # --------------------------------------------------------

    if clicked block is not set:
        stop


    # --------------------------------------------------------
    # oak sign のみ
    #
    # 現在のミニテストでは oak sign のみ
    # --------------------------------------------------------

    if type of clicked block is not oak sign:
        stop


    # --------------------------------------------------------
    # 看板編集画面をキャンセル
    # --------------------------------------------------------

    cancel event


    # --------------------------------------------------------
    # 看板位置
    # --------------------------------------------------------

    set {_sign} to location of clicked block


    # ========================================================
    # すでに登録されている看板
    # ========================================================

    if {jinro.sign.player::%{_sign}%} is set:

        set {_uuid} to {jinro.sign.player::%{_sign}%}


        # ----------------------------------------------------
        # 自分の登録看板
        # ----------------------------------------------------

        if {_uuid} is player's uuid:


            # ------------------------------------------------
            # プレイヤーヘッド位置
            # ------------------------------------------------

            set {_headLoc} to {_sign}

            add 1 to y-coordinate of {_headLoc}


            # ------------------------------------------------
            # プレイヤーヘッド削除
            # ------------------------------------------------

            set block at {_headLoc} to air


            # ------------------------------------------------
            # 看板文字削除
            # ------------------------------------------------

            execute console command "data modify block %{_sign}% front_text.messages set value ['{\"text\":\"\"}','{\"text\":\"\"}','{\"text\":\"\"}','{\"text\":\"\"}']"

            execute console command "data modify block %{_sign}% back_text.messages set value ['{\"text\":\"\"}','{\"text\":\"\"}','{\"text\":\"\"}','{\"text\":\"\"}']"


            # ------------------------------------------------
            # 看板 → プレイヤー削除
            # ------------------------------------------------

            delete {jinro.sign.player::%{_sign}%}


            # ------------------------------------------------
            # プレイヤー → 看板削除
            # ------------------------------------------------

            delete {jinro.player.sign::%{_uuid}%}


            # ------------------------------------------------
            # プレイヤー名削除
            # ------------------------------------------------

            delete {jinro.player.name::%{_uuid}%}


            send "&e[JINRO] 看板の登録を解除しました。"

            stop


        # ----------------------------------------------------
        # 他人の登録看板
        # ----------------------------------------------------

        send "&c[JINRO] この看板は他のプレイヤーが登録しています。"

        stop


    # ========================================================
    # 未登録看板
    # ========================================================


    # --------------------------------------------------------
    # 登録モード確認
    # --------------------------------------------------------

    if {jinro.sign.registering} is not true:

        send "&c[JINRO] 現在、看板登録モードではありません。"

        stop


    # ========================================================
    # プレイヤーがすでに登録済みか
    # ========================================================

    if {jinro.player.sign::%player's uuid%} is set:

        send "&e[JINRO] あなたはすでに登録されています。"
        send "&7自分の登録看板を再度右クリックすると解除できます。"

        stop


    # ========================================================
    # 登録
    # ========================================================


    # --------------------------------------------------------
    # 看板 → プレイヤーUUID
    # --------------------------------------------------------

    set {jinro.sign.player::%{_sign}%} to player's uuid


    # --------------------------------------------------------
    # プレイヤーUUID → 看板
    # --------------------------------------------------------

    set {jinro.player.sign::%player's uuid%} to {_sign}


    # --------------------------------------------------------
    # プレイヤー名
    # --------------------------------------------------------

    set {jinro.player.name::%player's uuid%} to player's name


    # ========================================================
    # 名前を看板表示用に分割
    #
    # 16文字以内
    #   → 3行目
    #
    # 17文字以上
    #   → 3行目 + 4行目
    #
    # ========================================================

    set {_name} to player's name


    if length of {_name} is less than or equal to 16:

        set {_line3} to {_name}
        set {_line4} to ""

    else:

        set {_line3} to first 16 characters of {_name}
        set {_line4} to characters 17 through 32 of {_name}


    # ========================================================
    # 看板 FRONT
    # ========================================================

    execute console command "data modify block %{_sign}% front_text.messages set value ['{\"text\":\"\"}','{\"text\":\"\"}','{\"text\":\"%{_line3}%\"}','{\"text\":\"%{_line4}%\"}']"


    # ========================================================
    # 看板 BACK
    # ========================================================

    execute console command "data modify block %{_sign}% back_text.messages set value ['{\"text\":\"\"}','{\"text\":\"\"}','{\"text\":\"%{_line3}%\"}','{\"text\":\"%{_line4}%\"}']"


    # ========================================================
    # プレイヤーヘッド
    # ========================================================

    set {_headLoc} to {_sign}

    add 1 to y-coordinate of {_headLoc}

    set block at {_headLoc} to player's skull


    # ========================================================
    # 完了
    # ========================================================

    send "&a[JINRO] 看板を登録しました。"
    send "&7プレイヤー: &f%player's name%"
    send "&7看板: &f%{_sign}%"