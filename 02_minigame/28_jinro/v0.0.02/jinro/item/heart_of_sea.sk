# ============================================================
# Jinro RPG
# File : jinro_item.sk
# Version : v0.2.01
#
# 海洋の心 / 占い
#
# 仕様
# ・海洋の心をインベントリに入れたら消費
# ・占い可能状態になる
# ・アクションバーに「占い可能」
# ・夜に占い看板を右クリック
# ・対象プレイヤーの役職をTitle表示
# ・昼に右クリックした場合はChatで「昼なので占い不可」
#
# ============================================================


# ============================================================
# 海洋の心を入手した
# ============================================================

on pickup of heart of the sea:

    # --------------------------------------------------------
    # 人狼RPG稼働中のみ
    # --------------------------------------------------------

    if {jinro.running} is not true:
        stop

    # --------------------------------------------------------
    # 人狼RPGワールドのみ
    # --------------------------------------------------------

    if {jinro.world} is not set:
        stop

    if world of player is not {jinro.world}:
        stop

    # --------------------------------------------------------
    # 海洋の心を消費
    # --------------------------------------------------------

    remove 1 heart of the sea from player's inventory

    # --------------------------------------------------------
    # 占い可能
    # --------------------------------------------------------

    set {jinro.divine.%uuid of player%} to true

    send action bar "&b海洋の心を購入しました　&f占い可能" to player


# ============================================================
# 占い看板
#
# 看板を右クリックすると占い
# ============================================================

on right click on sign:

    # --------------------------------------------------------
    # 人狼RPG稼働中
    # --------------------------------------------------------

    if {jinro.running} is not true:
        stop

    # --------------------------------------------------------
    # 人狼RPGワールド
    # --------------------------------------------------------

    if {jinro.world} is not set:
        stop

    if world of player is not {jinro.world}:
        stop

    # --------------------------------------------------------
    # 占い可能か
    # --------------------------------------------------------

    if {jinro.divine.%uuid of player%} is not true:
        stop

    # --------------------------------------------------------
    # 昼なら占えない
    # --------------------------------------------------------

    if {jinro.night} is not true:
        send "&c昼なので占い不可です。" to player
        stop

    # --------------------------------------------------------
    # 看板に登録されたプレイヤーを取得
    # --------------------------------------------------------

    if {jinro.sign.player.%location of clicked block%} is not set:
        send "&cこの看板にはプレイヤーが登録されていません。" to player
        stop

    set {_target} to {jinro.sign.player.%location of clicked block%}

    # --------------------------------------------------------
    # 自分自身
    # --------------------------------------------------------

    if {_target} is player:
        send "&c自分自身は占えません。" to player
        stop

    # --------------------------------------------------------
    # 対象プレイヤーがオンラインか
    # --------------------------------------------------------

    if {_target} is not online:
        send "&c対象プレイヤーがオンラインではありません。" to player
        stop

    # --------------------------------------------------------
    # 役職取得
    # --------------------------------------------------------

    set {_role} to {jinro.role.%uuid of {_target}%}

    if {_role} is not set:
        send "&c対象プレイヤーの役職が設定されていません。" to player
        stop

    # --------------------------------------------------------
    # 占い消費
    # --------------------------------------------------------

    delete {jinro.divine.%uuid of player%}

    # --------------------------------------------------------
    # 結果表示
    # --------------------------------------------------------

    send action bar "&b占いを使用しました" to player

    send title "&f%{jinro.role.%uuid of {_target}%}%" with subtitle "&7%name of {_target}%" to player for 2 seconds
