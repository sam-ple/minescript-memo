# ============================================================
# Jinro Sign Register - Mini Test
# Version : v0.3.00
#
# 看板登録システム
#
# /jinrosignsetstart
#   → 看板登録モード開始
#
# /jinrosignsetend
#   → 看板登録モード終了
#
# 登録モード中
#   空の看板を右クリック
#       ↓
#   空いているPLAYER番号へ登録
#
# 登録済みプレイヤーが
# 自分の看板を右クリック
#       ↓
#   登録解除
#
# PLAYER番号は固定ではなく、
# 空いている番号を自動使用
#
# /jinrosignreset
#   → 看板登録情報だけリセット
#
# ============================================================


options:

    # --------------------------------------------------------
    # 最大参加人数
    # --------------------------------------------------------

    max-players: 8


# ============================================================
# 登録モード
# ============================================================

command /jinrosignsetstart:

    trigger:

        set {jinro.sign.registering} to true

        send "&a[JINRO] 看板登録モードを開始しました。"
        send "&7看板を右クリックしてプレイヤーを登録してください。"
        send "&7登録済みの自分の看板を再度クリックすると解除できます。"


# ============================================================
# 登録モード終了
# ============================================================

command /jinrosignsetend:

    trigger:

        set {jinro.sign.registering} to false

        send "&e[JINRO] 看板登録モードを終了しました。"


# ============================================================
# RESET
#
# 看板登録情報のみリセット
#
# ※看板の文字・プレイヤーヘッドは変更しない
# ============================================================

command /jinrosignreset:

    trigger:

        delete {jinro.players::*}

        delete {jinro.sign.player::*}
        delete {jinro.player.sign::*}
        delete {jinro.player.name::*}

        set {jinro.sign.registering} to false

        send "&a[JINRO] 看板登録情報をリセットしました。"


# ============================================================
# INFO
# ============================================================

command /jinrosigninfo:

    trigger:

        send "&6&m--------------------------------"
        send "&6[JINRO SIGN INFO]"
        send "&6&m--------------------------------"

        if {jinro.sign.registering} is true:
            send "&e登録モード: &aON"
        else:
            send "&e登録モード: &cOFF"

        send "&e最大人数: &f{@max-players}"
        send ""

        loop {@max-players} times:

            set {_n} to loop-number

            if {jinro.players::%{_n}%} is set:

                set {_uuid} to {jinro.players::%{_n}%}

                if {jinro.player.name::%{_uuid}%} is set:
                    set {_name} to {jinro.player.name::%{_uuid}%}
                else:
                    set {_name} to "UNKNOWN"

                send "&ePLAYER %{_n}%: &f%{_name}%"

            else:

                send "&7PLAYER %{_n}%: 未登録"

        send "&6&m--------------------------------"


# ============================================================
# 看板右クリック
# ============================================================

on right click:

    # --------------------------------------------------------
    # 看板以外は無視
    # --------------------------------------------------------

    if clicked block is not set:
        stop

    if type of clicked block is not oak sign:
        stop


    # --------------------------------------------------------
    # 看板編集画面をキャンセル
    # --------------------------------------------------------

    cancel event


    # --------------------------------------------------------
    # 看板位置
    # --------------------------------------------------------

    set {_sign} to location of clicked block


    # ========================================================
    # すでに登録されている看板
    # ========================================================

    if {jinro.sign.player::%{_sign}%} is set:

        set {_uuid} to {jinro.sign.player::%{_sign}%}


        # ----------------------------------------------------
        # この看板が自分のものか
        # ----------------------------------------------------

        if {_uuid} is player's uuid:

            # -----------------------------------------------
            # PLAYER番号を探す
            # -----------------------------------------------

            loop {@max-players} times:

                set {_n} to loop-number

                if {jinro.players::%{_n}%} is {_uuid}:

                    delete {jinro.players::%{_n}%}

                    stop loop


            # -----------------------------------------------
            # 看板 → プレイヤー
            # -----------------------------------------------

            delete {jinro.sign.player::%{_sign}%}


            # -----------------------------------------------
            # プレイヤー → 看板
            # -----------------------------------------------

            delete {jinro.player.sign::%{_uuid}%}


            # -----------------------------------------------
            # プレイヤー名
            # -----------------------------------------------

            delete {jinro.player.name::%{_uuid}%}


            send "&e[JINRO] 看板の登録を解除しました。"

            stop


        # ----------------------------------------------------
        # 他人が登録した看板
        # ----------------------------------------------------

        send "&c[JINRO] この看板は他のプレイヤーが登録しています。"

        stop


    # ========================================================
    # 未登録の看板
    # ========================================================

    # --------------------------------------------------------
    # 登録モード確認
    # --------------------------------------------------------

    if {jinro.sign.registering} is not true:

        send "&c[JINRO] 現在、看板登録モードではありません。"

        stop


    # --------------------------------------------------------
    # プレイヤーがすでに登録されているか
    # --------------------------------------------------------

    if {jinro.player.sign::%player's uuid%} is set:

        send "&e[JINRO] あなたはすでに登録されています。"
        send "&7自分の登録看板をもう一度クリックすると解除できます。"

        stop


    # ========================================================
    # 空いているPLAYER番号を探す
    # ========================================================

    delete {_slot}


    loop {@max-players} times:

        set {_n} to loop-number

        if {jinro.players::%{_n}%} is not set:

            set {_slot} to {_n}

            stop loop


    # --------------------------------------------------------
    # 空きがない
    # --------------------------------------------------------

    if {_slot} is not set:

        send "&c[JINRO] 参加者は最大 {@max-players} 人までです。"

        stop


    # ========================================================
    # プレイヤー登録
    # ========================================================

    set {jinro.players::%{_slot}%} to player's uuid


    # --------------------------------------------------------
    # 看板 → プレイヤー
    # --------------------------------------------------------

    set {jinro.sign.player::%{_sign}%} to player's uuid


    # --------------------------------------------------------
    # プレイヤー → 看板
    # --------------------------------------------------------

    set {jinro.player.sign::%player's uuid%} to {_sign}


    # --------------------------------------------------------
    # プレイヤー名
    # --------------------------------------------------------

    set {jinro.player.name::%player's uuid%} to player's name


    # ========================================================
    # 看板を書き換え
    # ========================================================

    set line 1 of clicked block to ""
    set line 2 of clicked block to "&6&lPLAYER %{_slot}%"
    set line 3 of clicked block to "&f%player's name%"
    set line 4 of clicked block to ""


    # ========================================================
    # プレイヤーヘッド
    # ========================================================

    set {_headLoc} to {_sign}

    add 1 to y-coordinate of {_headLoc}

    set block at {_headLoc} to player's skull


    # ========================================================
    # 完了メッセージ
    # ========================================================

    send "&a[JINRO] PLAYER %{_slot}% に登録しました。"
    send "&7プレイヤー: &f%player's name%"


# ============================================================
# END
# ============================================================