# =========================================================
# Jinro RPG
# File : jinro_mob.sk
# Version : v0.1.00
#
# SKELETON SYSTEM
#
# /jinromob set
# /jinromob scan
# /jinromob info
# /jinromob reset
#
# 仕様
#
# 1. ステージ起点を登録
# 2. 半径30ブロックを1回だけスキャン
# 3. 安全地点を保存
# 4. 夜になったらスケルトンを召喚
# 5. 朝になったらJinroスケルトンだけ削除
#
# =========================================================


options:

    scan-radius: 30
    min-spawn-distance: 6
    spawn-amount: 1


# =========================================================
# COMMAND
# =========================================================

command /jinromob [<text>]:

    permission: jinro.admin
    permission message: "&c権限がありません。"

    trigger:


        # =====================================================
        # HELP
        # =====================================================

        if arg-1 is not set:

            send ""
            send "&6&l===== Jinro Mob ====="
            send "&e/jinromob set &7- ステージ起点を登録"
            send "&e/jinromob scan &7- 安全地点を1回スキャン"
            send "&e/jinromob info &7- 状態確認"
            send "&e/jinromob reset &7- リセット"
            send ""

            stop


        # =====================================================
        # SET
        # =====================================================

        if arg-1 is "set":

            set {jinro.mob.origin} to location of player
            set {jinro.mob.world} to world of player

            set {jinro.mob.scanned} to false

            delete {jinro.mob.safe::*}
            delete {jinro.mob.safe-count}
            delete {jinro.mob.scan-columns}

            send ""
            send "&a&l[JINRO MOB] ステージ起点を登録しました。"
            send "&7World: &f%world of player%"
            send "&7X: &f%x-coordinate of player%"
            send "&7Y: &f%y-coordinate of player%"
            send "&7Z: &f%z-coordinate of player%"
            send ""
            send "&e次に /jinromob scan を実行してください。"
            send ""

            stop


        # =====================================================
        # SCAN
        # =====================================================

        if arg-1 is "scan":

            if {jinro.mob.origin} is not set:

                send "&c先に /jinromob set を実行してください。"

                stop


            if {jinro.mob.scanned} is true:

                send "&eすでにスキャン済みです。"
                send "&7再スキャンする場合は /jinromob reset を実行してください。"

                stop


            send ""
            send "&e&l[JINRO MOB] スキャン開始"
            send "&7半径: &f{@scan-radius}"
            send "&7起点: &f%x-coordinate of {jinro.mob.origin}%, %y-coordinate of {jinro.mob.origin}%, %z-coordinate of {jinro.mob.origin}%"
            send "&c※完了まで少し時間がかかります。"
            send ""


            delete {jinro.mob.safe::*}


            # =================================================
            # WORLD
            # =================================================

            set {_world} to {jinro.mob.world}


            # =================================================
            # CENTER
            # =================================================

            set {_center-x} to floor(x-coordinate of {jinro.mob.origin})
            set {_center-z} to floor(z-coordinate of {jinro.mob.origin})


            # =================================================
            # RANGE
            # =================================================

            set {_min-x} to {_center-x} - {@scan-radius}
            set {_max-x} to {_center-x} + {@scan-radius}

            set {_min-z} to {_center-z} - {@scan-radius}
            set {_max-z} to {_center-z} + {@scan-radius}


            set {_columns} to 0
            set {_safe} to 0


            # =================================================
            # X
            # =================================================

            loop integers between {_min-x} and {_max-x}:

                set {_x} to loop-value


                # =================================================
                # Z
                # =================================================

                loop integers between {_min-z} and {_max-z}:

                    set {_z} to loop-value-2

                    add 1 to {_columns}


                    # -----------------------------------------
                    # COLUMN
                    # -----------------------------------------

                    set {_column} to location at {_x}, 0, {_z} in {_world}

                    set {_floor} to highest solid block at {_column}


                    if {_floor} is set:


                        # -------------------------------------
                        # TWO AIR BLOCKS
                        # -------------------------------------

                        set {_one} to block above {_floor}
                        set {_two} to block above {_one}


                        if {_one} is air:

                            if {_two} is air:


                                # ---------------------------------
                                # WATER / LAVA
                                # ---------------------------------

                                if {_floor} is not water:

                                    if {_floor} is not lava block:


                                        # ---------------------------------
                                        # LEAVES
                                        # ---------------------------------

                                        if {_floor} is not oak leaves:

                                            if {_floor} is not spruce leaves:

                                                if {_floor} is not birch leaves:

                                                    if {_floor} is not jungle leaves:

                                                        if {_floor} is not acacia leaves:

                                                            if {_floor} is not dark oak leaves:

                                                                if {_floor} is not mangrove leaves:

                                                                    if {_floor} is not cherry leaves:

                                                                        if {_floor} is not azalea leaves:

                                                                            if {_floor} is not flowering azalea leaves:


                                                                                # ---------------------------------
                                                                                # SPAWN LOCATION
                                                                                # ---------------------------------

                                                                                set {_spawn} to location of {_floor}

                                                                                add 0.5 to x-coordinate of {_spawn}
                                                                                add 1 to y-coordinate of {_spawn}
                                                                                add 0.5 to z-coordinate of {_spawn}


                                                                                # ---------------------------------
                                                                                # SAVE
                                                                                # ---------------------------------

                                                                                add {_spawn} to {jinro.mob.safe::*}

                                                                                add 1 to {_safe}


            # =================================================
            # SCAN COMPLETE
            # =================================================

            set {jinro.mob.scanned} to true
            set {jinro.mob.safe-count} to {_safe}
            set {jinro.mob.scan-columns} to {_columns}


            send ""
            send "&a&l[JINRO MOB] スキャン完了"
            send "&7調査した列: &f%{_columns}%"
            send "&7安全地点: &a%{_safe}%"
            send ""


            if {_safe} is 0:

                send "&c安全なスポーン地点がありません。"

                set {jinro.mob.scanned} to false

            else:

                send "&aスケルトンの夜間スポーンが使用できます。"
                send "&7安全地点は保存済みです。"


            send ""

            stop


        # =====================================================
        # INFO
        # =====================================================

        if arg-1 is "info":

            send ""
            send "&6&l===== Jinro Mob INFO ====="

            if {jinro.mob.origin} is set:

                send "&7起点: &f%{jinro.mob.origin}%"

            else:

                send "&7起点: &c未設定"


            send "&7World: &f%{jinro.mob.world}%"
            send "&7スキャン済み: &f%{jinro.mob.scanned}%"
            send "&7安全地点: &f%{jinro.mob.safe-count}%"
            send "&7調査列: &f%{jinro.mob.scan-columns}%"

            send ""

            stop


        # =====================================================
        # RESET
        # =====================================================

        if arg-1 is "reset":

            delete {jinro.mob.origin}
            delete {jinro.mob.world}

            delete {jinro.mob.safe::*}

            delete {jinro.mob.scanned}
            delete {jinro.mob.safe-count}
            delete {jinro.mob.scan-columns}

            delete {jinro.mob.spawned}


            # Jinro専用スケルトンだけ削除

            execute console command "kill @e[type=minecraft:skeleton,tag=jinro_skeleton]"


            send ""
            send "&a&l[JINRO MOB] リセット完了"
            send "&7起点を削除しました。"
            send "&7スキャン結果を削除しました。"
            send "&7Jinro用スケルトンを削除しました。"
            send ""

            stop


        # =====================================================
        # UNKNOWN
        # =====================================================

        send "&c不明なコマンドです。"
        send "&e/jinromob &7でヘルプを表示できます。"


# =========================================================
# NIGHT SPAWN
# =========================================================

every 1 second:

    # ---------------------------------------------------------
    # GAME CHECK
    # ---------------------------------------------------------

    if {jinro.running} is not true:

        stop


    # ---------------------------------------------------------
    # WORLD CHECK
    # ---------------------------------------------------------

    if {jinro.mob.world} is not set:

        stop


    # ---------------------------------------------------------
    # SCAN CHECK
    # ---------------------------------------------------------

    if {jinro.mob.scanned} is not true:

        stop


    # ---------------------------------------------------------
    # NIGHT CHECK
    # ---------------------------------------------------------

    if {jinro.phase} is not "night":

        stop


    # ---------------------------------------------------------
    # ALREADY SPAWNED
    # ---------------------------------------------------------

    if {jinro.mob.spawned} is true:

        stop


    # ---------------------------------------------------------
    # SAFE POINT CHECK
    # ---------------------------------------------------------

    if size of {jinro.mob.safe::*} < {@spawn-amount}:

        stop


    # ---------------------------------------------------------
    # SELECT
    # ---------------------------------------------------------

    delete {_selected::*}

    set {_attempts} to 0
    set {_max-attempts} to size of {jinro.mob.safe::*} * 20


    while size of {_selected::*} < {@spawn-amount}:

        add 1 to {_attempts}


        if {_attempts} > {_max-attempts}:

            stop loop


        set {_candidate} to random element out of {jinro.mob.safe::*}


        if {_candidate} is not in {_selected::*}:

            set {_okay} to true


            loop {_selected::*}:

                if distance between {_candidate} and loop-value < {@min-spawn-distance}:

                    set {_okay} to false

                    stop loop


            if {_okay} is true:

                add {_candidate} to {_selected::*}


    # ---------------------------------------------------------
    # SPAWN
    # ---------------------------------------------------------

    loop {_selected::*}:

        set {_loc} to loop-value

        set {_x} to x-coordinate of {_loc}
        set {_y} to y-coordinate of {_loc}
        set {_z} to z-coordinate of {_loc}

        set {_world} to {jinro.mob.world}


        execute console command "execute in minecraft:%{_world}% run summon minecraft:skeleton %{_x}% %{_y}% %{_z}% {Tags:[""jinro_skeleton""],Health:2.0f,HandItems:[{},{}]}"


    set {jinro.mob.spawned} to true


    send "&c&l[JINRO] 夜になりました。"
    send "&7スケルトンが出現しました。" to {jinro.players::*}


# =========================================================
# DAY CLEANUP
# =========================================================

every 1 second:

    if {jinro.running} is not true:

        stop


    if {jinro.phase} is not "day":

        stop


    if {jinro.mob.spawned} is not true:

        stop


    # ---------------------------------------------------------
    # DELETE ONLY JINRO SKELETONS
    # ---------------------------------------------------------

    execute console command "execute in minecraft:%{jinro.mob.world}% run kill @e[type=minecraft:skeleton,tag=jinro_skeleton]"


    delete {jinro.mob.spawned}


    send "&a&l[JINRO] 朝になりました。"
    send "&7スケルトンが消えました。" to {jinro.players::*}


# =========================================================
# SKELETON DEATH
# =========================================================

on death of skeleton:

    if attacker is a player:

        # Jinro専用スケルトンのみ

        if victim's name is not set:
            stop

        # 現段階では50%でエメラルド

        chance of 50%:

            give 1 emerald to attacker

            send "&a&l[JINRO] &fエメラルドを1個獲得！" to attacker
