# ============================================================
# Jinro RPG
# File : jinro_daynight.sk
#
# 昼 / 夜
#
# ゲーム開始直後
#   昼   30秒
#
# その後
#   夜   120秒
#   昼   120秒
#   夜   120秒
#   昼   120秒
#   ...
#
# ============================================================


options:

    first-day-time: 30
    day-time: 120
    night-time: 120


# ============================================================
# 1秒ごと
# ============================================================

every 1 second:

    if {jinro.running} is not true:
        stop

    if {jinro.world} is not set:
        stop


    # --------------------------------------------------------
    # 1秒減らす
    # --------------------------------------------------------

    subtract 1 from {jinro.time}


    # --------------------------------------------------------
    # 時間切れ
    # --------------------------------------------------------

    if {jinro.time} <= 0:


        # ====================================================
        # 昼 → 夜
        # ====================================================

        if {jinro.phase} is "day":

            set {jinro.phase} to "night"
            set {jinro.time} to {@night-time}

            set time of {jinro.world} to 19:00

            send "&1========================================" to {jinro.players::*}
            send "&9&l[JINRO] 夜になりました" to {jinro.players::*}
            send "&7夜時間: &f{@night-time}秒" to {jinro.players::*}
            send "&1========================================" to {jinro.players::*}


        # ====================================================
        # 夜 → 昼
        # ====================================================

        else:

            set {jinro.phase} to "day"
            set {jinro.time} to {@day-time}

            set time of {jinro.world} to 7:00

            send "&e========================================" to {jinro.players::*}
            send "&6&l[JINRO] 朝になりました" to {jinro.players::*}
            send "&7昼時間: &f{@day-time}秒" to {jinro.players::*}
            send "&e========================================" to {jinro.players::*}
