# ============================================================
# Jinro RPG
# File : jinro_role.sk
# Version : v0.2.00
#
# 2人テスト用役職
#
# vv = 村人 + 村人
# wv = 人狼 + 村人
# va = 村人 + 吸血鬼
# vl = 村人 + 狼付き
#
# PLAYER 1
# PLAYER 2
# を固定して使用
# ============================================================


# ============================================================
# 役職名
# ============================================================

function jinro_role_name(role: text) :: text:

    if {_role} is "villager":
        return "村人"

    if {_role} is "wolf":
        return "人狼"

    if {_role} is "vampire":
        return "吸血鬼"

    if {_role} is "wolf_attendant":
        return "狼付き"

    return "不明"


# ============================================================
# 役職設定
# ============================================================

function jinro_set_roles(role1: text, role2: text):

    # --------------------------------------------------------
    # PLAYER 1
    # --------------------------------------------------------

    if {jinro.players::1} is set:

        set {jinro.role::%{jinro.players::1}%} to {_role1}


    # --------------------------------------------------------
    # PLAYER 2
    # --------------------------------------------------------

    if {jinro.players::2} is set:

        set {jinro.role::%{jinro.players::2}%} to {_role2}


# ============================================================
# 役職削除
# ============================================================

function jinro_clear_roles():

    delete {jinro.role::*}


# ============================================================
# 役職確認
# ============================================================

function jinro_get_role(player: player) :: text:

    if {jinro.role::%{_player}%} is set:

        return {jinro.role::%{_player}%}

    return "none"
