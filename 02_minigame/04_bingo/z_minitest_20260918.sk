# ============================================================
# BINGO MINI TEST
# Version : v0.1.00
#
# Minecraft Java Edition
# Paper + Skript
#
# ============================================================
#
# PURPOSE
#
#   1個だけのBINGOマスを使った単体テスト。
#
#   入力用額縁に正解アイテムを入れると、
#
#       背面ブロック
#           WHITE_GLASS
#               ↓
#           GOLD_BLOCK
#
#       額縁
#           ITEM_FRAME
#               ↓
#           GLOW_ITEM_FRAME
#
#   に変更する。
#
# ============================================================


# ============================================================
# SETTINGS
# ============================================================

# 今回のBINGOアイテム
set {bingotest.answer} to apple


# ============================================================
# /BINGOTEST
# ============================================================

command /bingotest [<text>]:

    permission: op

    trigger:

        # ----------------------------------------------------
        # SETUP
        # ----------------------------------------------------

        if arg-1 is "setup":

            # 既存テストを消す
            execute console command "kill @e[tag=bingotest_frame]"

            # ------------------------------------------------
            # 基準位置
            #
            # プレイヤーの足元を基準にする
            # ------------------------------------------------

            set {_base} to location of player

            # 少し前方に作る
            add 3 to z-coordinate of {_base}

            set {_x} to x-coordinate of {_base}
            set {_y} to y-coordinate of {_base}
            set {_z} to z-coordinate of {_base}


            # ------------------------------------------------
            # GROUND
            # ------------------------------------------------

            set block at {_base} to emerald block


            # ------------------------------------------------
            # INPUT SIDE
            #
            #        入力額縁
            #           ↑
            #        stone
            #           ↑
            #       emerald
            #
            # ------------------------------------------------

            set {_inputStone} to {_base}
            add 1 to y-coordinate of {_inputStone}

            set block at {_inputStone} to stone


            # 入力用額縁
            #
            # stoneの上
            # base + Y2
            #
            set {_inputFrame} to {_base}
            add 2 to y-coordinate of {_inputFrame}


            set {_ix} to x-coordinate of {_inputFrame}
            set {_iy} to y-coordinate of {_inputFrame}
            set {_iz} to z-coordinate of {_inputFrame}


            execute console command "summon minecraft:item_frame %{_ix}% %{_iy}% %{_iz}% {Facing:3b,Fixed:1b,Invulnerable:1b,Tags:[""bingotest_input""]}"


            # ------------------------------------------------
            # BINGO SIDE
            #
            # 入力側の右
            #
            #   ガラス
            #   額縁
            #
            # ------------------------------------------------

            set {_bingoBase} to {_base}
            add 2 to x-coordinate of {_bingoBase}

            # 下のブロック
            set block at {_bingoBase} to quartz block


            # ガラス
            set {_glass} to {_bingoBase}
            add 1 to y-coordinate of {_glass}

            set block at {_glass} to white stained glass


            # BINGO額縁
            set {_bingoFrame} to {_bingoBase}
            add 2 to y-coordinate of {_bingoFrame}


            set {_bx} to x-coordinate of {_bingoFrame}
            set {_by} to y-coordinate of {_bingoFrame}
            set {_bz} to z-coordinate of {_bingoFrame}


            # りんご入り額縁
            execute console command "summon minecraft:item_frame %{_bx}% %{_by}% %{_bz}% {Facing:3b,Fixed:1b,Invulnerable:1b,Tags:[""bingotest_frame""]}"


            # 額縁に正解アイテムを入れる
            wait 2 ticks

            set {_frame} to item frame at {_bingoFrame}

            if {_frame} is set:
                set item of {_frame} to {bingotest.answer}


            # ------------------------------------------------
            # VARIABLES
            # ------------------------------------------------

            set {bingotest.input} to {_inputFrame}
            set {bingotest.bingo} to {_bingoFrame}
            set {bingotest.base} to {_base}

            set {bingotest.completed} to false


            # ------------------------------------------------
            # MESSAGE
            # ------------------------------------------------

            send "" to player
            send "&6&l==============================" to player
            send "&e&l       BINGO MINI TEST" to player
            send "&6&l==============================" to player
            send "" to player
            send "&f正解アイテム：" to player
            send "&a&lAPPLE" to player
            send "" to player
            send "&7入力用額縁にAPPLEを入れてください。" to player
            send "" to player

            stop


        # ====================================================
        # RESET
        # ====================================================

        if arg-1 is "reset":

            set {bingotest.completed} to false

            # 入力額縁を消す
            if {bingotest.input} is set:

                set {_frame} to item frame at {bingotest.input}

                if {_frame} is set:
                    kill {_frame}


            # BINGO額縁を消す
            if {bingotest.bingo} is set:

                set {_frame} to item frame at {bingotest.bingo}

                if {_frame} is set:
                    kill {_frame}


            # 基準位置
            if {bingotest.base} is set:

                set {_base} to {bingotest.base}


                # ------------------------------------------------
                # INPUT SIDE
                # ------------------------------------------------

                set block at {_base} to emerald block

                set {_loc} to {_base}
                add 1 to y-coordinate of {_loc}

                set block at {_loc} to stone


                # ------------------------------------------------
                # BINGO SIDE
                # ------------------------------------------------

                set {_loc} to {_base}
                add 2 to x-coordinate of {_loc}

                set block at {_loc} to quartz block

                add 1 to y-coordinate of {_loc}

                set block at {_loc} to white stained glass


                # ------------------------------------------------
                # INPUT FRAME
                # ------------------------------------------------

                set {_loc} to {_base}
                add 2 to y-coordinate of {_loc}

                set {_x} to x-coordinate of {_loc}
                set {_y} to y-coordinate of {_loc}
                set {_z} to z-coordinate of {_loc}

                execute console command "summon minecraft:item_frame %{_x}% %{_y}% %{_z}% {Facing:3b,Fixed:1b,Invulnerable:1b,Tags:[""bingotest_input""]}"


                # ------------------------------------------------
                # BINGO FRAME
                # ------------------------------------------------

                set {_loc} to {_base}
                add 2 to x-coordinate of {_loc}
                add 2 to y-coordinate of {_loc}

                set {_x} to x-coordinate of {_loc}
                set {_y} to y-coordinate of {_loc}
                set {_z} to z-coordinate of {_loc}

                execute console command "summon minecraft:item_frame %{_x}% %{_y}% %{_z}% {Facing:3b,Fixed:1b,Invulnerable:1b,Tags:[""bingotest_frame""]}"

                wait 2 ticks

                set {_frame} to item frame at {_loc}

                if {_frame} is set:
                    set item of {_frame} to {bingotest.answer}


                set {bingotest.input} to {_base}
                add 2 to y-coordinate of {bingotest.input}

                set {bingotest.bingo} to {_base}
                add 2 to x-coordinate of {bingotest.bingo}
                add 2 to y-coordinate of {bingotest.bingo}


            send "&aBINGO MINI TESTをリセットしました。" to player

            stop


        # ====================================================
        # STATUS
        # ====================================================

        if arg-1 is "status":

            if {bingotest.completed} is true:

                send "&aBINGO TEST : &lCOMPLETE" to player

            else:

                send "&eBINGO TEST : &lWAITING" to player

            stop


        # ====================================================
        # HELP
        # ====================================================

        send "" to player
        send "&6&lBINGO MINI TEST" to player
        send "&7/bingotest setup  &f- テスト会場を作成"
        send "&7/bingotest reset  &f- テストを初期状態へ"
        send "&7/bingotest status &f- 状態確認"
        send "" to player


# ============================================================
# INPUT CHECK
# ============================================================
#
# 入力用額縁の中身を定期的に確認。
#
# 本番では「アイテム取得判定」に発展させる。
#
# ============================================================

every 2 ticks:

    if {bingotest.input} is not set:
        stop

    if {bingotest.bingo} is not set:
        stop

    if {bingotest.completed} is true:
        stop


    # --------------------------------------------------------
    # INPUT FRAME
    # --------------------------------------------------------

    set {_inputFrame} to item frame at {bingotest.input}

    if {_inputFrame} is not set:
        stop


    # --------------------------------------------------------
    # INPUT ITEM
    # --------------------------------------------------------

    set {_inputItem} to item of {_inputFrame}

    if {_inputItem} is air:
        stop


    # --------------------------------------------------------
    # ANSWER CHECK
    # --------------------------------------------------------

    if {_inputItem} is not {bingotest.answer}:
        stop


    # ========================================================
    # BINGO COMPLETE
    # ========================================================

    set {bingotest.completed} to true


    # --------------------------------------------------------
    # BINGO BACK BLOCK
    #
    # white stained glass
    #       ↓
    # gold block
    # --------------------------------------------------------

    set {_gold} to {bingotest.bingo}

    add 1 to y-coordinate of {_gold}

    set block at {_gold} to gold block


    # --------------------------------------------------------
    # REMOVE OLD FRAME
    # --------------------------------------------------------

    set {_oldFrame} to item frame at {bingotest.bingo}

    if {_oldFrame} is set:

        set {_clearItem} to item of {_oldFrame}

        kill {_oldFrame}


    # --------------------------------------------------------
    # GLOW ITEM FRAME
    # --------------------------------------------------------

    set {_glowLocation} to {bingotest.bingo}

    set {_gx} to x-coordinate of {_glowLocation}
    set {_gy} to y-coordinate of {_glowLocation}
    set {_gz} to z-coordinate of {_glowLocation}


    execute console command "summon minecraft:glow_item_frame %{_gx}% %{_gy}% %{_gz}% {Facing:3b,Fixed:1b,Invulnerable:1b,Tags:[""bingotest_frame""]}"


    wait 2 ticks


    set {_newFrame} to glow item frame at {_glowLocation}

    if {_newFrame} is set:

        set item of {_newFrame} to {_clearItem}


    # --------------------------------------------------------
    # MESSAGE
    # --------------------------------------------------------

    send "" to all players
    send "&6&l==============================" to all players
    send "&e&l          BINGO!!" to all players
    send "&f正解アイテムが入力されました！" to all players
    send "&6&l==============================" to all players
    send "" to all players

    play sound "entity.player.levelup" with volume 1 and pitch 1.2 to all players
