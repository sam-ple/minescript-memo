# ============================================================
# BINGO GAME SYSTEM
# Version : v0.2.00
#
# Minecraft Java Edition
# Paper + Skript
#
# ============================================================
#
# MINECRAFT STAGE
#
#   MineScript:
#
#       bingo_stage.py
#
#   MineScript担当:
#
#       ・会場整地
#       ・5部隊盤面生成
#       ・3x3 ITEM FRAME
#       ・登録用STONE BUTTON
#       ・PLAYER HEAD用スペース
#       ・bingo_board_1～5 marker
#       ・bingo_origin marker
#
#
# SKRIPT担当:
#
#       ・BINGO ITEM設定
#       ・SET
#       ・SET2
#       ・プレイヤー登録
#       ・通常PLAYER HEAD
#       ・大型PLAYER HEAD
#       ・ゲーム管理
#       ・RESET
#
#
# ============================================================
#
# ITEM SETTING
#
#   この9種類を変更して、
#
#       /sk reload bingo
#
#   ↓
#
#       /bingo
#
#   ↓
#
#       SET2
#
#   とすることで、5部隊すべての盤面を更新できる。
#
#   SET2を何回実行しても問題なし。
#   盤面のアイテムが上書きされるだけ。
#
#   ゲーム終了後にアイテムを変更して
#   再度 SET2 することも可能。
#
# ============================================================


# ============================================================
# BINGO ITEMS
#
# ここだけ変更すればBINGOのお題を変更できる。
#
# 1 ～ 9 が3x3の順番。
#
# ============================================================

set {bingo.items::1} to apple
set {bingo.items::2} to bread
set {bingo.items::3} to carrot

set {bingo.items::4} to potato
set {bingo.items::5} to golden apple
set {bingo.items::6} to cooked beef

set {bingo.items::7} to cooked porkchop
set {bingo.items::8} to melon slice
set {bingo.items::9} to cookie


# ============================================================
# LOAD
# ============================================================

on load:

    # --------------------------------------------------------
    # ゲーム中フラグ
    #
    # reload時にゲーム状態を強制終了しない。
    # --------------------------------------------------------

    if {bingo.running} is not set:
        set {bingo.running} to false

    if {bingo.setup} is not set:
        set {bingo.setup} to false


# ============================================================
# /BINGO
# ============================================================

command /bingo:

    permission: op

    trigger:

        set {_gui} to chest inventory with 1 row named "&6BINGO ADMIN"


        # ====================================================
        # SET
        # ====================================================

        set slot 1 of {_gui} to emerald named "&a&lSET"
        set lore of slot 1 of {_gui} to "&7Prepare the BINGO stage"


        # ====================================================
        # SET2
        # ====================================================

        set slot 3 of {_gui} to paper named "&e&lSET2"
        set lore of slot 3 of {_gui} to "&7Apply the 9 BINGO items"


        # ====================================================
        # START
        # ====================================================

        set slot 5 of {_gui} to diamond named "&b&lSTART"
        set lore of slot 5 of {_gui} to "&7Start BINGO"


        # ====================================================
        # RESET
        # ====================================================

        set slot 7 of {_gui} to barrier named "&c&lRESET"
        set lore of slot 7 of {_gui} to "&7Reset BINGO"


        open {_gui} to player


# ============================================================
# ADMIN GUI
# ============================================================

on inventory click:

    if name of event-inventory is "&6BINGO ADMIN":

        cancel event


        # ====================================================
        # SET
        # ====================================================

        if clicked slot is 1:

            close player's inventory


            if {bingo.running} is true:

                send "&cBINGO is currently running." to player

                stop


            # =================================================
            # FIND BOARD MARKERS
            # =================================================

            set {_found1} to false
            set {_found2} to false
            set {_found3} to false
            set {_found4} to false
            set {_found5} to false


            loop all entities:

                if loop-entity is marker:

                    if loop-entity has tag "bingo_board_1":
                        set {_found1} to true

                    if loop-entity has tag "bingo_board_2":
                        set {_found2} to true

                    if loop-entity has tag "bingo_board_3":
                        set {_found3} to true

                    if loop-entity has tag "bingo_board_4":
                        set {_found4} to true

                    if loop-entity has tag "bingo_board_5":
                        set {_found5} to true


            if {_found1} is not true:
                send "&cBINGO board 1 marker was not found." to player
                stop

            if {_found2} is not true:
                send "&cBINGO board 2 marker was not found." to player
                stop

            if {_found3} is not true:
                send "&cBINGO board 3 marker was not found." to player
                stop

            if {_found4} is not true:
                send "&cBINGO board 4 marker was not found." to player
                stop

            if {_found5} is not true:
                send "&cBINGO board 5 marker was not found." to player
                stop


            # =================================================
            # CLEAR OLD PLAYER DATA
            # =================================================

            delete {bingo.team::*}
            delete {bingo.player::*}
            delete {bingo.head::*}
            delete {bingo.bighead::*}


            # =================================================
            # REMOVE BIG HEADS
            # =================================================

            execute console command "kill @e[tag=bingo_big_head]"


            # =================================================
            # REMOVE SMALL PLAYER HEADS
            # =================================================

            loop all entities:

                if loop-entity is marker:

                    set {_loc} to location of loop-entity

                    add 1 to y-coordinate of {_loc}
                    add 3 to z-coordinate of {_loc}

                    if block at {_loc} is player head:

                        set block at {_loc} to air


            # =================================================
            # RESTORE REGISTER BUTTONS
            # =================================================

            loop all entities:

                if loop-entity is marker:

                    if loop-entity has tag "bingo_board_1":

                        set {_loc} to location of loop-entity

                        add 1 to y-coordinate of {_loc}
                        add 2 to z-coordinate of {_loc}

                        set block at {_loc} to stone button


                    if loop-entity has tag "bingo_board_2":

                        set {_loc} to location of loop-entity

                        add 1 to y-coordinate of {_loc}
                        add 2 to z-coordinate of {_loc}

                        set block at {_loc} to stone button


                    if loop-entity has tag "bingo_board_3":

                        set {_loc} to location of loop-entity

                        add 1 to y-coordinate of {_loc}
                        add 2 to z-coordinate of {_loc}

                        set block at {_loc} to stone button


                    if loop-entity has tag "bingo_board_4":

                        set {_loc} to location of loop-entity

                        add 1 to y-coordinate of {_loc}
                        add 2 to z-coordinate of {_loc}

                        set block at {_loc} to stone button


                    if loop-entity has tag "bingo_board_5":

                        set {_loc} to location of loop-entity

                        add 1 to y-coordinate of {_loc}
                        add 2 to z-coordinate of {_loc}

                        set block at {_loc} to stone button


            # =================================================
            # SET MODE
            # =================================================

            set {bingo.setup} to true


            send "" to all players
            send "&a&l==============================" to all players
            send "&a&l          BINGO SET" to all players
            send "&fPlayer registration is ready." to all players
            send "&7Please select your team." to all players
            send "&a&l==============================" to all players
            send "" to all players

            stop


        # ====================================================
        # SET2
        # ====================================================

        if clicked slot is 3:

            close player's inventory


            if {bingo.running} is true:

                send "&cYou cannot use SET2 during the game." to player

                stop


            # =================================================
            # CHECK ALL 9 ITEMS
            # =================================================

            set {_itemOK} to true


            loop 9 times:

                if {bingo.items::%loop-number%} is not set:

                    set {_itemOK} to false


            if {_itemOK} is not true:

                send "&cBINGO items are not configured correctly." to player
                send "&7Please check bingo.items::1～9." to player

                stop


            # =================================================
            # APPLY ITEMS TO ALL 5 BOARDS
            # =================================================

            loop all entities:

                if loop-entity is marker:


                    # =========================================
                    # TEAM 1
                    # =========================================

                    if loop-entity has tag "bingo_board_1":

                        set {_marker} to location of loop-entity


                        loop 9 times:

                            set {_index} to loop-number

                            set {_dx} to ({_index} - 1) mod 3
                            set {_dy} to floor(({_index} - 1) / 3)


                            set {_target} to {_marker}

                            add ({_dx} - 1) to x-coordinate of {_target}
                            add (3 - {_dy}) to y-coordinate of {_target}
                            add 1 to z-coordinate of {_target}


                            set {_targetFrame} to item frame at {_target}


                            if {_targetFrame} is set:

                                set item of {_targetFrame} to {bingo.items::%{_index}%}


                    # =========================================
                    # TEAM 2
                    # =========================================

                    if loop-entity has tag "bingo_board_2":

                        set {_marker} to location of loop-entity


                        loop 9 times:

                            set {_index} to loop-number

                            set {_dx} to ({_index} - 1) mod 3
                            set {_dy} to floor(({_index} - 1) / 3)


                            set {_target} to {_marker}

                            add ({_dx} - 1) to x-coordinate of {_target}
                            add (3 - {_dy}) to y-coordinate of {_target}
                            add 1 to z-coordinate of {_target}


                            set {_targetFrame} to item frame at {_target}


                            if {_targetFrame} is set:

                                set item of {_targetFrame} to {bingo.items::%{_index}%}


                    # =========================================
                    # TEAM 3
                    # =========================================

                    if loop-entity has tag "bingo_board_3":

                        set {_marker} to location of loop-entity


                        loop 9 times:

                            set {_index} to loop-number

                            set {_dx} to ({_index} - 1) mod 3
                            set {_dy} to floor(({_index} - 1) / 3)


                            set {_target} to {_marker}

                            add ({_dx} - 1) to x-coordinate of {_target}
                            add (3 - {_dy}) to y-coordinate of {_target}
                            add 1 to z-coordinate of {_target}


                            set {_targetFrame} to item frame at {_target}


                            if {_targetFrame} is set:

                                set item of {_targetFrame} to {bingo.items::%{_index}%}


                    # =========================================
                    # TEAM 4
                    # =========================================

                    if loop-entity has tag "bingo_board_4":

                        set {_marker} to location of loop-entity


                        loop 9 times:

                            set {_index} to loop-number

                            set {_dx} to ({_index} - 1) mod 3
                            set {_dy} to floor(({_index} - 1) / 3)


                            set {_target} to {_marker}

                            add ({_dx} - 1) to x-coordinate of {_target}
                            add (3 - {_dy}) to y-coordinate of {_target}
                            add 1 to z-coordinate of {_target}


                            set {_targetFrame} to item frame at {_target}


                            if {_targetFrame} is set:

                                set item of {_targetFrame} to {bingo.items::%{_index}%}


                    # =========================================
                    # TEAM 5
                    # =========================================

                    if loop-entity has tag "bingo_board_5":

                        set {_marker} to location of loop-entity


                        loop 9 times:

                            set {_index} to loop-number

                            set {_dx} to ({_index} - 1) mod 3
                            set {_dy} to floor(({_index} - 1) / 3)


                            set {_target} to {_marker}

                            add ({_dx} - 1) to x-coordinate of {_target}
                            add (3 - {_dy}) to y-coordinate of {_target}
                            add 1 to z-coordinate of {_target}


                            set {_targetFrame} to item frame at {_target}


                            if {_targetFrame} is set:

                                set item of {_targetFrame} to {bingo.items::%{_index}%}


            # =================================================
            # MESSAGE
            # =================================================

            send "" to all players
            send "&e&l==============================" to all players
            send "&e&l          BINGO SET2" to all players
            send "&fThe BINGO items have been updated." to all players
            send "&7All 5 boards now use the current item list." to all players
            send "&7SET2 can be executed again safely." to all players
            send "&e&l==============================" to all players
            send "" to all players

            stop


        # ====================================================
        # START
        # ====================================================

        if clicked slot is 5:

            close player's inventory


            if {bingo.setup} is not true:

                send "&cPlease complete SET first." to player

                stop


            if {bingo.running} is true:

                send "&cBINGO is already running." to player

                stop


            send "" to all players
            send "&b&l==============================" to all players
            send "&b&l          BINGO START" to all players
            send "&fGame start preparation." to all players
            send "&b&l==============================" to all players
            send "" to all players


            # =================================================
            # COUNTDOWN
            # =================================================

            send title "&c&l3" with subtitle "&fGET READY" to all players

            play sound "block.note_block.pling" with volume 1 and pitch 1.1 to all players

            wait 1 second


            send title "&e&l2" with subtitle "&fGET READY" to all players

            play sound "block.note_block.pling" with volume 1 and pitch 1.1 to all players

            wait 1 second


            send title "&a&l1" with subtitle "&fGET READY" to all players

            play sound "block.note_block.pling" with volume 1 and pitch 1.1 to all players

            wait 1 second


            set {bingo.running} to true


            send title "&6&lSTART!!" with subtitle "&fBINGO!" to all players

            play sound "entity.player.levelup" with volume 1 and pitch 1.2 to all players


            send "" to all players
            send "&6&l==============================" to all players
            send "&e&l          BINGO START!" to all players
            send "&fGood luck!" to all players
            send "&6&l==============================" to all players
            send "" to all players

            stop


        # ====================================================
        # RESET
        # ====================================================

        if clicked slot is 7:

            close player's inventory


            set {bingo.running} to false
            set {bingo.setup} to false


            # =================================================
            # REMOVE BIG HEADS
            # =================================================

            execute console command "kill @e[tag=bingo_big_head]"


            # =================================================
            # REMOVE SMALL PLAYER HEADS
            # =================================================

            loop all entities:

                if loop-entity is marker:

                    set {_loc} to location of loop-entity

                    add 1 to y-coordinate of {_loc}
                    add 3 to z-coordinate of {_loc}

                    if block at {_loc} is player head:

                        set block at {_loc} to air


            # =================================================
            # RESTORE BUTTONS
            # =================================================

            loop all entities:

                if loop-entity is marker:

                    if loop-entity has tag "bingo_board_1":

                        set {_loc} to location of loop-entity

                        add 1 to y-coordinate of {_loc}
                        add 2 to z-coordinate of {_loc}

                        set block at {_loc} to stone button


                    if loop-entity has tag "bingo_board_2":

                        set {_loc} to location of loop-entity

                        add 1 to y-coordinate of {_loc}
                        add 2 to z-coordinate of {_loc}

                        set block at {_loc} to stone button


                    if loop-entity has tag "bingo_board_3":

                        set {_loc} to location of loop-entity

                        add 1 to y-coordinate of {_loc}
                        add 2 to z-coordinate of {_loc}

                        set block at {_loc} to stone button


                    if loop-entity has tag "bingo_board_4":

                        set {_loc} to location of loop-entity

                        add 1 to y-coordinate of {_loc}
                        add 2 to z-coordinate of {_loc}

                        set block at {_loc} to stone button


                    if loop-entity has tag "bingo_board_5":

                        set {_loc} to location of loop-entity

                        add 1 to y-coordinate of {_loc}
                        add 2 to z-coordinate of {_loc}

                        set block at {_loc} to stone button


            # =================================================
            # CLEAR BOARD ITEMS
            # =================================================

            loop all entities:

                if loop-entity is marker:

                    if loop-entity has tag "bingo_board_1":

                        loop 9 times:

                            set {_index} to loop-number

                            set {_dx} to ({_index} - 1) mod 3
                            set {_dy} to floor(({_index} - 1) / 3)


                            set {_target} to location of loop-entity

                            add ({_dx} - 1) to x-coordinate of {_target}
                            add (3 - {_dy}) to y-coordinate of {_target}
                            add 1 to z-coordinate of {_target}


                            set {_frame} to item frame at {_target}

                            if {_frame} is set:

                                set item of {_frame} to air


                    if loop-entity has tag "bingo_board_2":

                        loop 9 times:

                            set {_index} to loop-number

                            set {_dx} to ({_index} - 1) mod 3
                            set {_dy} to floor(({_index} - 1) / 3)


                            set {_target} to location of loop-entity

                            add ({_dx} - 1) to x-coordinate of {_target}
                            add (3 - {_dy}) to y-coordinate of {_target}
                            add 1 to z-coordinate of {_target}


                            set {_frame} to item frame at {_target}

                            if {_frame} is set:

                                set item of {_frame} to air


                    if loop-entity has tag "bingo_board_3":

                        loop 9 times:

                            set {_index} to loop-number

                            set {_dx} to ({_index} - 1) mod 3
                            set {_dy} to floor(({_index} - 1) / 3)


                            set {_target} to location of loop-entity

                            add ({_dx} - 1) to x-coordinate of {_target}
                            add (3 - {_dy}) to y-coordinate of {_target}
                            add 1 to z-coordinate of {_target}


                            set {_frame} to item frame at {_target}

                            if {_frame} is set:

                                set item of {_frame} to air


                    if loop-entity has tag "bingo_board_4":

                        loop 9 times:

                            set {_index} to loop-number

                            set {_dx} to ({_index} - 1) mod 3
                            set {_dy} to floor(({_index} - 1) / 3)


                            set {_target} to location of loop-entity

                            add ({_dx} - 1) to x-coordinate of {_target}
                            add (3 - {_dy}) to y-coordinate of {_target}
                            add 1 to z-coordinate of {_target}


                            set {_frame} to item frame at {_target}

                            if {_frame} is set:

                                set item of {_frame} to air


                    if loop-entity has tag "bingo_board_5":

                        loop 9 times:

                            set {_index} to loop-number

                            set {_dx} to ({_index} - 1) mod 3
                            set {_dy} to floor(({_index} - 1) / 3)


                            set {_target} to location of loop-entity

                            add ({_dx} - 1) to x-coordinate of {_target}
                            add (3 - {_dy}) to y-coordinate of {_target}
                            add 1 to z-coordinate of {_target}


                            set {_frame} to item frame at {_target}

                            if {_frame} is set:

                                set item of {_frame} to air


            # =================================================
            # VARIABLES
            # =================================================

            delete {bingo.team::*}
            delete {bingo.player::*}
            delete {bingo.head::*}
            delete {bingo.bighead::*}


            # =================================================
            # MESSAGE
            # =================================================

            send "" to all players
            send "&c&l==============================" to all players
            send "&c&l          BINGO RESET" to all players
            send "&fBINGO has been reset." to all players
            send "&7The board is ready for the next setup." to all players
            send "&c&l==============================" to all players
            send "" to all players

            stop


# ============================================================
# PLAYER REGISTRATION
#
# 石ボタンをクリック
#
# ============================================================

on right click on stone button:

    cancel event


    # ========================================================
    # FIND TEAM
    # ========================================================

    set {_team} to 0
    set {_marker} to none


    loop all entities:

        if loop-entity is marker:

            set {_m} to location of loop-entity


            # ------------------------------------------------
            # BUTTON
            #
            # marker
            # +Y1
            # +Z2
            # ------------------------------------------------

            set {_button} to {_m}

            add 1 to y-coordinate of {_button}
            add 2 to z-coordinate of {_button}


            if location of event-block is {_button}:

                if loop-entity has tag "bingo_board_1":

                    set {_team} to 1
                    set {_marker} to {_m}

                else if loop-entity has tag "bingo_board_2":

                    set {_team} to 2
                    set {_marker} to {_m}

                else if loop-entity has tag "bingo_board_3":

                    set {_team} to 3
                    set {_marker} to {_m}

                else if loop-entity has tag "bingo_board_4":

                    set {_team} to 4
                    set {_marker} to {_m}

                else if loop-entity has tag "bingo_board_5":

                    set {_team} to 5
                    set {_marker} to {_m}


    if {_team} is 0:

        stop


    # ========================================================
    # SETUP CHECK
    # ========================================================

    if {bingo.setup} is not true:

        send "&cPlease use /bingo SET first." to player

        stop


    # ========================================================
    # GAME CHECK
    # ========================================================

    if {bingo.running} is true:

        send "&cYou cannot change teams during the game." to player

        stop


    # ========================================================
    # PLAYER ALREADY REGISTERED
    # ========================================================

    if {bingo.team::%player%} is set:

        send "&cYou have already selected Team %{bingo.team::%player%}%." to player

        stop


    # ========================================================
    # TEAM ALREADY USED
    # ========================================================

    if {bingo.player::%{_team}%} is set:

        send "&cTeam %{_team}% has already been selected." to player

        stop


    # ========================================================
    # SAVE
    # ========================================================

    set {bingo.team::%player%} to {_team}

    set {bingo.player::%{_team}%} to player


    # ========================================================
    # DELETE BUTTON
    # ========================================================

    set event-block to air


    # ========================================================
    # SMALL PLAYER HEAD
    #
    # marker:
    #
    # +Y1
    # +Z3
    #
    # ========================================================

    set {_headLocation} to {_marker}

    add 1 to y-coordinate of {_headLocation}
    add 3 to z-coordinate of {_headLocation}


    set {bingo.head::%player%} to {_headLocation}


    set block at {_headLocation} to player head

    set skull owner of block at {_headLocation} to player


    # ========================================================
    # BIG PLAYER HEAD
    #
    # TETSUSENと同じ方式。
    #
    # item_display
    #
    # billboard = fixed
    #
    # scale = [6,6,1]
    #
    # ========================================================

    set {_bigLocation} to {_marker}

    add 11 to y-coordinate of {_bigLocation}
    add 5 to z-coordinate of {_bigLocation}


    set {bingo.bighead::%player%} to {_bigLocation}


    set {_bigX} to x-coordinate of {_bigLocation}
    set {_bigY} to y-coordinate of {_bigLocation}
    set {_bigZ} to z-coordinate of {_bigLocation}


    # ========================================================
    # REMOVE OLD BIG HEAD
    # ========================================================

    execute console command "kill @e[tag=bingo_big_head,x=%{_bigX}%,y=%{_bigY}%,z=%{_bigZ}%,distance=..1]"


    # ========================================================
    # SUMMON BIG PLAYER HEAD
    # ========================================================

    execute console command "summon minecraft:item_display %{_bigX}% %{_bigY}% %{_bigZ}% {item:{id:""minecraft:player_head"",count:1,components:{""minecraft:profile"":{name:""%player%""}}},billboard:""fixed"",Tags:[""bingo_big_head""]}"


    # ========================================================
    # SCALE
    #
    # 横方向は6
    # 縦方向は6
    # 奥行きは1
    #
    # → 細長い表示
    #
    # ========================================================

    execute console command "data modify entity @e[tag=bingo_big_head,x=%{_bigX}%,y=%{_bigY}%,z=%{_bigZ}%,distance=..1,limit=1] transformation.scale set value [6f,6f,1f]"


    # ========================================================
    # MESSAGE
    # ========================================================

    send "&a%player% selected &eTeam %{_team}%&a." to all players


# ============================================================
# PLAYER DISCONNECT
# ============================================================

on quit:

    # --------------------------------------------------------
    # チーム情報は消さない。
    #
    # ゲーム中に再接続しても登録を維持する。
    # --------------------------------------------------------

    stop


# ============================================================
# GAME END
#
# 今後ここへ
#
#   ・BINGO判定
#   ・アイテム取得判定
#   ・ライン完成
#   ・順位
#   ・終了処理
#
# を追加可能。
#
# ============================================================
