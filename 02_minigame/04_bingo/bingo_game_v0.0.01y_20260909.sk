# ============================================================
# BINGO GAME SYSTEM
#
# Minecraft Java Edition
# Paper + Skript
#
# Version : v0.1.01
#
# ============================================================
#
# MINECRAFT VERSION
#
#   Minecraft Java Edition 26.2
#   Paper 26.2
#   Skript 2.16.1
#
# ============================================================
#
# SYSTEM DESIGN
#
#   MineScript
#       ・会場整地
#       ・ビンゴ盤生成
#       ・額縁設置
#       ・登録ボタン設置
#
#   Skript
#       ・会場座標登録
#       ・プレイヤー登録
#       ・プレイヤーヘッド生成
#       ・巨大ヘッド生成
#       ・アイテム管理
#       ・盤面アイテム配置
#       ・入力判定
#       ・マス達成
#       ・ビンゴ判定
#       ・START / STOP / RESET
#
# ============================================================
#
# v0.1.01 CHANGES
#
#   ・Skript 2.16.1 compatibility
#   ・mod expression removed
#   ・multi-line location return removed
#   ・nested loop-number fixed
#   ・next loop removed
#
# ============================================================


# ============================================================
# OPTIONS
# ============================================================

options:

    prefix: &6&l[BINGO]&r


# ============================================================
# SETTINGS
# ============================================================

# ------------------------------------------------------------
# TEAM
# ------------------------------------------------------------
#
# TEAM 1 : X -20
# TEAM 2 : X -10
# TEAM 3 : X   0
# TEAM 4 : X +10
# TEAM 5 : X +20
#
# ------------------------------------------------------------


# ============================================================
# BOARD
# ============================================================

# MineScript側と一致させる
#
# 会場中央から盤面までのZオフセット
#
# base_z = origin_z - 7


# ============================================================
# ON LOAD
# ============================================================

on load:

    # ========================================================
    # BINGO ITEMS
    #
    # 3 x 3
    #
    #   1 2 3
    #   4 5 6
    #   7 8 9
    #
    # ========================================================

    set {bingo.items::1} to apple
    set {bingo.items::2} to bread
    set {bingo.items::3} to carrot

    set {bingo.items::4} to potato
    set {bingo.items::5} to golden apple
    set {bingo.items::6} to cooked beef

    set {bingo.items::7} to cooked porkchop
    set {bingo.items::8} to melon slice
    set {bingo.items::9} to cookie


    # ========================================================
    # RUNNING STATE
    # ========================================================

    if {bingo.running} is not set:

        set {bingo.running} to false


    send "{@prefix} &aBINGO GAME SYSTEM LOADED." to console


# ============================================================
# TEAM OFFSET
# ============================================================

function bingo_team_offset(team: number) :: number:

    if {_team} = 1:

        return -20


    if {_team} = 2:

        return -10


    if {_team} = 3:

        return 0


    if {_team} = 4:

        return 10


    if {_team} = 5:

        return 20


    return 0


# ============================================================
# TEAM BASE X
# ============================================================

function bingo_team_x(team: number) :: number:

    set {_originX} to x-coordinate of {bingo.origin}

    set {_offset} to bingo_team_offset({_team})

    return {_originX} + {_offset}


# ============================================================
# BOARD BASE Y
# ============================================================

function bingo_board_y() :: number:

    return y-coordinate of {bingo.origin}


# ============================================================
# BOARD BASE Z
# ============================================================

function bingo_board_z() :: number:

    set {_originZ} to z-coordinate of {bingo.origin}

    return {_originZ} - 7


# ============================================================
# WORLD
# ============================================================

function bingo_world() :: world:

    return world of {bingo.origin}


# ============================================================
# BOARD CELL LOCATION
#
# index
#
#   1 2 3
#   4 5 6
#   7 8 9
#
# ============================================================

function bingo_cell_location(team: number, index: number) :: location:

    set {_baseX} to bingo_team_x({_team})

    set {_baseY} to bingo_board_y()

    set {_baseZ} to bingo_board_z()


    # --------------------------------------------------------
    # INDEX
    # --------------------------------------------------------

    set {_i} to {_index} - 1


    # --------------------------------------------------------
    # COLUMN
    #
    # mod 3 の代替
    #
    # 0 -> 0
    # 1 -> 1
    # 2 -> 2
    # 3 -> 0
    # 4 -> 1
    # ...
    #
    # --------------------------------------------------------

    set {_column} to {_i} - (floor({_i} / 3) * 3)


    # --------------------------------------------------------
    # ROW
    # --------------------------------------------------------

    set {_row} to floor({_i} / 3)


    # --------------------------------------------------------
    # LOCATION
    # --------------------------------------------------------

    set {_x} to {_baseX} + 1 + {_column}

    set {_y} to {_baseY} + 3 - {_row}

    set {_z} to {_baseZ} + 1


    return location({_x}, {_y}, {_z}, bingo_world())


# ============================================================
# BACK BLOCK LOCATION
#
# 額縁の1ブロック後ろ
#
# ============================================================

function bingo_back_location(team: number, index: number) :: location:

    set {_loc} to bingo_cell_location({_team}, {_index})

    set {_x} to x-coordinate of {_loc}

    set {_y} to y-coordinate of {_loc}

    set {_z} to z-coordinate of {_loc} - 1


    return location({_x}, {_y}, {_z}, bingo_world())


# ============================================================
# INPUT FRAME LOCATION
# ============================================================

function bingo_input_location(team: number) :: location:

    set {_baseX} to bingo_team_x({_team})

    set {_baseY} to bingo_board_y()

    set {_baseZ} to bingo_board_z()


    # --------------------------------------------------------
    # MineScript
    #
    # summon item_frame
    #
    # base_x
    # y + 1
    # base_z + 1
    #
    # --------------------------------------------------------

    return location({_baseX}, {_baseY} + 1, {_baseZ} + 1, bingo_world())


# ============================================================
# REGISTER BUTTON LOCATION
# ============================================================

function bingo_button_location(team: number) :: location:

    set {_baseX} to bingo_team_x({_team})

    set {_baseY} to bingo_board_y()

    set {_baseZ} to bingo_board_z()


    # --------------------------------------------------------
    # MineScript
    #
    # setblock
    #
    # base_x
    # y + 2
    # base_z
    #
    # --------------------------------------------------------

    return location({_baseX}, {_baseY} + 2, {_baseZ}, bingo_world())


# ============================================================
# SMALL PLAYER HEAD LOCATION
# ============================================================

function bingo_small_head_location(team: number) :: location:

    set {_baseX} to bingo_team_x({_team})

    set {_baseY} to bingo_board_y()

    set {_baseZ} to bingo_board_z()


    return location({_baseX} + 2, {_baseY} + 1, {_baseZ} + 3, bingo_world())


# ============================================================
# BIG PLAYER HEAD LOCATION
# ============================================================

function bingo_big_head_location(team: number) :: location:

    set {_baseX} to bingo_team_x({_team})

    set {_baseY} to bingo_board_y()

    set {_baseZ} to bingo_board_z()


    return location({_baseX} + 2, {_baseY} + 8, {_baseZ}, bingo_world())


# ============================================================
# GET TEAM OF PLAYER
# ============================================================

function bingo_get_player_team(p: player) :: number:

    loop 5 times:

        if {bingo.player::%loop-number%} is name of {_p}:

            return loop-number


    return 0


# ============================================================
# REGISTER PLAYER
# ============================================================

function bingo_register_player(p: player, team: number):


    # ========================================================
    # GAME RUNNING CHECK
    # ========================================================

    if {bingo.running} is true:

        send "{@prefix} &cゲーム開始後は部隊変更できません。" to {_p}

        stop


    # ========================================================
    # TEAM OCCUPIED CHECK
    # ========================================================

    if {bingo.player::%{_team}%} is set:


        # ----------------------------------------------------
        # 自分自身なら何もしない
        # ----------------------------------------------------

        if {bingo.player::%{_team}%} is name of {_p}:

            send "{@prefix} &e既に TEAM %{_team}% に登録されています。" to {_p}

            stop


        # ----------------------------------------------------
        # 他人がいる
        # ----------------------------------------------------

        send "{@prefix} &cTEAM %{_team}% は既に使用されています。" to {_p}

        send "&7Player : %{bingo.player::%{_team}%}%" to {_p}

        stop


    # ========================================================
    # OLD TEAM CHECK
    # ========================================================

    set {_oldTeam} to bingo_get_player_team({_p})


    if {_oldTeam} is not 0:

        bingo_remove_player({_oldTeam})


    # ========================================================
    # REGISTER
    # ========================================================

    set {bingo.player::%{_team}%} to name of {_p}

    set {bingo.team::%uuid of {_p}%} to {_team}


    # ========================================================
    # CREATE HEAD
    # ========================================================

    bingo_create_player_head({_team}, {_p})


    # ========================================================
    # MESSAGE
    # ========================================================

    broadcast ""

    broadcast "{@prefix} &a%name of {_p}% &rが TEAM %{_team}% に登録しました！"

    broadcast ""


    send "&a━━━━━━━━━━━━━━━━━━━━" to {_p}

    send "&eTEAM %{_team}% に登録しました。" to {_p}

    send "&a━━━━━━━━━━━━━━━━━━━━" to {_p}


# ============================================================
# REMOVE PLAYER
# ============================================================

function bingo_remove_player(team: number):


    # ========================================================
    # CHECK
    # ========================================================

    if {bingo.player::%{_team}%} is not set:

        stop


    # ========================================================
    # PLAYER NAME
    # ========================================================

    set {_name} to {bingo.player::%{_team}%}


    # ========================================================
    # SMALL HEAD REMOVE
    # ========================================================

    set {_headLoc} to bingo_small_head_location({_team})

    set block at {_headLoc} to air


    # ========================================================
    # BIG HEAD REMOVE
    # ========================================================

    execute console command "kill @e[tag=bingo_big_head_%{_team}%]"


    # ========================================================
    # PLAYER VARIABLE REMOVE
    # ========================================================

    delete {bingo.player::%{_team}%}


    # ========================================================
    # UUID TEAM DATA REMOVE
    # ========================================================

    loop all players:

        if name of loop-player is {_name}:

            delete {bingo.team::%uuid of loop-player%}


# ============================================================
# CREATE PLAYER HEAD
# ============================================================

function bingo_create_player_head(team: number, p: player):


    # ========================================================
    # REMOVE OLD BIG HEAD
    # ========================================================

    execute console command "kill @e[tag=bingo_big_head_%{_team}%]"


    # ========================================================
    # SMALL PLAYER HEAD
    # ========================================================

    set {_smallLoc} to bingo_small_head_location({_team})

    set {_sx} to floor(x-coordinate of {_smallLoc})

    set {_sy} to floor(y-coordinate of {_smallLoc})

    set {_sz} to floor(z-coordinate of {_smallLoc})


    execute console command "setblock %{_sx}% %{_sy}% %{_sz}% minecraft:player_head[rotation=8]{profile:""%name of {_p}%""}"


    # ========================================================
    # BIG PLAYER HEAD
    # ========================================================

    set {_bigLoc} to bingo_big_head_location({_team})

    set {_bx} to floor(x-coordinate of {_bigLoc})

    set {_by} to floor(y-coordinate of {_bigLoc})

    set {_bz} to floor(z-coordinate of {_bigLoc})


    execute console command "summon minecraft:item_display %{_bx}% %{_by}% %{_bz}% {Tags:[""bingo_big_head_%{_team}%""],item:{id:""minecraft:player_head"",count:1,components:{""minecraft:profile"":{name:""%name of {_p}%""}}},billboard:""fixed""}"


    # ========================================================
    # BIG HEAD SCALE
    # ========================================================

    execute console command "execute as @e[tag=bingo_big_head_%{_team}%] run data modify entity @s transformation.scale set value [4f,4f,4f]"


    # ========================================================
    # BIG HEAD ROTATION
    # ========================================================

    execute console command "execute as @e[tag=bingo_big_head_%{_team}%] run data merge entity @s {Rotation:[180f,0f]}"


# ============================================================
# RESET BOARD
# ============================================================

function bingo_reset_board():

    loop 5 times:

        set {_team} to loop-number


        # ====================================================
        # RESET 3x3
        # ====================================================

        loop 9 times:

            set {_index} to loop-number-2


            # ------------------------------------------------
            # BACK BLOCK
            # ------------------------------------------------

            set {_backLoc} to bingo_back_location({_team}, {_index})

            set block at {_backLoc} to white stained glass


            # ------------------------------------------------
            # DONE STATE
            # ------------------------------------------------

            delete {bingo.done::%{_team}%::%{_index}%}


        # ====================================================
        # BINGO STATE
        # ====================================================

        delete {bingo.bingo::%{_team}%}


# ============================================================
# CLEAR BOARD ITEMS
# ============================================================

function bingo_clear_board_items():

    loop 5 times:

        set {_team} to loop-number


        loop 9 times:

            set {_index} to loop-number-2


            set {_cellLoc} to bingo_cell_location({_team}, {_index})

            set {_x} to floor(x-coordinate of {_cellLoc})

            set {_y} to floor(y-coordinate of {_cellLoc})

            set {_z} to floor(z-coordinate of {_cellLoc})


            execute console command "data remove entity @e[type=minecraft:item_frame,x=%{_x}%,y=%{_y}%,z=%{_z}%,distance=..1,limit=1,sort=nearest] Item"


# ============================================================
# SET BINGO ITEMS
# ============================================================

function bingo_set_items():

    loop 5 times:

        set {_team} to loop-number


        # ====================================================
        # PLAYER CHECK
        #
        # 登録者がいるTEAMだけ盤面を使用
        # ====================================================

        if {bingo.player::%{_team}%} is set:


            # =================================================
            # 3x3 ITEMS
            # =================================================

            loop 9 times:

                set {_index} to loop-number-2

                set {_item} to {bingo.items::%{_index}%}


                # =============================================
                # CELL LOCATION
                # =============================================

                set {_cellLoc} to bingo_cell_location({_team}, {_index})

                set {_x} to floor(x-coordinate of {_cellLoc})

                set {_y} to floor(y-coordinate of {_cellLoc})

                set {_z} to floor(z-coordinate of {_cellLoc})


                # =============================================
                # ITEM ID
                #
                # Skript item type
                # ->
                # minecraft namespace形式
                # =============================================

                set {_itemName} to "%type of {_item}%"

                replace all " " with "_" in {_itemName}


                # =============================================
                # SET FRAME ITEM
                # =============================================

                execute console command "data modify entity @e[type=minecraft:item_frame,x=%{_x}%,y=%{_y}%,z=%{_z}%,distance=..1,limit=1,sort=nearest] Item set value {id:""minecraft:%{_itemName}%"",count:1}"


# ============================================================
# RESET INPUT FRAMES
# ============================================================

function bingo_reset_input_frames():

    loop 5 times:

        set {_team} to loop-number


        set {_inputLoc} to bingo_input_location({_team})

        set {_x} to floor(x-coordinate of {_inputLoc})

        set {_y} to floor(y-coordinate of {_inputLoc})

        set {_z} to floor(z-coordinate of {_inputLoc})


        execute console command "data remove entity @e[type=minecraft:item_frame,x=%{_x}%,y=%{_y}%,z=%{_z}%,distance=..1,limit=1,sort=nearest] Item"


# ============================================================
# COMPLETE CELL
# ============================================================

function bingo_complete_cell(team: number, index: number):


    # ========================================================
    # ALREADY DONE
    # ========================================================

    if {bingo.done::%{_team}%::%{_index}%} is true:

        stop


    # ========================================================
    # COMPLETE
    # ========================================================

    set {bingo.done::%{_team}%::%{_index}%} to true


    # ========================================================
    # BACK BLOCK -> GOLD BLOCK
    # ========================================================

    set {_backLoc} to bingo_back_location({_team}, {_index})

    set block at {_backLoc} to gold block


    # ========================================================
    # EFFECT
    # ========================================================

    execute console command "playsound minecraft:entity.player.levelup master @a"


    broadcast "{@prefix} &eTEAM %{_team}% &rがマス %{_index}% を達成！"


    # ========================================================
    # CHECK BINGO
    # ========================================================

    bingo_check_lines({_team})


# ============================================================
# BINGO CHECK
# ============================================================

function bingo_check_lines(team: number):


    # ========================================================
    # ALREADY BINGO
    # ========================================================

    if {bingo.bingo::%{_team}%} is true:

        stop


    # ========================================================
    # ROW 1
    # ========================================================

    if {bingo.done::%{_team}%::1} is true:

        if {bingo.done::%{_team}%::2} is true:

            if {bingo.done::%{_team}%::3} is true:

                bingo_win({_team})

                stop


    # ========================================================
    # ROW 2
    # ========================================================

    if {bingo.done::%{_team}%::4} is true:

        if {bingo.done::%{_team}%::5} is true:

            if {bingo.done::%{_team}%::6} is true:

                bingo_win({_team})

                stop


    # ========================================================
    # ROW 3
    # ========================================================

    if {bingo.done::%{_team}%::7} is true:

        if {bingo.done::%{_team}%::8} is true:

            if {bingo.done::%{_team}%::9} is true:

                bingo_win({_team})

                stop


    # ========================================================
    # COLUMN 1
    # ========================================================

    if {bingo.done::%{_team}%::1} is true:

        if {bingo.done::%{_team}%::4} is true:

            if {bingo.done::%{_team}%::7} is true:

                bingo_win({_team})

                stop


    # ========================================================
    # COLUMN 2
    # ========================================================

    if {bingo.done::%{_team}%::2} is true:

        if {bingo.done::%{_team}%::5} is true:

            if {bingo.done::%{_team}%::8} is true:

                bingo_win({_team})

                stop


    # ========================================================
    # COLUMN 3
    # ========================================================

    if {bingo.done::%{_team}%::3} is true:

        if {bingo.done::%{_team}%::6} is true:

            if {bingo.done::%{_team}%::9} is true:

                bingo_win({_team})

                stop


    # ========================================================
    # DIAGONAL 1
    # ========================================================

    if {bingo.done::%{_team}%::1} is true:

        if {bingo.done::%{_team}%::5} is true:

            if {bingo.done::%{_team}%::9} is true:

                bingo_win({_team})

                stop


    # ========================================================
    # DIAGONAL 2
    # ========================================================

    if {bingo.done::%{_team}%::3} is true:

        if {bingo.done::%{_team}%::5} is true:

            if {bingo.done::%{_team}%::7} is true:

                bingo_win({_team})

                stop


# ============================================================
# BINGO WIN
# ============================================================

function bingo_win(team: number):


    # ========================================================
    # STATE
    # ========================================================

    set {bingo.bingo::%{_team}%} to true


    set {_playerName} to {bingo.player::%{_team}%}


    # ========================================================
    # TITLE
    # ========================================================

    execute console command "title @a title {""text"":""%{_playerName}%"",""color"":""gold"",""bold"":true}"


    execute console command "title @a subtitle {""text"":""BINGO!!!!!!"",""color"":""green"",""bold"":true}"


    # ========================================================
    # SOUND
    # ========================================================

    execute console command "playsound minecraft:ui.toast.challenge_complete master @a"


    # ========================================================
    # MESSAGE
    # ========================================================

    broadcast ""

    broadcast "&6&l===================================="

    broadcast "&e&l%{_playerName}%"

    broadcast "&a&lBINGO!!!!!!"

    broadcast "&6&l===================================="

    broadcast ""


    # ========================================================
    # STOP GAME
    # ========================================================

    set {bingo.running} to false


# ============================================================
# CHECK INPUT ITEM
# ============================================================

function bingo_check_input(team: number, itemInput: item):


    # ========================================================
    # EMPTY CHECK
    # ========================================================

    if {_itemInput} is air:

        stop


    # ========================================================
    # SEARCH BINGO ITEMS
    # ========================================================

    loop 9 times:

        set {_index} to loop-number


        if type of {_itemInput} is type of {bingo.items::%{_index}%}:


            # =================================================
            # COMPLETE
            # =================================================

            bingo_complete_cell({_team}, {_index})


            stop


# ============================================================
# REGISTER BUTTON CLICK
# ============================================================

on right click:


    # ========================================================
    # SETUP CHECK
    # ========================================================

    if {bingo.origin} is not set:

        stop


    # ========================================================
    # EVENT BLOCK CHECK
    # ========================================================

    if event-block is not set:

        stop


    if event-block is not stone button:

        stop


    # ========================================================
    # BUTTON LOCATION
    # ========================================================

    set {_clickedLoc} to location of event-block


    # ========================================================
    # TEAM CHECK
    # ========================================================

    loop 5 times:

        set {_team} to loop-number

        set {_buttonLoc} to bingo_button_location({_team})


        if {_clickedLoc} is {_buttonLoc}:

            bingo_register_player(player, {_team})

            stop


# ============================================================
# INPUT FRAME CLICK
# ============================================================

on right click on item frame:


    # ========================================================
    # GAME RUNNING
    # ========================================================

    if {bingo.running} is not true:

        stop


    # ========================================================
    # FRAME LOCATION
    # ========================================================

    set {_frameLoc} to location of event-entity


    # ========================================================
    # CHECK ALL TEAM INPUT FRAMES
    # ========================================================

    loop 5 times:

        set {_team} to loop-number

        set {_inputLoc} to bingo_input_location({_team})


        if distance between {_frameLoc} and {_inputLoc} <= 1:


            # =================================================
            # REGISTERED TEAM CHECK
            # =================================================

            if {bingo.player::%{_team}%} is not set:

                stop


            # =================================================
            # DELAY
            #
            # 額縁にアイテムが入る処理を待つ
            # =================================================

            wait 2 ticks


            # =================================================
            # GET FRAME ITEM
            # =================================================

            set {_inputItem} to item of event-entity


            if {_inputItem} is air:

                stop


            # =================================================
            # CHECK ITEM
            # =================================================

            bingo_check_input({_team}, {_inputItem})


            # =================================================
            # INPUT FRAME CLEAR
            # =================================================

            set item of event-entity to air


            stop


# ============================================================
# BINGO START
# ============================================================

function bingo_start_game(p: player):


    # ========================================================
    # ORIGIN CHECK
    # ========================================================

    if {bingo.origin} is not set:

        send "{@prefix} &c先に /bingo setup を実行してください。" to {_p}

        stop


    # ========================================================
    # RUNNING CHECK
    # ========================================================

    if {bingo.running} is true:

        send "{@prefix} &c既にゲーム中です。" to {_p}

        stop


    # ========================================================
    # PLAYER COUNT
    # ========================================================

    set {_count} to 0


    loop 5 times:

        if {bingo.player::%loop-number%} is set:

            add 1 to {_count}


    if {_count} is 0:

        send "{@prefix} &cプレイヤーが登録されていません。" to {_p}

        stop


    # ========================================================
    # RESET BOARD
    # ========================================================

    bingo_reset_board()

    bingo_clear_board_items()

    bingo_reset_input_frames()


    # ========================================================
    # SET ITEMS
    # ========================================================

    bingo_set_items()


    # ========================================================
    # START MESSAGE
    # ========================================================

    broadcast ""

    broadcast "{@prefix} &eBINGO GAME START!"

    broadcast ""


    # ========================================================
    # COUNTDOWN
    # ========================================================

    loop 3 times:

        set {_number} to 4 - loop-number


        execute console command "title @a title {""text"":""%{_number}%"",""color"":""yellow"",""bold"":true}"


        execute console command "playsound minecraft:block.note_block.pling master @a"


        wait 1 second


    # ========================================================
    # START
    # ========================================================

    execute console command "title @a title {""text"":""START!"",""color"":""green"",""bold"":true}"


    execute console command "playsound minecraft:block.note_block.pling master @a"


    set {bingo.running} to true


    broadcast "{@prefix} &aBINGO START!"


# ============================================================
# BINGO STOP
# ============================================================

function bingo_stop_game():

    set {bingo.running} to false

    broadcast "{@prefix} &cBINGO STOP"


# ============================================================
# BINGO RESET ALL
# ============================================================

function bingo_reset_all():


    # ========================================================
    # STOP
    # ========================================================

    set {bingo.running} to false


    # ========================================================
    # BOARD RESET
    # ========================================================

    if {bingo.origin} is set:

        bingo_reset_board()

        bingo_clear_board_items()

        bingo_reset_input_frames()


    # ========================================================
    # REMOVE PLAYERS
    # ========================================================

    loop 5 times:

        bingo_remove_player(loop-number)


    # ========================================================
    # VARIABLES
    # ========================================================

    delete {bingo.player::*}

    delete {bingo.team::*}

    delete {bingo.done::*}

    delete {bingo.bingo::*}


# ============================================================
# COMMAND
# ============================================================

command /bingo [<text>]:

    permission: op

    trigger:


        # ====================================================
        # SETUP
        # ====================================================

        if arg-1 is "setup":


            set {bingo.origin} to location of player

            set {bingo.running} to false


            send ""

            send "{@prefix} &aBINGO会場を登録しました。"

            send "&7X: %floor(x-coordinate of {bingo.origin})%"

            send "&7Y: %floor(y-coordinate of {bingo.origin})%"

            send "&7Z: %floor(z-coordinate of {bingo.origin})%"

            send ""

            stop


        # ====================================================
        # START
        # ====================================================

        if arg-1 is "start":

            bingo_start_game(player)

            stop


        # ====================================================
        # STOP
        # ====================================================

        if arg-1 is "stop":

            bingo_stop_game()

            stop


        # ====================================================
        # RESET
        # ====================================================

        if arg-1 is "reset":

            bingo_reset_all()

            send "{@prefix} &eBINGO完全リセットしました。"

            stop


        # ====================================================
        # STATUS
        # ====================================================

        if arg-1 is "status":


            send ""

            send "&6&l========== BINGO STATUS =========="


            loop 5 times:

                if {bingo.player::%loop-number%} is set:

                    send "&aTEAM %loop-number% &7: &f%{bingo.player::%loop-number%}%"

                else:

                    send "&7TEAM %loop-number% &7: &cEMPTY"


            send ""


            if {bingo.running} is true:

                send "&aGAME : RUNNING"

            else:

                send "&cGAME : STOPPED"


            send "&6&l=================================="


            stop


        # ====================================================
        # TEST
        # ====================================================

        if arg-1 is "test":


            loop 9 times:

                give player 10 of {bingo.items::%loop-number%}


            send "{@prefix} &aテストアイテムを配布しました。"


            stop


        # ====================================================
        # CLEAR
        #
        # プレイヤー登録だけ削除
        # ====================================================

        if arg-1 is "clear":


            loop 5 times:

                bingo_remove_player(loop-number)


            delete {bingo.player::*}

            delete {bingo.team::*}


            send "{@prefix} &eプレイヤー登録を解除しました。"


            stop


        # ====================================================
        # HELP
        # ====================================================

        send ""

        send "&6&l========== BINGO COMMAND =========="

        send "&e/bingo setup"

        send "&e/bingo start"

        send "&e/bingo stop"

        send "&e/bingo reset"

        send "&e/bingo clear"

        send "&e/bingo status"

        send "&e/bingo test"

        send "&6&l===================================="
