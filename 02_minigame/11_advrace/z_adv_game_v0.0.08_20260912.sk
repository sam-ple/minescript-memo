# ============================================================
# ADVANCEMENT RACE
#
# Version : v0.2.02
# Date    : 2026-09-12
#
# Minecraft Java Edition
# Paper 26.2
# Skript 2.16.1
# SkBee
#
# ============================================================
#
# COMMAND
#
#   /adv
#
# ============================================================
#
# FLOW
#
#   /adv
#      ↓
#   GUI
#      ↓
#   SET START
#      ↓
#   TIME
#      ↓
#   START
#      ↓
#   3
#   2
#   1
#   START!
#      ↓
#   Advancement = +1 POINT
#      ↓
#   5 seconds remaining
#   5
#   4
#   3
#   2
#   1
#   0:00
#      ↓
#   TELEPORT START
#      ↓
#   GAME SET
#      ↓
#   RANKING
#
# ============================================================


options:
    prefix: &8[&bADV&8]&r


# ============================================================
# SCRIPT LOAD
# ============================================================

on script load:

    set {adv.running} to false
    set {adv.countdown} to false
    set {adv.finish} to false

    set {adv.time} to 0
    set {adv.duration} to 300

    if {adv.game.id} is not set:

        set {adv.game.id} to 0


    # --------------------------------------------------------
    # Runtime data
    # --------------------------------------------------------

    delete {adv.players::*}
    delete {adv.player.name::*}

    delete {adv.points::*}
    delete {adv.last::*}
    delete {adv.category::*}

    delete {adv.registered::*}

    delete {adv.result.points::*}
    delete {adv.result.last::*}
    delete {adv.result.category::*}
    delete {adv.result.name::*}

    delete {adv.gui.player::*}
    delete {adv.ranked::*}


    # --------------------------------------------------------
    # Scoreboard
    # --------------------------------------------------------

    execute console command "scoreboard objectives remove advPoints"

    execute console command "scoreboard objectives add advPoints dummy Points"

    execute console command "scoreboard objectives setdisplay sidebar"


    # --------------------------------------------------------
    # BossBar
    # --------------------------------------------------------

    set {_bar} to boss bar with key "adv:timer"

    if {_bar} is set:

        remove all players from {_bar}

        delete {_bar}


    log "[ADV] Advancement Race loaded."


# ============================================================
# /ADV
#
# MAIN GUI
# ============================================================

command /adv:

    permission: op

    trigger:


        # ====================================================
        # STATUS
        # ====================================================

        if {adv.running} is true:

            if {adv.countdown} is true:

                set {_status} to "&6COUNTDOWN"

            else:

                set {_status} to "&aRUNNING"


        else if {adv.finish} is true:

            set {_status} to "&cFINISHING"


        else:

            set {_status} to "&7READY"


        # ====================================================
        # TIME
        # ====================================================

        set {_minutes} to floor({adv.duration} / 60)

        set {_timeText} to "%{_minutes}% MIN"


        # ====================================================
        # GUI
        # ====================================================

        set {_gui} to chest inventory with 6 rows named "&8ADVANCEMENT RACE"


        # ====================================================
        # TITLE
        # ====================================================

        set slot 4 of {_gui} to nether star named "&b&lADVANCEMENT RACE"

        set slot 3 of {_gui} to black stained glass pane named " "

        set slot 5 of {_gui} to black stained glass pane named " "


        # ====================================================
        # SET
        # ====================================================

        set slot 10 of {_gui} to compass named "&e&lSET START POSITION"

        set lore of slot 10 of {_gui} to "&7Set current location" and "&7as game start position."


        # ====================================================
        # START
        # ====================================================

        set slot 12 of {_gui} to lime concrete named "&a&lSTART GAME"

        set lore of slot 12 of {_gui} to "&7Start Advancement Race." and "&7All online players participate."


        # ====================================================
        # STOP
        # ====================================================

        set slot 14 of {_gui} to red concrete named "&c&lSTOP GAME"

        set lore of slot 14 of {_gui} to "&7Force stop the current game."


        # ====================================================
        # RESET
        # ====================================================

        set slot 16 of {_gui} to barrier named "&4&lRESET"

        set lore of slot 16 of {_gui} to "&7Reset all game data." and "&cThis cannot be undone."


        # ====================================================
        # TIME
        # ====================================================

        set slot 28 of {_gui} to clock named "&a&l5 MINUTES"

        set lore of slot 28 of {_gui} to "&7300 seconds"


        set slot 29 of {_gui} to clock named "&e&l15 MINUTES"

        set lore of slot 29 of {_gui} to "&7900 seconds"


        set slot 30 of {_gui} to clock named "&6&l30 MINUTES"

        set lore of slot 30 of {_gui} to "&71800 seconds"


        set slot 31 of {_gui} to clock named "&c&l60 MINUTES"

        set lore of slot 31 of {_gui} to "&73600 seconds"


        # ====================================================
        # SELECTED TIME
        # ====================================================

        set slot 33 of {_gui} to clock named "&b&lSELECTED TIME"

        set lore of slot 33 of {_gui} to "&7Current: &f%{_timeText}%"


        # ====================================================
        # STATUS
        # ====================================================

        set {_playerCount} to 0

        loop all players:

            set {_uuid} to uuid of loop-player

            if {adv.registered::%{_uuid}%} is true:

                add 1 to {_playerCount}


        set slot 35 of {_gui} to paper named "&f&lSTATUS"

        set lore of slot 35 of {_gui} to "&7Registered players: &f%{_playerCount}%" and "&7Status: %{_status}%" and "&7Time: &f%{_timeText}%" and "" and "&eClick to view players."


        # ====================================================
        # PLAYER HEADS
        # ====================================================

        set {_slot} to 45


        loop all players:

            if {_slot} > 53:

                stop loop


            set {_p} to loop-player

            set {_uuid} to uuid of {_p}


            if {adv.registered::%{_uuid}%} is not true:

                continue


            set slot {_slot} of {_gui} to skull of {_p}

            set name of slot {_slot} of {_gui} to "&b%{_p}%"

            set lore of slot {_slot} of {_gui} to "&7Click to show result."


            set {adv.gui.player::%player%::%{_slot}%} to {_uuid}


            add 1 to {_slot}


        # ====================================================
        # OPEN
        # ====================================================

        open {_gui} to player


# ============================================================
# MAIN GUI CLICK
# ============================================================

on inventory click:


    if name of event-inventory is not "&8ADVANCEMENT RACE":

        stop


    cancel event


    # ========================================================
    # SET
    # ========================================================

    if clicked slot is 10:

        close player's inventory


        if {adv.running} is true:

            send "{@prefix} &cGame is already running." to player

            stop


        if {adv.finish} is true:

            send "{@prefix} &cGame is finishing." to player

            stop


        set {adv.start.location} to location of player


        send "" to player

        send "{@prefix} &aSTART POSITION SET" to player

        send "{@prefix} &7X: &f%x-coordinate of player%" to player

        send "{@prefix} &7Y: &f%y-coordinate of player%" to player

        send "{@prefix} &7Z: &f%z-coordinate of player%" to player

        send "{@prefix} &7World: &f%world of player%" to player

        stop


    # ========================================================
    # START
    # ========================================================

    if clicked slot is 12:

        close player's inventory


        # ----------------------------------------------------
        # CHECK
        # ----------------------------------------------------

        if {adv.running} is true:

            send "{@prefix} &cAdvancement Race is already running." to player

            stop


        if {adv.finish} is true:

            send "{@prefix} &cGame is finishing." to player

            stop


        if {adv.start.location} is not set:

            send "{@prefix} &cSTART POSITION is not set." to player

            stop


        set {_count} to number of all players


        if {_count} is 0:

            send "{@prefix} &cNo players are online." to player

            stop


        # ----------------------------------------------------
        # NEW GAME ID
        # ----------------------------------------------------

        add 1 to {adv.game.id}

        set {_gameID} to {adv.game.id}


        # ----------------------------------------------------
        # STATE
        # ----------------------------------------------------

        set {adv.running} to true

        set {adv.countdown} to true

        set {adv.finish} to false

        set {adv.time} to 0


        # ----------------------------------------------------
        # CLEAR OLD DATA
        # ----------------------------------------------------

        delete {adv.players::*}
        delete {adv.player.name::*}

        delete {adv.points::*}
        delete {adv.last::*}
        delete {adv.category::*}

        delete {adv.registered::*}

        delete {adv.result.points::*}
        delete {adv.result.last::*}
        delete {adv.result.category::*}
        delete {adv.result.name::*}

        delete {adv.ranked::*}


        # ----------------------------------------------------
        # SCOREBOARD
        # ----------------------------------------------------

        execute console command "scoreboard objectives remove advPoints"

        execute console command "scoreboard objectives add advPoints dummy Points"

        execute console command "scoreboard objectives setdisplay sidebar advPoints"


        # ====================================================
        # REGISTER ONLINE PLAYERS
        # ====================================================

        loop all players:

            set {_p} to loop-player

            set {_uuid} to uuid of {_p}


            add {_uuid} to {adv.players::*}


            set {adv.player.name::%{_uuid}%} to "%{_p}%"


            set {adv.points::%{_uuid}%} to 0


            delete {adv.last::%{_uuid}%}

            delete {adv.category::%{_uuid}%}


            set {adv.registered::%{_uuid}%} to true


            # ------------------------------------------------
            # SCOREBOARD
            # ------------------------------------------------

            execute console command "scoreboard players set %name of {_p}% advPoints 0"


            # ------------------------------------------------
            # TELEPORT
            # ------------------------------------------------

            teleport {_p} to {adv.start.location}


        # ====================================================
        # BOSSBAR
        # ====================================================

        set {_minutes} to floor({adv.duration} / 60)


        # Delete previous BossBar if any

        set {_oldBar} to boss bar with key "adv:timer"


        if {_oldBar} is set:

            remove all players from {_oldBar}

            delete {_oldBar}


        # Create new BossBar

        set {_bar} to a new keyed blue bossbar with key "adv:timer" with title "ADVANCEMENT RACE %{_minutes}%:00"

        set progress of {_bar} to 100%

        set style of {_bar} to solid


        # ----------------------------------------------------
        # ADD PARTICIPANTS
        # ----------------------------------------------------

        loop all players:

            set {_p} to loop-player

            set {_uuid} to uuid of {_p}


            if {adv.registered::%{_uuid}%} is true:

                add {_p} to viewers of {_bar}


        # ====================================================
        # COUNTDOWN
        # ====================================================

        send "" to all players

        send "&b&lADVANCEMENT RACE" to all players

        send "&7Get ready!" to all players


        # ----------------------------------------------------
        # 3
        # ----------------------------------------------------

        send title "&6&l3" with subtitle "&fGET READY" to all players

        play sound "block.note_block.hat" at all players

        wait 1 second


        if {adv.game.id} is not {_gameID}:

            stop


        if {adv.running} is not true:

            stop


        # ----------------------------------------------------
        # 2
        # ----------------------------------------------------

        send title "&e&l2" with subtitle "&fGET READY" to all players

        play sound "block.note_block.hat" at all players

        wait 1 second


        if {adv.game.id} is not {_gameID}:

            stop


        if {adv.running} is not true:

            stop


        # ----------------------------------------------------
        # 1
        # ----------------------------------------------------

        send title "&a&l1" with subtitle "&fGET READY" to all players

        play sound "block.note_block.hat" at all players

        wait 1 second


        if {adv.game.id} is not {_gameID}:

            stop


        if {adv.running} is not true:

            stop


        # ====================================================
        # FINAL TELEPORT
        # ====================================================

        loop all players:

            set {_p} to loop-player

            set {_uuid} to uuid of {_p}


            if {adv.registered::%{_uuid}%} is true:

                teleport {_p} to {adv.start.location}


        # ====================================================
        # START!
        # ====================================================

        send title "&b&lSTART!" with subtitle "&fADVANCEMENT RACE" to all players

        play sound "entity.player.levelup" at all players


        send "" to all players

        send "&b&l==============================" to all players

        send "&b&l     ADVANCEMENT RACE START!" to all players

        send "&fComplete advancements to earn points!" to all players

        send "&b&l==============================" to all players

        send "" to all players


        # ----------------------------------------------------
        # GAME RUNNING
        # ----------------------------------------------------

        set {adv.countdown} to false


        stop


    # ========================================================
    # STOP
    # ========================================================

    if clicked slot is 14:

        close player's inventory


        if {adv.running} is not true:

            send "{@prefix} &cGame is not running." to player

            stop


        # ----------------------------------------------------
        # INVALIDATE COUNTDOWN
        # ----------------------------------------------------

        add 1 to {adv.game.id}


        # ----------------------------------------------------
        # STATE
        # ----------------------------------------------------

        set {adv.running} to false

        set {adv.countdown} to false

        set {adv.finish} to false

        set {adv.time} to 0


        # ----------------------------------------------------
        # BOSSBAR
        # ----------------------------------------------------

        set {_bar} to boss bar with key "adv:timer"


        if {_bar} is set:

            remove all players from {_bar}

            delete {_bar}


        # ----------------------------------------------------
        # SCOREBOARD
        # ----------------------------------------------------

        execute console command "scoreboard objectives setdisplay sidebar"


        loop all players:

            execute console command "scoreboard players reset %name of loop-player% advPoints"


        # ----------------------------------------------------
        # RETURN PARTICIPANTS
        # ----------------------------------------------------

        loop all players:

            set {_p} to loop-player

            set {_uuid} to uuid of {_p}


            if {adv.registered::%{_uuid}%} is true:

                if {adv.start.location} is set:

                    teleport {_p} to {adv.start.location}


        # ----------------------------------------------------
        # MESSAGE
        # ----------------------------------------------------

        send "" to all players

        send "&c&l==============================" to all players

        send "&c&l     ADVANCEMENT RACE STOPPED" to all players

        send "&fThe game has been stopped." to all players

        send "&c&l==============================" to all players

        send "" to all players

        stop


    # ========================================================
    # RESET
    # ========================================================

    if clicked slot is 16:

        close player's inventory


        # ----------------------------------------------------
        # INVALIDATE
        # ----------------------------------------------------

        add 1 to {adv.game.id}


        # ----------------------------------------------------
        # STATE
        # ----------------------------------------------------

        set {adv.running} to false

        set {adv.countdown} to false

        set {adv.finish} to false

        set {adv.time} to 0

        set {adv.duration} to 300


        # ----------------------------------------------------
        # BOSSBAR
        # ----------------------------------------------------

        set {_bar} to boss bar with key "adv:timer"


        if {_bar} is set:

            remove all players from {_bar}

            delete {_bar}


        # ----------------------------------------------------
        # SCOREBOARD
        # ----------------------------------------------------

        execute console command "scoreboard objectives setdisplay sidebar"


        loop all players:

            execute console command "scoreboard players reset %name of loop-player% advPoints"


        # ----------------------------------------------------
        # DATA
        # ----------------------------------------------------

        delete {adv.start.location}

        delete {adv.players::*}

        delete {adv.player.name::*}

        delete {adv.points::*}

        delete {adv.last::*}

        delete {adv.category::*}

        delete {adv.registered::*}

        delete {adv.result.points::*}

        delete {adv.result.last::*}

        delete {adv.result.category::*}

        delete {adv.result.name::*}

        delete {adv.gui.player::*}

        delete {adv.ranked::*}


        # ----------------------------------------------------
        # MESSAGE
        # ----------------------------------------------------

        send "" to all players

        send "&c&l==============================" to all players

        send "&c&l      ADVANCEMENT RACE RESET" to all players

        send "&fAll game data has been deleted." to all players

        send "&fGame time reset to &e5 minutes&f." to all players

        send "&c&l==============================" to all players

        send "" to all players

        stop


    # ========================================================
    # TIME 5
    # ========================================================

    if clicked slot is 28:

        if {adv.running} is true:

            send "{@prefix} &cTime cannot be changed during a game." to player

            stop


        set {adv.duration} to 300

        send "{@prefix} &aTIME: 5 MINUTES" to player

        stop


    # ========================================================
    # TIME 15
    # ========================================================

    if clicked slot is 29:

        if {adv.running} is true:

            send "{@prefix} &cTime cannot be changed during a game." to player

            stop


        set {adv.duration} to 900

        send "{@prefix} &eTIME: 15 MINUTES" to player

        stop


    # ========================================================
    # TIME 30
    # ========================================================

    if clicked slot is 30:

        if {adv.running} is true:

            send "{@prefix} &cTime cannot be changed during a game." to player

            stop


        set {adv.duration} to 1800

        send "{@prefix} &6TIME: 30 MINUTES" to player

        stop


    # ========================================================
    # TIME 60
    # ========================================================

    if clicked slot is 31:

        if {adv.running} is true:

            send "{@prefix} &cTime cannot be changed during a game." to player

            stop


        set {adv.duration} to 3600

        send "{@prefix} &cTIME: 60 MINUTES" to player

        stop


    # ========================================================
    # STATUS
    # ========================================================

    if clicked slot is 35:

        close player's inventory


        set {_gui} to chest inventory with 6 rows named "&f&lADVANCEMENT PLAYERS"


        # ----------------------------------------------------
        # HEADER
        # ----------------------------------------------------

        set slot 4 of {_gui} to paper named "&b&lADVANCEMENT RACE STATUS"


        # ----------------------------------------------------
        # STATUS
        # ----------------------------------------------------

        if {adv.running} is true:

            if {adv.countdown} is true:

                set {_status} to "&6COUNTDOWN"

            else:

                set {_status} to "&aRUNNING"

        else if {adv.finish} is true:

            set {_status} to "&cFINISHING"

        else:

            set {_status} to "&7READY"


        set {_minutes} to floor({adv.duration} / 60)


        set lore of slot 4 of {_gui} to "&7Status: %{_status}%" and "&7Time: &f%{_minutes}% MIN" and "&7Participants: &f%size of {adv.players::*}%"


        # ----------------------------------------------------
        # PLAYER HEADS
        # ----------------------------------------------------

        set {_slot} to 18


        loop all players:

            if {_slot} > 26:

                stop loop


            set {_p} to loop-player

            set {_uuid} to uuid of {_p}


            if {adv.registered::%{_uuid}%} is not true:

                continue


            set slot {_slot} of {_gui} to skull of {_p}

            set name of slot {_slot} of {_gui} to "&b%{_p}%"


            set {_points} to {adv.points::%{_uuid}%}


            if {_points} is not set:

                set {_points} to 0


            set lore of slot {_slot} of {_gui} to "&7Points: &e%{_points}%" and "&7Click to show detailed result."


            set {adv.gui.player::%player%::%{_slot}%} to {_uuid}


            add 1 to {_slot}


        # ----------------------------------------------------
        # BACK
        # ----------------------------------------------------

        set slot 49 of {_gui} to arrow named "&7&lBACK"

        set lore of slot 49 of {_gui} to "&7Return to main menu."


        open {_gui} to player

        stop


    # ========================================================
    # PLAYER RESULT
    # ========================================================

    if clicked slot >= 45:

        if clicked slot <= 53:


            set {_uuid} to {adv.gui.player::%player%::%clicked slot%}


            if {_uuid} is not set:

                stop


            set {_targetName} to {adv.player.name::%{_uuid}%}


            if {_targetName} is not set:

                set {_targetName} to "UNKNOWN"


            set {_points} to {adv.result.points::%{_uuid}%}


            if {_points} is not set:

                set {_points} to {adv.points::%{_uuid}%}


            if {_points} is not set:

                set {_points} to 0


            set {_last} to {adv.result.last::%{_uuid}%}


            if {_last} is not set:

                set {_last} to {adv.last::%{_uuid}%}


            if {_last} is not set:

                set {_last} to "NONE"


            set {_category} to {adv.result.category::%{_uuid}%}


            if {_category} is not set:

                set {_category} to {adv.category::%{_uuid}%}


            if {_category} is not set:

                set {_category} to "NONE"


            send "&8&m--------------------------------" to player

            send "&b&lPLAYER RESULT" to player

            send "&8&m--------------------------------" to player

            send "&7Player : &f%{_targetName}%" to player

            send "&7Points : &e%{_points}%" to player

            send "&7Last Advancement:" to player

            send "&f%{_last}%" to player

            send "&7Category : &b%{_category}%" to player

            send "&8&m--------------------------------" to player

            stop


# ============================================================
# STATUS GUI CLICK
# ============================================================

on inventory click:

    if name of event-inventory is not "&f&lADVANCEMENT PLAYERS":

        stop


    cancel event


    # --------------------------------------------------------
    # BACK
    # --------------------------------------------------------

    if clicked slot is 49:

        close player's inventory

        execute player command "/adv"

        stop


    # --------------------------------------------------------
    # PLAYER RESULT
    # --------------------------------------------------------

    if clicked slot >= 18:

        if clicked slot <= 26:


            set {_uuid} to {adv.gui.player::%player%::%clicked slot%}


            if {_uuid} is not set:

                stop


            set {_targetName} to {adv.player.name::%{_uuid}%}


            if {_targetName} is not set:

                set {_targetName} to "UNKNOWN"


            set {_points} to {adv.result.points::%{_uuid}%}


            if {_points} is not set:

                set {_points} to {adv.points::%{_uuid}%}


            if {_points} is not set:

                set {_points} to 0


            set {_last} to {adv.result.last::%{_uuid}%}


            if {_last} is not set:

                set {_last} to {adv.last::%{_uuid}%}


            if {_last} is not set:

                set {_last} to "NONE"


            set {_category} to {adv.result.category::%{_uuid}%}


            if {_category} is not set:

                set {_category} to {adv.category::%{_uuid}%}


            if {_category} is not set:

                set {_category} to "NONE"


            send "&8&m--------------------------------" to player

            send "&b&lPLAYER RESULT" to player

            send "&8&m--------------------------------" to player

            send "&7Player : &f%{_targetName}%" to player

            send "&7Points : &e%{_points}%" to player

            send "&7Last Advancement:" to player

            send "&f%{_last}%" to player

            send "&7Category : &b%{_category}%" to player

            send "&8&m--------------------------------" to player

            stop


# ============================================================
# TIMER
# ============================================================

every 1 second:

    if {adv.running} is not true:

        stop


    if {adv.countdown} is true:

        stop


    # --------------------------------------------------------
    # TIME
    # --------------------------------------------------------

    add 1 to {adv.time}


    set {_remaining} to {adv.duration} - {adv.time}


    if {_remaining} < 0:

        set {_remaining} to 0


    # ========================================================
    # FINAL 5 SECOND COUNTDOWN
    #
    # Remaining:
    #
    # 5 → 5
    # 4 → 4
    # 3 → 3
    # 2 → 2
    # 1 → 1
    # 0 → GAME SET
    # ========================================================

    if {_remaining} <= 5:

        if {_remaining} is 5:

            send title "&c&l5" with subtitle "&fGAME END" to all players

            play sound "block.note_block.hat" at all players


        else if {_remaining} is 4:

            send title "&6&l4" with subtitle "&fGAME END" to all players

            play sound "block.note_block.hat" at all players


        else if {_remaining} is 3:

            send title "&e&l3" with subtitle "&fGAME END" to all players

            play sound "block.note_block.hat" at all players


        else if {_remaining} is 2:

            send title "&a&l2" with subtitle "&fGAME END" to all players

            play sound "block.note_block.hat" at all players


        else if {_remaining} is 1:

            send title "&b&l1" with subtitle "&fGAME END" to all players

            play sound "block.note_block.hat" at all players


    # --------------------------------------------------------
    # TIME TEXT
    # --------------------------------------------------------

    set {_minutes} to floor({_remaining} / 60)

    set {_seconds} to {_remaining} - ({_minutes} * 60)


    if {_seconds} < 10:

        set {_secondText} to "0%{_seconds}%"

    else:

        set {_secondText} to "%{_seconds}%"


    set {_timeText} to "%{_minutes}%:%{_secondText}%"


    # --------------------------------------------------------
    # BOSSBAR
    # --------------------------------------------------------

    set {_bar} to boss bar with key "adv:timer"


    if {_bar} is set:

        set title of {_bar} to "ADVANCEMENT RACE %{_timeText}%"

        set progress of {_bar} to ({_remaining} / {adv.duration}) * 100%


    # ========================================================
    # TIME UP
    # ========================================================

    if {adv.time} < {adv.duration}:

        stop


    if {adv.finish} is true:

        stop


    # ========================================================
    # FINISH STATE
    # ========================================================

    set {adv.finish} to true

    set {adv.running} to false

    set {adv.countdown} to false


    set {_finishGameID} to {adv.game.id}


    # ========================================================
    # BOSSBAR 0:00
    # ========================================================

    set {_bar} to boss bar with key "adv:timer"


    if {_bar} is set:

        set title of {_bar} to "ADVANCEMENT RACE 0:00"

        set progress of {_bar} to 0%


    # ========================================================
    # SAVE RESULTS
    # ========================================================

    loop {adv.players::*}:

        set {_uuid} to loop-value


        set {adv.result.points::%{_uuid}%} to {adv.points::%{_uuid}%}

        set {adv.result.last::%{_uuid}%} to {adv.last::%{_uuid}%}

        set {adv.result.category::%{_uuid}%} to {adv.category::%{_uuid}%}

        set {adv.result.name::%{_uuid}%} to {adv.player.name::%{_uuid}%}


    # ========================================================
    # FINISH MESSAGE
    # ========================================================

    send "" to all players

    send "&c&l==============================" to all players

    send "&c&l    ADVANCEMENT RACE FINISH!" to all players

    send "&fTime is up!" to all players

    send "&c&l==============================" to all players

    send "" to all players


    # --------------------------------------------------------
    # RESULT
    # --------------------------------------------------------

    loop {adv.players::*}:

        set {_uuid} to loop-value

        set {_name} to {adv.result.name::%{_uuid}%}

        set {_points} to {adv.result.points::%{_uuid}%}


        if {_points} is not set:

            set {_points} to 0


        send "&b%{_name}% &7→ &e%{_points}% Points" to all players


    # ========================================================
    # TELEPORT
    #
    # At exactly 0:00
    # ========================================================

    loop all players:

        set {_p} to loop-player

        set {_uuid} to uuid of {_p}


        if {adv.registered::%{_uuid}%} is true:

            if {adv.start.location} is set:

                teleport {_p} to {adv.start.location}


    # ========================================================
    # GAME SET
    #
    # No additional 5-second wait.
    # ========================================================

    send title "&b&lGAME SET!" with subtitle "&fADVANCEMENT RACE FINISHED" to all players

    play sound "entity.player.levelup" at all players


    send "" to all players

    send "&b&l==============================" to all players

    send "&b&l        ADVANCEMENT RACE" to all players

    send "&f          GAME SET!" to all players

    send "&b&l==============================" to all players

    send "" to all players


    # ========================================================
    # RANKING
    # ========================================================

    delete {adv.ranked::*}


    set {_rank} to 1


    loop 3 times:

        set {_bestUUID} to ""

        set {_bestPoints} to -1


        loop {adv.players::*}:

            set {_uuid} to loop-value-2


            if {adv.ranked::%{_uuid}%} is true:

                continue


            set {_points} to {adv.result.points::%{_uuid}%}


            if {_points} is not set:

                set {_points} to 0


            if {_points} > {_bestPoints}:

                set {_bestPoints} to {_points}

                set {_bestUUID} to {_uuid}


        if {_bestUUID} is "":

            stop loop


        set {adv.ranked::%{_bestUUID}%} to true


        set {_bestName} to {adv.result.name::%{_bestUUID}%}


        if {_bestName} is not set:

            set {_bestName} to "UNKNOWN"


        if {_rank} is 1:

            broadcast "&6&l1st &f%{_bestName}% &7- &e%{_bestPoints}% Points"


        else if {_rank} is 2:

            broadcast "&7&l2nd &f%{_bestName}% &7- &e%{_bestPoints}% Points"


        else if {_rank} is 3:

            broadcast "&c&l3rd &f%{_bestName}% &7- &e%{_bestPoints}% Points"


        add 1 to {_rank}


    broadcast "&8&m================================"


    # ========================================================
    # REMOVE BOSSBAR
    # ========================================================

    set {_bar} to boss bar with key "adv:timer"


    if {_bar} is set:

        remove all players from {_bar}

        delete {_bar}


    # ========================================================
    # SCOREBOARD
    # ========================================================

    execute console command "scoreboard objectives setdisplay sidebar"


    loop all players:

        execute console command "scoreboard players reset %name of loop-player% advPoints"


    # ========================================================
    # CLEANUP
    # ========================================================

    delete {adv.ranked::*}

    set {adv.finish} to false

    set {adv.time} to 0


# ============================================================
# ADVANCEMENT EVENT
#
# BASED ON advtest v0.4.00
# ============================================================

on player advancement done:


    # ========================================================
    # GAME CHECK
    # ========================================================

    if {adv.running} is not true:

        stop


    # --------------------------------------------------------
    # COUNTDOWN CHECK
    #
    # Advancement gained during 3 / 2 / 1 does not count.
    # --------------------------------------------------------

    if {adv.countdown} is true:

        stop


    # ========================================================
    # PLAYER
    # ========================================================

    set {_player} to event-player

    set {_uuid} to uuid of {_player}


    # ========================================================
    # PARTICIPANT
    # ========================================================

    if {adv.registered::%{_uuid}%} is not true:

        stop


    # ========================================================
    # ADVANCEMENT ID
    #
    # Same method as advtest v0.4.00
    # ========================================================

    set {_advancement} to "%event-advancement%"


    # ========================================================
    # CATEGORY
    # ========================================================

    set {_valid} to false

    set {_category} to "UNKNOWN"


    # --------------------------------------------------------
    # STORY
    # --------------------------------------------------------

    if {_advancement} starts with "minecraft:story/":

        set {_valid} to true

        set {_category} to "story"


    # --------------------------------------------------------
    # NETHER
    # --------------------------------------------------------

    else if {_advancement} starts with "minecraft:nether/":

        set {_valid} to true

        set {_category} to "nether"


    # --------------------------------------------------------
    # END
    # --------------------------------------------------------

    else if {_advancement} starts with "minecraft:end/":

        set {_valid} to true

        set {_category} to "end"


    # --------------------------------------------------------
    # ADVENTURE
    # --------------------------------------------------------

    else if {_advancement} starts with "minecraft:adventure/":

        set {_valid} to true

        set {_category} to "adventure"


    # --------------------------------------------------------
    # HUSBANDRY
    # --------------------------------------------------------

    else if {_advancement} starts with "minecraft:husbandry/":

        set {_valid} to true

        set {_category} to "husbandry"


    # ========================================================
    # INVALID
    # ========================================================

    if {_valid} is not true:

        stop


    # ========================================================
    # POINT
    # ========================================================

    add 1 to {adv.points::%{_uuid}%}


    set {_points} to {adv.points::%{_uuid}%}


    # ========================================================
    # LAST ADVANCEMENT
    # ========================================================

    set {adv.last::%{_uuid}%} to {_advancement}

    set {adv.category::%{_uuid}%} to {_category}


    # ========================================================
    # SCOREBOARD
    #
    # Same method as advtest v0.4.00
    # ========================================================

    execute console command "scoreboard players set %name of {_player}% advPoints %{_points}%"


    # ========================================================
    # PLAYER MESSAGE
    #
    # Same basic method as advtest v0.4.00
    # ========================================================

    send "" to {_player}

    send "{@prefix} &a&lADVANCEMENT DETECTED!" to {_player}

    send "{@prefix} &7Advancement: &e%{_advancement}%" to {_player}

    send "{@prefix} &7Category: &b%{_category}%" to {_player}

    send "{@prefix} &7Point: &a+1" to {_player}

    send "{@prefix} &7Total: &e%{_points}%" to {_player}

    play sound "entity.experience_orb.pickup" at {_player}


# ============================================================
# PLAYER JOIN
# ============================================================

on join:

    if {adv.running} is not true:

        stop


    set {_uuid} to uuid of player


    if {adv.registered::%{_uuid}%} is not true:

        stop


    wait 2 ticks


    if {adv.running} is not true:

        stop


    # --------------------------------------------------------
    # TELEPORT
    # --------------------------------------------------------

    if {adv.start.location} is set:

        teleport player to {adv.start.location}


    # --------------------------------------------------------
    # SCOREBOARD
    # --------------------------------------------------------

    set {_points} to {adv.points::%{_uuid}%}


    if {_points} is not set:

        set {_points} to 0


    execute console command "scoreboard players set %name of player% advPoints %{_points}%"

    execute console command "scoreboard objectives setdisplay sidebar advPoints"


    # --------------------------------------------------------
    # BOSSBAR
    # --------------------------------------------------------

    set {_bar} to boss bar with key "adv:timer"


    if {_bar} is set:

        add player to viewers of {_bar}


# ============================================================
# PLAYER QUIT
# ============================================================

on quit:

    set {_uuid} to uuid of player


    if {_uuid} is not in {adv.players::*}:

        stop


    # Participant data remains.
    # Rejoining player can continue.

    stop
