# ============================================================
# ADVANCEMENT RACE GAME SYSTEM
#
# Version : v0.1.00
# Date    : 2026-09-08
#
# Minecraft Java Edition + Paper + Skript + SkBee
#
# ============================================================
#
# GAME OVERVIEW
#
#   対象Advancementを達成すると +1 Point。
#
#   制限時間内に最も多くの進捗を達成した
#   プレイヤーが勝者。
#
#
# TARGET ADVANCEMENT
#
#   minecraft:story/
#   minecraft:nether/
#   minecraft:end/
#   minecraft:adventure/
#   minecraft:husbandry/
#
#
# COMMAND
#
#   /adv
#
#
# GUI
#
#   SET
#   START
#   STOP
#   RESET
#
#   TIME
#   5 MIN
#   15 MIN
#   30 MIN
#   60 MIN
#
#   PLAYER HEAD
#
#
# GAME FLOW
#
#   SET
#      ↓
#   START
#      ↓
#   ALL PLAYER → START POSITION
#      ↓
#   3
#   2
#   1
#   START
#      ↓
#   GAME RUNNING
#      ↓
#   TIMER 00:00
#      ↓
#   3
#   2
#   1
#   GAME SET
#      ↓
#   RANKING
#      ↓
#   ALL PLAYER → START POSITION
#
# ============================================================


options:
    prefix: &8[&bADV&8]&r


# ============================================================
# VARIABLES
# ============================================================
#
# {adv.running}
#       Game running state
#
# {adv.starting}
#       Countdown state
#
# {adv.finished}
#       Game finished state
#
# {adv.debug}
#       Debug mode
#
# {adv.time.selected}
#       Selected time in seconds
#
# {adv.time.remaining}
#       Remaining time in seconds
#
# {adv.start.location}
#       Start location
#
# {adv.points::UUID}
#       Player points
#
# {adv.last::UUID}
#       Last advancement
#
# {adv.category::UUID}
#       Last advancement category
#
# {adv.result.points::UUID}
#       Final points
#
# {adv.result.last::UUID}
#       Final last advancement
#
# {adv.result.category::UUID}
#       Final category
#
# ============================================================


# ============================================================
# SCRIPT LOAD
# ============================================================

on script load:

    set {adv.running} to false
    set {adv.starting} to false
    set {adv.finished} to false

    set {adv.debug} to false

    # Default Time
    set {adv.time.selected} to 300
    set {adv.time.remaining} to 300

    # Scoreboard cleanup
    execute console command "scoreboard objectives remove advPoints"

    # BossBar cleanup
    execute console command "bossbar remove adv:timer"

    log "[ADV] Advancement Race Game System loaded."


# ============================================================
# COMMAND
# ============================================================

command /adv:
    permission: op
    trigger:

        open chest inventory with 6 rows named "&8ADVANCEMENT RACE"

        # ====================================================
        # TITLE
        # ====================================================

        set slot 4 of player's current inventory to nether star named "&b&lADVANCEMENT RACE"

        set slot 3 of player's current inventory to black stained glass pane named " "
        set slot 5 of player's current inventory to black stained glass pane named " "


        # ====================================================
        # SET
        # ====================================================

        set slot 10 of player's current inventory to compass named "&e&lSET START POSITION" with lore "&7現在地をスタート地点に設定"


        # ====================================================
        # START
        # ====================================================

        set slot 12 of player's current inventory to lime concrete named "&a&lSTART GAME" with lore "&7ゲーム開始"


        # ====================================================
        # STOP
        # ====================================================

        set slot 14 of player's current inventory to red concrete named "&c&lSTOP GAME" with lore "&7ゲームを強制終了"


        # ====================================================
        # RESET
        # ====================================================

        set slot 16 of player's current inventory to barrier named "&4&lRESET" with lore "&7ゲームデータをリセット"


        # ====================================================
        # TIME SELECT
        # ====================================================

        set slot 28 of player's current inventory to clock named "&e&l5 MINUTES" with lore "&7300 Seconds"

        set slot 29 of player's current inventory to clock named "&6&l15 MINUTES" with lore "&7900 Seconds"

        set slot 30 of player's current inventory to clock named "&c&l30 MINUTES" with lore "&71800 Seconds"

        set slot 31 of player's current inventory to clock named "&4&l60 MINUTES" with lore "&73600 Seconds"


        # ====================================================
        # CURRENT TIME
        # ====================================================

        set {_selected} to {adv.time.selected}

        if {_selected} is 300:
            set {_timeText} to "&a5 MINUTES"

        else if {_selected} is 900:
            set {_timeText} to "&e15 MINUTES"

        else if {_selected} is 1800:
            set {_timeText} to "&630 MINUTES"

        else if {_selected} is 3600:
            set {_timeText} to "&c60 MINUTES"

        else:
            set {_timeText} to "&fUNKNOWN"

        set slot 33 of player's current inventory to clock named "&b&lSELECTED TIME" with lore "&7%{_timeText}%"


        # ====================================================
        # PLAYER HEAD AREA
        # ====================================================

        set {_slot} to 45

        loop all players:

            if {_slot} > 53:
                stop loop

            set {_head} to player head of loop-player

            set name of {_head} to "&b%loop-player%"

            set lore of {_head} to "&7Click to show player result"

            set slot {_slot} of player's current inventory to {_head}

            add 1 to {_slot}


# ============================================================
# GUI CLICK
# ============================================================

on inventory click:

    if name of event-inventory is not "&8ADVANCEMENT RACE":
        stop

    cancel event

    if clicked item is air:
        stop


    # ========================================================
    # SET
    # ========================================================

    if clicked slot is 10:

        if {adv.running} is true:
            send "{@prefix} &cゲーム中はSETできません。" to player
            stop

        set {adv.start.location} to location of player

        send "{@prefix} &aスタート地点を設定しました。" to player

        send "{@prefix} &7X: &f%x-coordinate of player%" to player
        send "{@prefix} &7Y: &f%y-coordinate of player%" to player
        send "{@prefix} &7Z: &f%z-coordinate of player%" to player

        stop


    # ========================================================
    # START
    # ========================================================

    if clicked slot is 12:

        if {adv.running} is true:
            send "{@prefix} &cすでにゲームが開始されています。" to player
            stop

        if {adv.starting} is true:
            send "{@prefix} &c開始カウントダウン中です。" to player
            stop

        if {adv.start.location} is not set:
            send "{@prefix} &c先にSETでスタート地点を設定してください。" to player
            stop

        close player's inventory

        set {adv.finished} to false
        set {adv.starting} to true

        # ----------------------------------------------------
        # Time reset
        # ----------------------------------------------------

        set {adv.time.remaining} to {adv.time.selected}


        # ----------------------------------------------------
        # Scoreboard create
        # ----------------------------------------------------

        execute console command "scoreboard objectives remove advPoints"
        execute console command "scoreboard objectives add advPoints dummy Points"
        execute console command "scoreboard objectives setdisplay sidebar advPoints"


        # ----------------------------------------------------
        # Player initialize
        # ----------------------------------------------------

        loop all players:

            set {_uuid} to uuid of loop-player

            set {adv.points::%{_uuid}%} to 0

            delete {adv.last::%{_uuid}%}
            delete {adv.category::%{_uuid}%}

            execute console command "scoreboard players set %loop-player% advPoints 0"

            teleport loop-player to {adv.start.location}


        # ----------------------------------------------------
        # BossBar create
        # ----------------------------------------------------

        execute console command "bossbar remove adv:timer"

        execute console command "bossbar add adv:timer {\"text\":\"00:00\"}"

        execute console command "bossbar set adv:timer color blue"

        execute console command "bossbar set adv:timer style progress"

        execute console command "bossbar set adv:timer max %{adv.time.selected}%"

        execute console command "bossbar set adv:timer value %{adv.time.selected}%"

        execute console command "bossbar set adv:timer players @a"


        # ----------------------------------------------------
        # START COUNTDOWN
        # ----------------------------------------------------

        send "" to all players

        send "{@prefix} &bGAME STARTING..." to all players

        wait 1 second

        send "&a&l3" to all players

        wait 1 second

        send "&e&l2" to all players

        wait 1 second

        send "&c&l1" to all players

        wait 1 second

        send "&b&lSTART!" to all players

        set {adv.starting} to false

        set {adv.running} to true

        stop


    # ========================================================
    # STOP
    # ========================================================

    if clicked slot is 14:

        if {adv.running} is not true:
            send "{@prefix} &cゲームは開始されていません。" to player
            stop

        set {adv.running} to false
        set {adv.starting} to false

        execute console command "bossbar remove adv:timer"

        send "{@prefix} &cGAME FORCE STOPPED." to all players

        loop all players:

            if {adv.start.location} is set:
                teleport loop-player to {adv.start.location}

        stop


    # ========================================================
    # RESET
    # ========================================================

    if clicked slot is 16:

        set {adv.running} to false
        set {adv.starting} to false
        set {adv.finished} to false

        set {adv.time.remaining} to {adv.time.selected}

        delete {adv.points::*}
        delete {adv.last::*}
        delete {adv.category::*}

        delete {adv.result.points::*}
        delete {adv.result.last::*}
        delete {adv.result.category::*}

        execute console command "bossbar remove adv:timer"

        execute console command "scoreboard objectives remove advPoints"

        send "{@prefix} &eRESET COMPLETE." to all players

        stop


    # ========================================================
    # 5 MINUTES
    # ========================================================

    if clicked slot is 28:

        if {adv.running} is true:
            send "{@prefix} &cゲーム中は変更できません。" to player
            stop

        set {adv.time.selected} to 300

        send "{@prefix} &aTIME: 5 MINUTES" to player

        stop


    # ========================================================
    # 15 MINUTES
    # ========================================================

    if clicked slot is 29:

        if {adv.running} is true:
            send "{@prefix} &cゲーム中は変更できません。" to player
            stop

        set {adv.time.selected} to 900

        send "{@prefix} &eTIME: 15 MINUTES" to player

        stop


    # ========================================================
    # 30 MINUTES
    # ========================================================

    if clicked slot is 30:

        if {adv.running} is true:
            send "{@prefix} &cゲーム中は変更できません。" to player
            stop

        set {adv.time.selected} to 1800

        send "{@prefix} &6TIME: 30 MINUTES" to player

        stop


    # ========================================================
    # 60 MINUTES
    # ========================================================

    if clicked slot is 31:

        if {adv.running} is true:
            send "{@prefix} &cゲーム中は変更できません。" to player
            stop

        set {adv.time.selected} to 3600

        send "{@prefix} &cTIME: 60 MINUTES" to player

        stop


    # ========================================================
    # PLAYER HEAD RESULT
    #
    # Slot 45 - 53
    # ========================================================

    if clicked slot >= 45:

        if clicked slot <= 53:

            set {_targetName} to uncolored name of clicked item

            if {_targetName} is not set:
                stop

            send "&8&m--------------------------------" to player

            send "&bPLAYER RESULT" to player

            send "&8&m--------------------------------" to player

            send "&7Player : &f%{_targetName}%" to player


            # ------------------------------------------------
            # Find player UUID
            # ------------------------------------------------

            loop all offline players:

                if name of loop-player is {_targetName}:

                    set {_uuid} to uuid of loop-player


                    # RESULT POINTS

                    set {_points} to {adv.result.points::%{_uuid}%}

                    if {_points} is not set:

                        set {_points} to {adv.points::%{_uuid}%}

                    if {_points} is not set:

                        set {_points} to 0


                    # LAST ADVANCEMENT

                    set {_last} to {adv.result.last::%{_uuid}%}

                    if {_last} is not set:

                        set {_last} to {adv.last::%{_uuid}%}

                    if {_last} is not set:

                        set {_last} to "NONE"


                    # CATEGORY

                    set {_category} to {adv.result.category::%{_uuid}%}

                    if {_category} is not set:

                        set {_category} to {adv.category::%{_uuid}%}

                    if {_category} is not set:

                        set {_category} to "NONE"


                    send "&7Points : &e%{_points}%" to player

                    send "&7Last Advancement:" to player

                    send "&f%{_last}%" to player

                    send "&7Category : &b%{_category}%" to player

                    stop loop


            send "&8&m--------------------------------" to player

            stop


# ============================================================
# TIMER
# ============================================================

every 1 second:

    if {adv.running} is not true:
        stop


    # ========================================================
    # TIME DECREASE
    # ========================================================

    remove 1 from {adv.time.remaining}


    if {adv.time.remaining} < 0:
        set {adv.time.remaining} to 0


    # ========================================================
    # TIME FORMAT
    # ========================================================

    set {_seconds} to {adv.time.remaining}

    set {_minutes} to floor({_seconds} / 60)

    set {_remainSeconds} to {_seconds} mod 60


    # --------------------------------------------------------
    # MM
    # --------------------------------------------------------

    if {_minutes} < 10:

        set {_mm} to "0%{_minutes}%"

    else:

        set {_mm} to "%{_minutes}%"


    # --------------------------------------------------------
    # SS
    # --------------------------------------------------------

    if {_remainSeconds} < 10:

        set {_ss} to "0%{_remainSeconds}%"

    else:

        set {_ss} to "%{_remainSeconds}%"


    set {_timeText} to "%{_mm}%:%{_ss}%"


    # ========================================================
    # BOSSBAR UPDATE
    # ========================================================

    execute console command "bossbar set adv:timer name {\"text\":\"%{_timeText}%\"}"

    execute console command "bossbar set adv:timer value %{adv.time.remaining}%"


    # ========================================================
    # GAME END CHECK
    # ========================================================

    if {adv.time.remaining} > 0:
        stop


    # ========================================================
    # GAME END
    # ========================================================

    set {adv.running} to false

    set {adv.finished} to true


    send "" to all players

    send "&c&l3" to all players

    wait 1 second

    send "&e&l2" to all players

    wait 1 second

    send "&a&l1" to all players

    wait 1 second

    send "&b&lGAME SET!" to all players


    # ========================================================
    # SAVE RESULTS
    # ========================================================

    loop all players:

        set {_uuid} to uuid of loop-player

        set {adv.result.points::%{_uuid}%} to {adv.points::%{_uuid}%}

        set {adv.result.last::%{_uuid}%} to {adv.last::%{_uuid}%}

        set {adv.result.category::%{_uuid}%} to {adv.category::%{_uuid}%}


    # ========================================================
    # RANKING
    # ========================================================

    wait 1 second

    broadcast "&8&m================================"

    broadcast "&b&lADVANCEMENT RACE RESULT"

    broadcast "&8&m================================"


    # --------------------------------------------------------
    # Ranking
    #
    # まず最高点から順番に検索
    # --------------------------------------------------------

    set {_rank} to 1

    loop 3 times:

        set {_bestPlayer} to ""
        set {_bestPoints} to -1


        loop all players:

            set {_uuid} to uuid of loop-player

            set {_points} to {adv.result.points::%{_uuid}%}

            if {_points} is not set:
                set {_points} to 0


            if {_points} > {_bestPoints}:

                if {adv.ranked::%{_uuid}%} is not true:

                    set {_bestPoints} to {_points}

                    set {_bestPlayer} to loop-player


        if {_bestPlayer} is not "":

            set {_uuid} to uuid of {_bestPlayer}

            set {adv.ranked::%{_uuid}%} to true


            if {_rank} is 1:
                broadcast "&6&l1st &f%{_bestPlayer}% &7- &e%{_bestPoints}% Points"

            else if {_rank} is 2:
                broadcast "&7&l2nd &f%{_bestPlayer}% &7- &e%{_bestPoints}% Points"

            else if {_rank} is 3:
                broadcast "&c&l3rd &f%{_bestPlayer}% &7- &e%{_bestPoints}% Points"


            add 1 to {_rank}


    broadcast "&8&m================================"


    # ========================================================
    # RETURN START
    # ========================================================

    wait 1 second

    loop all players:

        if {adv.start.location} is set:

            teleport loop-player to {adv.start.location}


    # ========================================================
    # CLEANUP
    # ========================================================

    execute console command "bossbar remove adv:timer"

    delete {adv.ranked::*}


# ============================================================
# ADVANCEMENT EVENT
#
# SkBee required
# ============================================================

on player advancement done:


    # ========================================================
    # GAME RUNNING CHECK
    # ========================================================

    if {adv.running} is not true:
        stop


    # ========================================================
    # PLAYER
    # ========================================================

    set {_player} to event-player

    set {_uuid} to uuid of {_player}


    # ========================================================
    # ADVANCEMENT ID
    # ========================================================

    set {_advancement} to "%event-advancement%"


    # ========================================================
    # CATEGORY CHECK
    # ========================================================

    set {_valid} to false

    set {_category} to "UNKNOWN"


    # --------------------------------------------------------
    # STORY
    # --------------------------------------------------------

    if {_advancement} starts with "minecraft:story/":

        set {_valid} to true

        set {_category} to "story"


    # --------------------------------------------------------
    # NETHER
    # --------------------------------------------------------

    else if {_advancement} starts with "minecraft:nether/":

        set {_valid} to true

        set {_category} to "nether"


    # --------------------------------------------------------
    # END
    # --------------------------------------------------------

    else if {_advancement} starts with "minecraft:end/":

        set {_valid} to true

        set {_category} to "end"


    # --------------------------------------------------------
    # ADVENTURE
    # --------------------------------------------------------

    else if {_advancement} starts with "minecraft:adventure/":

        set {_valid} to true

        set {_category} to "adventure"


    # --------------------------------------------------------
    # HUSBANDRY
    # --------------------------------------------------------

    else if {_advancement} starts with "minecraft:husbandry/":

        set {_valid} to true

        set {_category} to "husbandry"


    # ========================================================
    # INVALID
    # ========================================================

    if {_valid} is not true:

        if {adv.debug} is true:

            log "[ADV DEBUG] Ignored Advancement: %{_advancement}%"

        stop


    # ========================================================
    # POINT
    # ========================================================

    add 1 to {adv.points::%{_uuid}%}

    set {_points} to {adv.points::%{_uuid}%}


    # ========================================================
    # SAVE LAST ADVANCEMENT
    # ========================================================

    set {adv.last::%{_uuid}%} to {_advancement}

    set {adv.category::%{_uuid}%} to {_category}


    # ========================================================
    # SCOREBOARD UPDATE
    # ========================================================

    execute console command "scoreboard players set %name of {_player}% advPoints %{_points}%"


    # ========================================================
    # PLAYER MESSAGE
    # ========================================================

    send "" to {_player}

    send "{@prefix} &aADVANCEMENT!" to {_player}

    send "{@prefix} &7%{_advancement}%" to {_player}

    send "{@prefix} &7Category: &b%{_category}%" to {_player}

    send "{@prefix} &7Point: &a+1 &7Total: &e%{_points}%" to {_player}


    # ========================================================
    # DEBUG
    # ========================================================

    if {adv.debug} is true:

        log "[ADV DEBUG] Player: %{_player}%"

        log "[ADV DEBUG] Advancement: %{_advancement}%"

        log "[ADV DEBUG] Category: %{_category}%"

        log "[ADV DEBUG] Total: %{_points}%"


# ============================================================
# PLAYER JOIN
#
# ゲーム途中参加時にもBossBarを表示
# ============================================================

on join:

    if {adv.running} is true:

        execute console command "bossbar set adv:timer players @a"


# ============================================================
# PLAYER QUIT
# ============================================================

on quit:

    # 特別な処理なし
    stop
