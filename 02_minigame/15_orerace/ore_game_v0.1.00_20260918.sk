# ============================================================
# ORE RACE GAME SYSTEM
# Version : v0.1.00(v0.0.05)
# Date    : 2026-09-18
#
# Minecraft Java Edition
# Paper + Skript 2.16.1
#
# ============================================================
#
# COMMAND
#
#   /ore
#
#   /ore set
#   /ore time 5
#   /ore time 15
#   /ore time 30
#   /ore time 60
#   /ore start
#   /ore stop
#   /ore reset
#   /ore result
#   /ore status
#   /ore debug
#
# ============================================================
#
# START
#
#   5
#   4
#   3
#   2
#   1
#   START!
#
# ============================================================
#
# GAME
#
#   BossBar MM:SS
#   Scoreboard = Points
#
# ============================================================
#
# END
#
#   00:05
#     ↓
#   5
#   4
#   3
#   2
#   1
#     ↓
#   FINISH!
#     ↓
#   Time Up!
#   Final Results
#     ↓
#   RESULT
#     ↓
#   3 seconds
#     ↓
#   RETURN TO START
#     ↓
#   BossBar OFF
#     ↓
#   Scoreboard OFF
#
# ============================================================


options:
    prefix: &8[&6OreRace&8]&r
    gui-name: &8OreRace Control
    bossbar-id: orerace:timer


# ============================================================
# COMMAND
# ============================================================

command /ore [<text>] [<number>]:
    permission: op
    trigger:

        # ====================================================
        # GUI
        # ====================================================

        if arg-1 is not set:

            open chest inventory with 3 rows named "{@gui-name}" to player

            wait 1 tick

            # ------------------------------------------------
            # TIME TITLE
            # ------------------------------------------------

            set slot 10 of player's current inventory to clock named "&e&lTIME"

            if {orerace.max-time} is not set:

                set lore of slot 10 of player's current inventory to "&7Current: &f15:00" and "&8" and "&eSelect game time below."

            else:

                set {_gui-minutes} to floor({orerace.max-time} / 60)

                set lore of slot 10 of player's current inventory to "&7Current: &f%{_gui-minutes}%:00" and "&8" and "&eSelect game time below"


            # ------------------------------------------------
            # 5 MIN
            # ------------------------------------------------

            set slot 11 of player's current inventory to gold ingot named "&65 MIN"

            if {orerace.max-time} is 300:

                set slot 11 of player's current inventory to emerald named "&a&l5 MIN"

                set lore of slot 11 of player's current inventory to "&aSelected"

            else:

                set lore of slot 11 of player's current inventory to "&75 minutes" and "&8" and "&eClick to select"


            # ------------------------------------------------
            # 15 MIN
            # ------------------------------------------------

            set slot 12 of player's current inventory to gold ingot named "&615 MIN"

            if {orerace.max-time} is 900:

                set slot 12 of player's current inventory to emerald named "&a&l15 MIN"

                set lore of slot 12 of player's current inventory to "&aSelected"

            else:

                set lore of slot 12 of player's current inventory to "&715 minutes" and "&8" and "&eClick to select"


            # ------------------------------------------------
            # 30 MIN
            # ------------------------------------------------

            set slot 13 of player's current inventory to gold ingot named "&630 MIN"

            if {orerace.max-time} is 1800:

                set slot 13 of player's current inventory to emerald named "&a&l30 MIN"

                set lore of slot 13 of player's current inventory to "&aSelected"

            else:

                set lore of slot 13 of player's current inventory to "&730 minutes" and "&8" and "&eClick to select"


            # ------------------------------------------------
            # 60 MIN
            # ------------------------------------------------

            set slot 14 of player's current inventory to gold ingot named "&660 MIN"

            if {orerace.max-time} is 3600:

                set slot 14 of player's current inventory to emerald named "&a&l60 MIN"

                set lore of slot 14 of player's current inventory to "&aSelected"

            else:

                set lore of slot 14 of player's current inventory to "&760 minutes" and "&8" and "&eClick to select"


            # ------------------------------------------------
            # SET
            # ------------------------------------------------

            set slot 15 of player's current inventory to compass named "&a&lSET"

            if {orerace.start.x} is set:

                set lore of slot 15 of player's current inventory to "&7Start position is registered." and "&8" and "&aClick to update"

            else:

                set lore of slot 15 of player's current inventory to "&7Register current position." and "&8" and "&aClick to set"


            # ------------------------------------------------
            # START
            # ------------------------------------------------

            set slot 16 of player's current inventory to lime wool named "&a&lSTART"

            set lore of slot 16 of player's current inventory to "&7Start OreRace." and "&8" and "&eClick to start"


            # ------------------------------------------------
            # STOP
            # ------------------------------------------------

            set slot 19 of player's current inventory to red wool named "&c&lSTOP"

            set lore of slot 19 of player's current inventory to "&7Stop current game." and "&8" and "&eClick to stop"


            # ------------------------------------------------
            # RESET
            # ------------------------------------------------

            set slot 21 of player's current inventory to barrier named "&c&lRESET"

            set lore of slot 21 of player's current inventory to "&7Reset all OreRace data." and "&8" and "&eClick to reset"


            # ------------------------------------------------
            # RESULT
            # ------------------------------------------------

            set slot 23 of player's current inventory to book named "&b&lRESULT"

            set lore of slot 23 of player's current inventory to "&7Show latest ranking." and "&8" and "&eClick to view"


            # ------------------------------------------------
            # STATUS
            # ------------------------------------------------

            set slot 25 of player's current inventory to paper named "&f&lSTATUS"

            set lore of slot 25 of player's current inventory to "&7Show current status."


            # ------------------------------------------------
            # STATE
            # ------------------------------------------------

            if {orerace.state} is "RUNNING":

                set slot 26 of player's current inventory to lime dye named "&a&lRUNNING"

            else if {orerace.state} is "COUNTDOWN":

                set slot 26 of player's current inventory to yellow dye named "&e&lCOUNTDOWN"

            else if {orerace.state} is "ENDING":

                set slot 26 of player's current inventory to red dye named "&c&lENDING"

            else:

                set slot 26 of player's current inventory to gray dye named "&7&lIDLE"


            stop


        # ====================================================
        # SET
        # ====================================================

        if arg-1 is "set":

            if {orerace.state} is "RUNNING":

                send "{@prefix} &cGame is running." to player
                stop

            if {orerace.state} is "COUNTDOWN":

                send "{@prefix} &cGame is starting." to player
                stop

            if {orerace.state} is "ENDING":

                send "{@prefix} &cGame is ending." to player
                stop


            set {orerace.start.x} to x-coordinate of player
            set {orerace.start.y} to y-coordinate of player
            set {orerace.start.z} to z-coordinate of player
            set {orerace.start.world} to world of player


            send "" to player
            send "&8&m----------------------------------------" to player
            send "{@prefix} &a&lSTART POSITION SET" to player
            send "" to player
            send "&7X: &f%{orerace.start.x}%" to player
            send "&7Y: &f%{orerace.start.y}%" to player
            send "&7Z: &f%{orerace.start.z}%" to player
            send "&7World: &f%{orerace.start.world}%" to player
            send "&8&m----------------------------------------" to player

            stop


        # ====================================================
        # TIME
        # ====================================================

        if arg-1 is "time":

            if {orerace.state} is "RUNNING":

                send "{@prefix} &cGame is running." to player
                stop

            if {orerace.state} is "COUNTDOWN":

                send "{@prefix} &cGame is starting." to player
                stop

            if arg-2 is not set:

                send "{@prefix} &e/ore time <5|15|30|60>" to player
                stop


            if arg-2 is 5:

                set {orerace.max-time} to 300

                send "{@prefix} &aTime set to &e5:00&a." to player
                stop


            if arg-2 is 15:

                set {orerace.max-time} to 900

                send "{@prefix} &aTime set to &e15:00&a." to player
                stop


            if arg-2 is 30:

                set {orerace.max-time} to 1800

                send "{@prefix} &aTime set to &e30:00&a." to player
                stop


            if arg-2 is 60:

                set {orerace.max-time} to 3600

                send "{@prefix} &aTime set to &e60:00&a." to player
                stop


            send "{@prefix} &cInvalid time." to player
            send "{@prefix} &7Use: &f/ore time 5|15|30|60" to player

            stop


        # ====================================================
        # START
        # ====================================================

        if arg-1 is "start":

            # ------------------------------------------------
            # START POSITION
            # ------------------------------------------------

            if {orerace.start.x} is not set:

                send "{@prefix} &cStart position is not set." to player
                send "{@prefix} &7Use &f/ore set &7first." to player

                stop


            # ------------------------------------------------
            # STATE
            # ------------------------------------------------

            if {orerace.state} is "RUNNING":

                send "{@prefix} &cOreRace is already running." to player
                stop


            if {orerace.state} is "COUNTDOWN":

                send "{@prefix} &cOreRace is already starting." to player
                stop


            if {orerace.state} is "ENDING":

                send "{@prefix} &cOreRace is ending." to player
                stop


            # ------------------------------------------------
            # DEFAULT TIME
            # ------------------------------------------------

            if {orerace.max-time} is not set:

                set {orerace.max-time} to 900


            # ------------------------------------------------
            # GAME ID
            # ------------------------------------------------

            if {orerace.game-id} is not set:

                set {orerace.game-id} to 0

            add 1 to {orerace.game-id}

            set {_gameid} to {orerace.game-id}


            # ------------------------------------------------
            # STATE
            # ------------------------------------------------

            set {orerace.state} to "COUNTDOWN"


            # ------------------------------------------------
            # DATA RESET
            # ------------------------------------------------

            delete {orerace.points::*}
            delete {orerace.count::*}
            delete {orerace.orecount::*}
            delete {orerace.players::*}
            delete {orerace.playername::*}


            # ------------------------------------------------
            # REGISTER PLAYERS
            # ------------------------------------------------

            loop all players:

                set {_uuid} to uuid of loop-player

                set {orerace.players::%{_uuid}%} to true
                set {orerace.playername::%{_uuid}%} to name of loop-player

                set {orerace.points::%{_uuid}%} to 0
                set {orerace.count::%{_uuid}%} to 0


            # ------------------------------------------------
            # SCOREBOARD
            # ------------------------------------------------

            execute console command "scoreboard objectives remove orePoints"

            execute console command "scoreboard objectives add orePoints dummy Points"

            execute console command "scoreboard objectives setdisplay sidebar orePoints"


            loop all players:

                execute console command "scoreboard players set %loop-player% orePoints 0"


            # ------------------------------------------------
            # BOSSBAR
            # ------------------------------------------------

            set {_bar} to boss bar from key "{@bossbar-id}"

            if {_bar} is not set:

                set {_bar} to a keyed yellow bossbar with key "{@bossbar-id}" titled "&6OreRace"

            set title of {_bar} to "&6&lORE RACE &f%{orerace.max-time}%s"

            set color of {_bar} to yellow

            set style of {_bar} to progress

            set progress of {_bar} to 100%


            loop all players:

                add loop-player to viewers of {_bar}


            # =================================================
            # 5 4 3 2 1
            # =================================================

            send title "&e&l5" with subtitle "&7GET READY" to all players

            play sound "block.note_block.pling" with volume 1 and pitch 1 to all players

            wait 1 second


            if {orerace.game-id} is not {_gameid}:

                stop

            if {orerace.state} is not "COUNTDOWN":

                stop


            send title "&e&l4" with subtitle "&7GET READY" to all players

            play sound "block.note_block.pling" with volume 1 and pitch 1 to all players

            wait 1 second


            if {orerace.game-id} is not {_gameid}:

                stop

            if {orerace.state} is not "COUNTDOWN":

                stop


            send title "&e&l3" with subtitle "&7GET READY" to all players

            play sound "block.note_block.pling" with volume 1 and pitch 1 to all players

            wait 1 second


            if {orerace.game-id} is not {_gameid}:

                stop

            if {orerace.state} is not "COUNTDOWN":

                stop


            send title "&e&l2" with subtitle "&7GET READY" to all players

            play sound "block.note_block.pling" with volume 1 and pitch 1 to all players

            wait 1 second


            if {orerace.game-id} is not {_gameid}:

                stop

            if {orerace.state} is not "COUNTDOWN":

                stop


            send title "&e&l1" with subtitle "&7GET READY" to all players

            play sound "block.note_block.pling" with volume 1 and pitch 1 to all players

            wait 1 second


            if {orerace.game-id} is not {_gameid}:

                stop

            if {orerace.state} is not "COUNTDOWN":

                stop


            # =================================================
            # START
            # =================================================

            send title "&a&lSTART!" with subtitle "&fOreRace" to all players

            play sound "entity.player.levelup" with volume 1 and pitch 1 to all players


            set {orerace.state} to "RUNNING"

            set {orerace.time} to {orerace.max-time}

            send "" to all players
            send "&8&m----------------------------------------" to all players
            send "&6&lORE RACE START!" to all players
            send "&7Time: &e%{orerace.max-time}% seconds" to all players
            send "&8&m----------------------------------------" to all players

            stop


        # ====================================================
        # STOP
        # ====================================================

        if arg-1 is "stop":

            if {orerace.state} is "IDLE":

                send "{@prefix} &cOreRace is not running." to player
                stop


            if {orerace.state} is "FINISHED":

                send "{@prefix} &cOreRace is already finished." to player
                stop


            if {orerace.game-id} is not set:

                set {orerace.game-id} to 0

            add 1 to {orerace.game-id}


            set {orerace.state} to "FINISHED"


            # ------------------------------------------------
            # BOSSBAR
            # ------------------------------------------------

            set {_bar} to boss bar from key "{@bossbar-id}"

            if {_bar} is set:

                loop all players:

                    remove loop-player from viewers of {_bar}


            # ------------------------------------------------
            # SCOREBOARD
            # ------------------------------------------------

            execute console command "scoreboard objectives remove orePoints"


            # ------------------------------------------------
            # MESSAGE
            # ------------------------------------------------

            send title "&c&lSTOP!" with subtitle "&7OreRace stopped." to all players

            play sound "block.anvil.land" with volume 1 and pitch 1 to all players

            send "" to all players
            send "&8&m----------------------------------------" to all players
            send "&c&lORE RACE STOPPED" to all players
            send "&8&m----------------------------------------" to all players


            wait 2 seconds


            # ------------------------------------------------
            # RETURN
            # ------------------------------------------------

            loop all players:

                if {orerace.players::%uuid of loop-player%} is set:

                    teleport loop-player to location at {orerace.start.x}, {orerace.start.y}, {orerace.start.z} in world {orerace.start.world}


            stop


        # ====================================================
        # RESET
        # ====================================================

        if arg-1 is "reset":

            if {orerace.game-id} is not set:

                set {orerace.game-id} to 0

            add 1 to {orerace.game-id}


            set {orerace.state} to "IDLE"


            # ------------------------------------------------
            # BOSSBAR
            # ------------------------------------------------

            set {_bar} to boss bar from key "{@bossbar-id}"

            if {_bar} is set:

                loop all players:

                    remove loop-player from viewers of {_bar}


            # ------------------------------------------------
            # SCOREBOARD
            # ------------------------------------------------

            execute console command "scoreboard objectives remove orePoints"


            # ------------------------------------------------
            # DATA
            # ------------------------------------------------

            delete {orerace.start.x}
            delete {orerace.start.y}
            delete {orerace.start.z}
            delete {orerace.start.world}

            delete {orerace.max-time}
            delete {orerace.time}

            delete {orerace.points::*}
            delete {orerace.count::*}
            delete {orerace.orecount::*}
            delete {orerace.players::*}
            delete {orerace.playername::*}


            send "{@prefix} &eReset complete." to player

            stop


        # ====================================================
        # RESULT
        # ====================================================

        if arg-1 is "result":

            execute player command "/ore_result"

            stop


        # ====================================================
        # STATUS
        # ====================================================

        if arg-1 is "status":

            execute player command "/ore_status"

            stop


        # ====================================================
        # DEBUG
        # ====================================================

        if arg-1 is "debug":

            if {orerace.debug} is true:

                set {orerace.debug} to false

                send "{@prefix} &7DEBUG: &cOFF" to player

            else:

                set {orerace.debug} to true

                send "{@prefix} &7DEBUG: &aON" to player

            stop


        # ====================================================
        # HELP
        # ====================================================

        send "" to player
        send "&8&m----------------------------------------" to player
        send "&6&lOreRace" to player
        send "" to player
        send "&f/ore &7- Open GUI" to player
        send "&f/ore set &7- Set start position" to player
        send "&f/ore time 5 &7- 5 minutes" to player
        send "&f/ore time 15 &7- 15 minutes" to player
        send "&f/ore time 30 &7- 30 minutes" to player
        send "&f/ore time 60 &7- 60 minutes" to player
        send "&f/ore start &7- Start" to player
        send "&f/ore stop &7- Stop" to player
        send "&f/ore reset &7- Reset" to player
        send "&f/ore result &7- Result" to player
        send "&f/ore status &7- Status" to player
        send "&f/ore debug &7- Debug" to player
        send "&8&m----------------------------------------" to player


# ============================================================
# GUI CLICK
# ============================================================

on inventory click:

    if name of event-inventory is not "{@gui-name}":

        stop

    cancel event


    if clicked inventory is not event-inventory:

        stop


    # ========================================================
    # 5 MIN
    # ========================================================

    if clicked slot is 11:

        make player execute command "/ore time 5"

        wait 1 tick

        make player execute command "/ore"

        stop


    # ========================================================
    # 15 MIN
    # ========================================================

    if clicked slot is 12:

        make player execute command "/ore time 15"

        wait 1 tick

        make player execute command "/ore"

        stop


    # ========================================================
    # 30 MIN
    # ========================================================

    if clicked slot is 13:

        make player execute command "/ore time 30"

        wait 1 tick

        make player execute command "/ore"

        stop


    # ========================================================
    # 60 MIN
    # ========================================================

    if clicked slot is 14:

        make player execute command "/ore time 60"

        wait 1 tick

        make player execute command "/ore"

        stop


    # ========================================================
    # SET
    # ========================================================

    if clicked slot is 15:

        close player's inventory

        make player execute command "/ore set"

        stop


    # ========================================================
    # START
    # ========================================================

    if clicked slot is 16:

        close player's inventory

        make player execute command "/ore start"

        stop


    # ========================================================
    # STOP
    # ========================================================

    if clicked slot is 19:

        close player's inventory

        make player execute command "/ore stop"

        stop


    # ========================================================
    # RESET
    # ========================================================

    if clicked slot is 21:

        close player's inventory

        make player execute command "/ore reset"

        stop


    # ========================================================
    # RESULT
    # ========================================================

    if clicked slot is 23:

        close player's inventory

        make player execute command "/ore result"

        stop


    # ========================================================
    # STATUS
    # ========================================================

    if clicked slot is 25:

        close player's inventory

        make player execute command "/ore status"

        stop


# ============================================================
# GUI DRAG
# ============================================================

on inventory drag:

    if name of event-inventory is not "{@gui-name}":

        stop

    cancel event


# ============================================================
# TIMER
# ============================================================

every 1 second:

    if {orerace.state} is not "RUNNING":

        stop


    if {orerace.time} is not set:

        stop


    # ========================================================
    # NORMAL TIMER
    # ========================================================

    remove 1 from {orerace.time}


    # ========================================================
    # NORMAL TIME
    #
    # 00:06 → 00:05
    #
    # 00:05になったら終了カウントダウンへ
    # ========================================================

    if {orerace.time} > 5:

        set {_minutes} to floor({orerace.time} / 60)

        set {_seconds} to {orerace.time} - ({_minutes} * 60)


        if {_minutes} < 10:

            set {_minute-text} to "0%{_minutes}%"

        else:

            set {_minute-text} to "%{_minutes}%"


        if {_seconds} < 10:

            set {_second-text} to "0%{_seconds}%"

        else:

            set {_second-text} to "%{_seconds}%"


        set {_time-text} to "%{_minute-text}%:%{_second-text}%"


        # ----------------------------------------------------
        # BOSSBAR
        # ----------------------------------------------------

        set {_bar} to boss bar from key "{@bossbar-id}"


        if {_bar} is set:

            set title of {_bar} to "&6&lORE RACE &f%{_time-text}%"

            set {_progress} to {orerace.time} / {orerace.max-time}

            if {_progress} > 1:

                set {_progress} to 1

            if {_progress} < 0:

                set {_progress} to 0

            set progress of {_bar} to {_progress}


        stop


    # ========================================================
    # 00:05
    #
    # END COUNTDOWN
    # ========================================================

    if {orerace.time} is 5:

        set {orerace.state} to "ENDING"

        set {orerace.end-countdown} to 5

        set {orerace.time} to 5

        set {_gameid} to {orerace.game-id}


        # ----------------------------------------------------
        # 5
        # ----------------------------------------------------

        send title "&c&l5" with subtitle "&7TIME UP" to all players

        play sound "block.note_block.pling" with volume 1 and pitch 1 to all players


        # ----------------------------------------------------
        # BOSSBAR 00:05
        # ----------------------------------------------------

        set {_bar} to boss bar from key "{@bossbar-id}"

        if {_bar} is set:

            set title of {_bar} to "&c&lORE RACE &f00:05"

            set progress of {_bar} to 5 / {orerace.max-time}


        # ----------------------------------------------------
        # 4
        # ----------------------------------------------------

        wait 1 second


        if {orerace.game-id} is not {_gameid}:

            stop

        if {orerace.state} is not "ENDING":

            stop


        set {orerace.end-countdown} to 4
        set {orerace.time} to 4


        send title "&c&l4" with subtitle "&7TIME UP" to all players

        play sound "block.note_block.pling" with volume 1 and pitch 1 to all players


        set {_bar} to boss bar from key "{@bossbar-id}"

        if {_bar} is set:

            set title of {_bar} to "&c&lORE RACE &f00:04"

            set progress of {_bar} to 4 / {orerace.max-time}


        # ----------------------------------------------------
        # 3
        # ----------------------------------------------------

        wait 1 second


        if {orerace.game-id} is not {_gameid}:

            stop

        if {orerace.state} is not "ENDING":

            stop


        set {orerace.end-countdown} to 3
        set {orerace.time} to 3


        send title "&c&l3" with subtitle "&7TIME UP" to all players

        play sound "block.note_block.pling" with volume 1 and pitch 1 to all players


        set {_bar} to boss bar from key "{@bossbar-id}"

        if {_bar} is set:

            set title of {_bar} to "&c&lORE RACE &f00:03"

            set progress of {_bar} to 3 / {orerace.max-time}


        # ----------------------------------------------------
        # 2
        # ----------------------------------------------------

        wait 1 second


        if {orerace.game-id} is not {_gameid}:

            stop

        if {orerace.state} is not "ENDING":

            stop


        set {orerace.end-countdown} to 2
        set {orerace.time} to 2


        send title "&c&l2" with subtitle "&7TIME UP" to all players

        play sound "block.note_block.pling" with volume 1 and pitch 1 to all players


        set {_bar} to boss bar from key "{@bossbar-id}"

        if {_bar} is set:

            set title of {_bar} to "&c&lORE RACE &f00:02"

            set progress of {_bar} to 2 / {orerace.max-time}


        # ----------------------------------------------------
        # 1
        # ----------------------------------------------------

        wait 1 second


        if {orerace.game-id} is not {_gameid}:

            stop

        if {orerace.state} is not "ENDING":

            stop


        set {orerace.end-countdown} to 1
        set {orerace.time} to 1


        send title "&c&l1" with subtitle "&7TIME UP" to all players

        play sound "block.note_block.pling" with volume 1 and pitch 1 to all players


        set {_bar} to boss bar from key "{@bossbar-id}"

        if {_bar} is set:

            set title of {_bar} to "&c&lORE RACE &f00:01"

            set progress of {_bar} to 1 / {orerace.max-time}


        # ----------------------------------------------------
        # TIME UP
        # ----------------------------------------------------

        wait 1 second


        if {orerace.game-id} is not {_gameid}:

            stop

        if {orerace.state} is not "ENDING":

            stop


        set {orerace.time} to 0

        set {orerace.state} to "FINISHED"


        # ----------------------------------------------------
        # BOSSBAR 00:00
        # ----------------------------------------------------

        set {_bar} to boss bar from key "{@bossbar-id}"

        if {_bar} is set:

            set title of {_bar} to "&c&lORE RACE &f00:00"

            set progress of {_bar} to 0%


        # ----------------------------------------------------
        # FINISH
        # ----------------------------------------------------

        send title "&c&lFINISH!" to all players

        play sound "block.anvil.land" with volume 1 and pitch 1 to all players


        # ----------------------------------------------------
        # FINAL MESSAGE
        # ----------------------------------------------------

        send "" to all players
        send "&6&l========================================" to all players
        send "&c&l              Time Up!" to all players
        send "&e&l           Final Results" to all players
        send "&6&l========================================" to all players
        send "" to all players


        # ----------------------------------------------------
        # FINAL SCORE
        # ----------------------------------------------------

        loop all players:

            set {_uuid} to uuid of loop-player

            if {orerace.players::%{_uuid}%} is set:

                set {_points} to {orerace.points::%{_uuid}%}

                if {_points} is not set:

                    set {_points} to 0

                execute console command "scoreboard players set %loop-player% orePoints %{_points}%"


        # ----------------------------------------------------
        # RESULT
        # ----------------------------------------------------

        execute console command "oreresult_internal"


        # ----------------------------------------------------
        # WAIT
        # ----------------------------------------------------

        wait 3 seconds


        # ----------------------------------------------------
        # RETURN TO START
        # ----------------------------------------------------

        loop all players:

            if {orerace.players::%uuid of loop-player%} is set:

                teleport loop-player to location at {orerace.start.x}, {orerace.start.y}, {orerace.start.z} in world {orerace.start.world}


        # ----------------------------------------------------
        # REMOVE BOSSBAR
        # ----------------------------------------------------

        set {_bar} to boss bar from key "{@bossbar-id}"

        if {_bar} is set:

            loop all players:

                remove loop-player from viewers of {_bar}


        # ----------------------------------------------------
        # REMOVE SCOREBOARD
        # ----------------------------------------------------

        wait 2 seconds

        execute console command "scoreboard objectives remove orePoints"

        stop


# ============================================================
# RESULT
# ============================================================

command /ore_result:
    permission: op
    trigger:

        execute console command "oreresult_internal"


# ============================================================
# INTERNAL RESULT
# ============================================================

command /oreresult_internal:
    permission: op
    trigger:

        send "&8&m----------------------------------------" to all players
        send "&6&lORE RACE RESULT" to all players
        send "&8&m----------------------------------------" to all players


        if {orerace.players::*} is not set:

            send "&7No players." to all players
            send "&8&m----------------------------------------" to all players

            stop


        # ----------------------------------------------------
        # TEMP LIST
        # ----------------------------------------------------

        delete {_remaining::*}


        loop {orerace.players::*}:

            set {_uuid} to loop-index

            add {_uuid} to {_remaining::*}


        # ----------------------------------------------------
        # TOP 10
        # ----------------------------------------------------

        set {_rank} to 1


        while {_rank} <= 10:

            if size of {_remaining::*} <= 0:

                stop


            set {_best-uuid} to ""

            set {_best-points} to -1

            set {_best-count} to -1


            # ------------------------------------------------
            # FIND BEST
            # ------------------------------------------------

            loop {_remaining::*}:

                set {_uuid} to loop-value

                set {_points} to {orerace.points::%{_uuid}%}

                set {_count} to {orerace.count::%{_uuid}%}


                if {_points} is not set:

                    set {_points} to 0


                if {_count} is not set:

                    set {_count} to 0


                if {_points} > {_best-points}:

                    set {_best-uuid} to {_uuid}

                    set {_best-points} to {_points}

                    set {_best-count} to {_count}


                else if {_points} is {_best-points}:

                    if {_count} > {_best-count}:

                        set {_best-uuid} to {_uuid}

                        set {_best-points} to {_points}

                        set {_best-count} to {_count}


            # ------------------------------------------------
            # NO RESULT
            # ------------------------------------------------

            if {_best-uuid} is "":

                stop


            # ------------------------------------------------
            # NAME
            # ------------------------------------------------

            set {_name} to {orerace.playername::%{_best-uuid}%}


            if {_name} is not set:

                set {_name} to "Unknown"


            # ------------------------------------------------
            # RANK COLOR
            # ------------------------------------------------

            if {_rank} is 1:

                set {_rank-color} to "&6&l"

            else if {_rank} is 2:

                set {_rank-color} to "&f&l"

            else if {_rank} is 3:

                set {_rank-color} to "&c&l"

            else:

                set {_rank-color} to "&7"


            # ------------------------------------------------
            # RESULT
            # ------------------------------------------------

            send "%{_rank-color}%%{_rank}%. &f%{_name}% &7- &e%{_best-points}% pt &7(%{_best-count}% ores)" to all players


            # ------------------------------------------------
            # REMOVE
            # ------------------------------------------------

            remove {_best-uuid} from {_remaining::*}

            add 1 to {_rank}


        send "&8&m----------------------------------------" to all players

        stop


# ============================================================
# STATUS
# ============================================================

command /ore_status:
    permission: op
    trigger:

        send "" to player
        send "&8&m----------------------------------------" to player
        send "&6&lORE RACE STATUS" to player
        send "&8&m----------------------------------------" to player


        if {orerace.state} is "RUNNING":

            send "&7State: &aRUNNING" to player

        else if {orerace.state} is "COUNTDOWN":

            send "&7State: &eCOUNTDOWN" to player

        else if {orerace.state} is "ENDING":

            send "&7State: &cENDING" to player

        else if {orerace.state} is "FINISHED":

            send "&7State: &6FINISHED" to player

        else:

            send "&7State: &cIDLE" to player


        if {orerace.max-time} is set:

            send "&7Game Time: &e%{orerace.max-time}% seconds" to player


        if {orerace.time} is set:

            send "&7Remaining: &e%{orerace.time}% seconds" to player


        if {orerace.start.x} is set:

            send "" to player
            send "&7Start X: &f%{orerace.start.x}%" to player
            send "&7Start Y: &f%{orerace.start.y}%" to player
            send "&7Start Z: &f%{orerace.start.z}%" to player
            send "&7World: &f%{orerace.start.world}%" to player


        send "" to player


        if {orerace.players::*} is set:

            loop {orerace.players::*}:

                set {_uuid} to loop-index

                set {_name} to {orerace.playername::%{_uuid}%}

                set {_points} to {orerace.points::%{_uuid}%}

                set {_count} to {orerace.count::%{_uuid}%}


                if {_points} is not set:

                    set {_points} to 0


                if {_count} is not set:

                    set {_count} to 0


                send "&f%{_name}% &7: &e%{_points}% pt &7(%{_count}% ores)" to player


        send "&8&m----------------------------------------" to player

        stop


# ============================================================
# BLOCK BREAK
# ============================================================

on break:

    if {orerace.state} is not "RUNNING":

        stop


    set {_player} to player

    set {_uuid} to uuid of {_player}

    set {_block} to event-block


    # ========================================================
    # NORMAL ORES
    # ========================================================

    if {_block} is coal ore:

        set {_ore} to "COAL_ORE"
        set {_point} to 1


    else if {_block} is copper ore:

        set {_ore} to "COPPER_ORE"
        set {_point} to 1


    else if {_block} is iron ore:

        set {_ore} to "IRON_ORE"
        set {_point} to 2


    else if {_block} is gold ore:

        set {_ore} to "GOLD_ORE"
        set {_point} to 2


    else if {_block} is redstone ore:

        set {_ore} to "REDSTONE_ORE"
        set {_point} to 3


    else if {_block} is lapis ore:

        set {_ore} to "LAPIS_ORE"
        set {_point} to 3


    else if {_block} is emerald ore:

        set {_ore} to "EMERALD_ORE"
        set {_point} to 4


    else if {_block} is diamond ore:

        set {_ore} to "DIAMOND_ORE"
        set {_point} to 5


    # ========================================================
    # DEEPSLATE ORES
    # ========================================================

    else if {_block} is deepslate coal ore:

        set {_ore} to "DEEPSLATE_COAL_ORE"
        set {_point} to 1


    else if {_block} is deepslate copper ore:

        set {_ore} to "DEEPSLATE_COPPER_ORE"
        set {_point} to 1


    else if {_block} is deepslate iron ore:

        set {_ore} to "DEEPSLATE_IRON_ORE"
        set {_point} to 2


    else if {_block} is deepslate gold ore:

        set {_ore} to "DEEPSLATE_GOLD_ORE"
        set {_point} to 2


    else if {_block} is deepslate redstone ore:

        set {_ore} to "DEEPSLATE_REDSTONE_ORE"
        set {_point} to 3


    else if {_block} is deepslate lapis ore:

        set {_ore} to "DEEPSLATE_LAPIS_ORE"
        set {_point} to 3


    else if {_block} is deepslate emerald ore:

        set {_ore} to "DEEPSLATE_EMERALD_ORE"
        set {_point} to 4


    else if {_block} is deepslate diamond ore:

        set {_ore} to "DEEPSLATE_DIAMOND_ORE"
        set {_point} to 5


    else:

        stop


    # ========================================================
    # PLAYER REGISTRATION
    # ========================================================

    if {orerace.players::%{_uuid}%} is not set:

        set {orerace.players::%{_uuid}%} to true

        set {orerace.playername::%{_uuid}%} to name of {_player}

        set {orerace.points::%{_uuid}%} to 0

        set {orerace.count::%{_uuid}%} to 0


    # ========================================================
    # POINT
    # ========================================================

    add {_point} to {orerace.points::%{_uuid}%}


    # ========================================================
    # TOTAL COUNT
    # ========================================================

    add 1 to {orerace.count::%{_uuid}%}


    # ========================================================
    # INDIVIDUAL ORE COUNT
    # ========================================================

    add 1 to {orerace.orecount::%{_uuid}%::%{_ore}%}


    # ========================================================
    # SCOREBOARD
    # ========================================================

    set {_total} to {orerace.points::%{_uuid}%}

    execute console command "scoreboard players set %{_player}% orePoints %{_total}%"


# ============================================================
# ACTIONBAR DEBUG
# ============================================================

every 1 second:

    if {orerace.debug} is not true:

        stop


    if {orerace.state} is not "RUNNING":

        stop


    loop all players:

        set {_uuid} to uuid of loop-player


        if {orerace.players::%{_uuid}%} is not set:

            stop


        set {_points} to {orerace.points::%{_uuid}%}

        set {_count} to {orerace.count::%{_uuid}%}


        if {_points} is not set:

            set {_points} to 0


        if {_count} is not set:

            set {_count} to 0


        set {_x} to x-coordinate of loop-player

        set {_y} to y-coordinate of loop-player

        set {_z} to z-coordinate of loop-player


        send action bar "&6OreRace &7| &e%{_points}% pt &7| &b%{_count}% ores &7| &fX:%{_x}% Y:%{_y}% Z:%{_z}%" to loop-player


# ============================================================
# PLAYER JOIN
# ============================================================

on join:

    if {orerace.state} is "RUNNING":

        set {_uuid} to uuid of player

        if {orerace.players::%{_uuid}%} is not set:

            set {orerace.players::%{_uuid}%} to true

            set {orerace.playername::%{_uuid}%} to name of player

            set {orerace.points::%{_uuid}%} to 0

            set {orerace.count::%{_uuid}%} to 0

            execute console command "scoreboard players set %player% orePoints 0"


# ============================================================
# SCRIPT LOAD
# ============================================================

on script load:

    if {orerace.state} is not set:

        set {orerace.state} to "IDLE"


    if {orerace.max-time} is not set:

        set {orerace.max-time} to 900


    # --------------------------------------------------------
    # OLD BOSSBAR
    # --------------------------------------------------------

    set {_bar} to boss bar from key "{@bossbar-id}"

    if {_bar} is set:

        loop all players:

            remove loop-player from viewers of {_bar}


    # --------------------------------------------------------
    # OLD SCOREBOARD
    # --------------------------------------------------------

    execute console command "scoreboard objectives remove orePoints"
