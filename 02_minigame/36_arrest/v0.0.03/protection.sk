# ============================================================
# ARREST GAME
# File : protection.sk
# Version : v0.0.05
#
# 収監中プレイヤー保護
#
# 収監中のみ：
# ・完全無敵
# ・満腹度の増減なし
# ・耐性 V
# ・水中呼吸
# ・火炎耐性
# ・ポーションアイコン非表示
# ・ポーションパーティクル非表示
# ============================================================


# ============================================================
# 無敵
# ============================================================

on damage of player:

    if {arrest::player::%uuid of victim%::jail} is not set:
        stop

    cancel event


# ============================================================
# 満腹度の増減禁止
# ============================================================

on food level change:

    if {arrest::player::%uuid of player%::jail} is not set:
        stop

    cancel event


# ============================================================
# 収監中の状態維持
# ============================================================

every 1 second:

    loop all players:

        set {_p} to loop-player

        # 収監中ではない
        if {arrest::player::%uuid of {_p}%::jail} is not set:
            continue


        # ====================================================
        # 耐性 V
        # ====================================================

        apply resistance 5 to {_p} for 2 seconds:
            hide the particles
            hide the icon


        # ====================================================
        # 水中呼吸
        # ====================================================

        apply water breathing 1 to {_p} for 2 seconds:
            hide the particles
            hide the icon


        # ====================================================
        # 火炎耐性
        # ====================================================

        apply fire resistance 1 to {_p} for 2 seconds:
            hide the particles
            hide the icon
