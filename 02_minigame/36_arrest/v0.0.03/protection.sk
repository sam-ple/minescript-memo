# ============================================================
# ARREST GAME
# File : protection.sk
# Version : v0.0.02
#
# 収監中プレイヤー保護
#
# 収監中のみ：
# ・完全無敵
# ・耐性 V
# ・水中呼吸
# ・火炎耐性
# ・満腹度の増減なし
# ・犯罪判定は各crime側で収監中を除外
#
# ============================================================


# ============================================================
# 無敵
# ============================================================

on damage of player:

    # 収監中ではない
    if {arrest::player::%uuid of victim%::jail} is not set:
        stop

    # ダメージを完全キャンセル
    cancel event


# ============================================================
# 満腹度の増減禁止
# ============================================================

on food level change:

    # 収監中ではない
    if {arrest::player::%uuid of player%::jail} is not set:
        stop

    # 満腹度変更をキャンセル
    cancel event


# ============================================================
# 収監中の状態維持
# ============================================================

every 1 second:

    loop all players:

        set {_p} to loop-player

        # 収監中だけ処理
        if {arrest::player::%uuid of {_p}%::jail} is set:

            # 耐性 V
            apply resistance 5 to {_p} for 2 seconds

            # 水中呼吸
            apply water breathing to {_p} for 2 seconds

            # 火炎耐性
            apply fire resistance to {_p} for 2 seconds
