# ============================================================
# ARREST GAME
# File : crime/flower.sk
# Version : v0.0.03
#
# 犯罪：花踏み罪
#
# プレイヤーが花の上に「足を乗せた」場合に逮捕
#
# 方式：
# ・tick監視は使用しない
# ・プレイヤーが移動した瞬間に足元のブロックを確認
# ・足元が対象の花なら逮捕
#
# 収監：30秒
# 保釈：銅インゴット × 3
# ============================================================


# ============================================================
# 花踏み判定
# ============================================================

on player move:

    # ========================================================
    # ARREST GAMEが無効
    # ========================================================

    if {arrest::enabled} is not true:
        stop


    # ========================================================
    # 対象ワールド以外
    # ========================================================

    if world of player is not {arrest::world}:
        stop


    # ========================================================
    # すでに収監中
    # ========================================================

    if {arrest::player::%uuid of player%::jail} is set:
        stop


    # ========================================================
    # 移動前と移動後でブロックが変わっていない場合は無視
    #
    # 同じブロック内で視点だけ動かした場合などを除外
    # ========================================================

    set {_from-x} to floor(x-coordinate of event-location)
    set {_from-y} to floor(y-coordinate of event-location)
    set {_from-z} to floor(z-coordinate of event-location)

    set {_to-x} to floor(x-coordinate of player)
    set {_to-y} to floor(y-coordinate of player)
    set {_to-z} to floor(z-coordinate of player)

    if {_from-x} is {_to-x}:
        if {_from-y} is {_to-y}:
            if {_from-z} is {_to-z}:
                stop


    # ========================================================
    # プレイヤーの足元のブロックを取得
    #
    # 「block below player」を使用
    # 頭や体の位置ではなく、足元を判定
    # ========================================================

    set {_block} to block below player


    # ========================================================
    # 花判定
    # ========================================================

    if {_block} is not dandelion:
        if {_block} is not poppy:
            if {_block} is not blue orchid:
                if {_block} is not allium:
                    if {_block} is not azure bluet:
                        if {_block} is not red tulip:
                            if {_block} is not orange tulip:
                                if {_block} is not white tulip:
                                    if {_block} is not pink tulip:
                                        if {_block} is not oxeye daisy:
                                            if {_block} is not cornflower:
                                                if {_block} is not lily of the valley:
                                                    if {_block} is not wither rose:
                                                        if {_block} is not sunflower:
                                                            if {_block} is not lilac:
                                                                if {_block} is not rose bush:
                                                                    if {_block} is not peony:
                                                                        if {_block} is not torchflower:
                                                                            if {_block} is not wildflowers:
                                                                                stop


    # ========================================================
    # 罪状
    # ========================================================

    set {_reason} to "花踏み罪"


    # ========================================================
    # 逮捕
    # ========================================================

    arrest_create_jail(player, {_reason}, 30, copper ingot, 3, "銅インゴット")
