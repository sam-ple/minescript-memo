# ============================================================
# ARREST GAME
# File : crime/flower.sk
#
# 犯罪：花踏み罪
#
# プレイヤーが花を足で踏んだ場合に逮捕
#
# 収監：30秒
# 保釈：銅インゴット × 3
# ============================================================


# ============================================================
# 花を踏んでいるかチェック
# ============================================================

every 1 tick:

    loop all players:

        set {_p} to loop-player

        # ----------------------------------------------------
        # ARREST GAME OFF
        # ----------------------------------------------------

        if {arrest::enabled} is not true:
            stop loop

        # ----------------------------------------------------
        # 対象ワールド以外
        # ----------------------------------------------------

        if world of {_p} is not {arrest::world}:
            stop loop

        # ----------------------------------------------------
        # すでに収監中
        # ----------------------------------------------------

        if {arrest::player::%uuid of {_p}%::jail} is set:
            stop loop

        # ----------------------------------------------------
        # 足元のブロック
        # ----------------------------------------------------

        set {_block} to block below {_p}

        # ----------------------------------------------------
        # 花判定
        # ----------------------------------------------------

        if {_block} is dandelion or poppy or blue orchid or allium or azure bluet or red tulip or orange tulip or white tulip or pink tulip or oxeye daisy or cornflower or lily of the valley or wither rose or sunflower or lilac or rose bush or peony or torchflower or wildflowers:

            # ------------------------------------------------
            # 犯罪発生
            # ------------------------------------------------

            set {_reason} to "花踏み罪"

            # ------------------------------------------------
            # 逮捕
            #
            # 30秒
            # 銅インゴット × 3
            # ------------------------------------------------

            arrest_create_jail({_p}, {_reason}, 30, copper ingot, 3, "銅インゴット")
