# ============================================================
# ARREST GAME
# File : arrest_game.sk
# Version : v0.2.08
#
# 草刈り → 逮捕 → 牢屋 → 収監 → 石の足場
#
# ============================================================
#
# 牢屋
# ・土台 5 x 5
# ・高さ 5
# ・土台：reinforced_deepslate
# ・壁：iron_bars
# ・天井：reinforced_deepslate
# ・内部：air
#
# 座標
# ・プレイヤーが立っているブロック = プレイヤーの1ブロック下
# ・牢屋の土台 = プレイヤーの1ブロック下
# ・プレイヤー = 土台 + 1
# ・鉄格子 = プレイヤー位置 ～ +2
# ・天井 = プレイヤー位置 +3
#
# 看板
# ・牢屋の四方向
# ・各方向の中央
# ・牢屋の外側
# ・右クリック処理なし
# ・表／裏とも同じ内容
#
# 看板表示
# ・2行目：保釈金
# ・3行目：鉄インゴット × 5
#
# 釈放後
# ・牢屋をすべて撤去
# ・5 x 5 の石ブロックだけ残す
#
# BossBar
# ・style：progress
# ・30秒 → 0秒
#
# ============================================================


options:
    jail-time: 30


# ============================================================
# TEST ON / OFF
# ============================================================

command /arresttest [<text>]:
    permission: op
    trigger:

        # ====================================================
        # ON
        # ====================================================

        if arg-1 is "on":

            # ------------------------------------------------
            # BossBar
            # ------------------------------------------------

            execute player command "bossbar remove arrest:jail"


            # ------------------------------------------------
            # 前回の牢屋が残っている場合
            # 現在のワールド内の場合のみ削除
            # ------------------------------------------------

            if {arrest.jail.x1} is set:

                if {arrest.jail.world} is world of player:

                    set {_old-x1} to {arrest.jail.x1}
                    set {_old-y1} to {arrest.jail.y1}
                    set {_old-z1} to {arrest.jail.z1}

                    set {_old-x2} to {arrest.jail.x2}
                    set {_old-y2} to {arrest.jail.y2}
                    set {_old-z2} to {arrest.jail.z2}

                    execute player command "fill %{_old-x1}% %{_old-y1}% %{_old-z1}% %{_old-x2}% %{_old-y2}% %{_old-z2}% air"


            # ------------------------------------------------
            # ARREST GAME関連変数を初期化
            # ------------------------------------------------

            delete {arrest.jailed::*}
            delete {arrest.jail::*}


            # ------------------------------------------------
            # 今いるワールドを対象ワールドとして登録
            # ------------------------------------------------

            set {arresttest.world} to world of player
            set {arresttest.enabled} to true


            send "&a[ARREST TEST] 判定を開始しました。" to player
            send "&7対象ワールド: &f%world of player%" to player

            stop


        # ====================================================
        # OFF
        # ====================================================

        if arg-1 is "off":

            set {arresttest.enabled} to false

            # BossBar削除
            execute player command "bossbar remove arrest:jail"

            send "&c[ARREST TEST] 判定を停止しました。" to player

            stop


        # ====================================================
        # HELP
        # ====================================================

        send "&e/arresttest on &7- 現在のワールドで判定開始＋初期化" to player
        send "&e/arresttest off &7- 判定停止" to player


# ============================================================
# 草刈り → 逮捕
# ============================================================

on break:

    # --------------------------------------------------------
    # テストOFF
    # --------------------------------------------------------

    if {arresttest.enabled} is not true:
        stop


    # --------------------------------------------------------
    # 対象ワールド以外では何もしない
    # --------------------------------------------------------

    if {arresttest.world} is not set:
        stop

    if world of player is not {arresttest.world}:
        stop


    # --------------------------------------------------------
    # すでに収監中なら何もしない
    # --------------------------------------------------------

    if {arrest.jailed.%player%} is true:
        stop


    # --------------------------------------------------------
    # 草以外は何もしない
    # --------------------------------------------------------

    if event-block is not short grass:
        if event-block is not tall grass:
            stop


    # ========================================================
    # 逮捕
    # ========================================================

    set {arrest.jailed.%player%} to true


    # --------------------------------------------------------
    # 逮捕情報
    # --------------------------------------------------------

    set {arrest.jail.player} to player
    set {arrest.jail.reason} to "環境破壊罪"


    # ========================================================
    # タイトル
    # ========================================================

    send title "&c環境破壊罪" with subtitle "&f%player%" to player


    # ========================================================
    # チャット
    # ========================================================

    broadcast "&c%player%が環境破壊罪で捕まりました。"


    # ========================================================
    # プレイヤー位置
    # ========================================================

    set {_x} to floor(x-coordinate of player)
    set {_playerY} to floor(y-coordinate of player)
    set {_z} to floor(z-coordinate of player)


    # ========================================================
    # 牢屋座標
    #
    # プレイヤー = Y
    # 土台 = Y - 1
    # 鉄格子 = Y ～ Y + 2
    # 天井 = Y + 3
    # ========================================================

    set {_x1} to {_x} - 2
    set {_x2} to {_x} + 2

    set {_floor} to {_playerY} - 1
    set {_wall-top} to {_playerY} + 2
    set {_ceiling} to {_playerY} + 3

    set {_z1} to {_z} - 2
    set {_z2} to {_z} + 2


    # ========================================================
    # 牢屋情報保存
    # ========================================================

    set {arrest.jail.world} to world of player

    set {arrest.jail.x1} to {_x1}
    set {arrest.jail.y1} to {_floor}
    set {arrest.jail.z1} to {_z1}

    set {arrest.jail.x2} to {_x2}
    set {arrest.jail.y2} to {_ceiling}
    set {arrest.jail.z2} to {_z2}

    set {arrest.jail.time} to {@jail-time}


    # ========================================================
    # 牢屋内部を空気にする
    # ========================================================

    execute player command "fill %{_x1}% %{_playerY}% %{_z1}% %{_x2}% %{_wall-top}% %{_z2}% air"


    # ========================================================
    # 牢屋生成
    # ========================================================

    # --------------------------------------------------------
    # 土台 5 x 5
    # --------------------------------------------------------

    execute player command "fill %{_x1}% %{_floor}% %{_z1}% %{_x2}% %{_floor}% %{_z2}% reinforced_deepslate"


    # --------------------------------------------------------
    # 天井 5 x 5
    # --------------------------------------------------------

    execute player command "fill %{_x1}% %{_ceiling}% %{_z1}% %{_x2}% %{_ceiling}% %{_z2}% reinforced_deepslate"


    # --------------------------------------------------------
    # 北側
    # --------------------------------------------------------

    execute player command "fill %{_x1}% %{_playerY}% %{_z1}% %{_x2}% %{_wall-top}% %{_z1}% iron_bars"


    # --------------------------------------------------------
    # 南側
    # --------------------------------------------------------

    execute player command "fill %{_x1}% %{_playerY}% %{_z2}% %{_x2}% %{_wall-top}% %{_z2}% iron_bars"


    # --------------------------------------------------------
    # 西側
    # --------------------------------------------------------

    execute player command "fill %{_x1}% %{_playerY}% %{_z1}% %{_x1}% %{_wall-top}% %{_z2}% iron_bars"


    # --------------------------------------------------------
    # 東側
    # --------------------------------------------------------

    execute player command "fill %{_x2}% %{_playerY}% %{_z1}% %{_x2}% %{_wall-top}% %{_z2}% iron_bars"


    # ========================================================
    # 看板座標
    # ========================================================

    # --------------------------------------------------------
    # 北
    # --------------------------------------------------------

    set {_north-sign-x} to {_x}
    set {_north-sign-y} to {_floor}
    set {_north-sign-z} to {_z1} - 1


    # --------------------------------------------------------
    # 南
    # --------------------------------------------------------

    set {_south-sign-x} to {_x}
    set {_south-sign-y} to {_floor}
    set {_south-sign-z} to {_z2} + 1


    # --------------------------------------------------------
    # 西
    # --------------------------------------------------------

    set {_west-sign-x} to {_x1} - 1
    set {_west-sign-y} to {_floor}
    set {_west-sign-z} to {_z}


    # --------------------------------------------------------
    # 東
    # --------------------------------------------------------

    set {_east-sign-x} to {_x2} + 1
    set {_east-sign-y} to {_floor}
    set {_east-sign-z} to {_z}


    # ========================================================
    # 看板設置
    # ========================================================

    # --------------------------------------------------------
    # 北
    # --------------------------------------------------------

    execute player command "setblock %{_north-sign-x}% %{_north-sign-y}% %{_north-sign-z}% oak_wall_sign[facing=north]"


    # --------------------------------------------------------
    # 南
    # --------------------------------------------------------

    execute player command "setblock %{_south-sign-x}% %{_south-sign-y}% %{_south-sign-z}% oak_wall_sign[facing=south]"


    # --------------------------------------------------------
    # 西
    # --------------------------------------------------------

    execute player command "setblock %{_west-sign-x}% %{_west-sign-y}% %{_west-sign-z}% oak_wall_sign[facing=west]"


    # --------------------------------------------------------
    # 東
    # --------------------------------------------------------

    execute player command "setblock %{_east-sign-x}% %{_east-sign-y}% %{_east-sign-z}% oak_wall_sign[facing=east]"


    # ========================================================
    # 看板文字
    # ========================================================

    # --------------------------------------------------------
    # 北
    # --------------------------------------------------------

    set line 2 of block at location({_north-sign-x}, {_north-sign-y}, {_north-sign-z}, world of player) to "&e保釈金"
    set line 3 of block at location({_north-sign-x}, {_north-sign-y}, {_north-sign-z}, world of player) to "鉄インゴット × 5"


    # --------------------------------------------------------
    # 南
    # --------------------------------------------------------

    set line 2 of block at location({_south-sign-x}, {_south-sign-y}, {_south-sign-z}, world of player) to "&e保釈金"
    set line 3 of block at location({_south-sign-x}, {_south-sign-y}, {_south-sign-z}, world of player) to "鉄インゴット × 5"


    # --------------------------------------------------------
    # 西
    # --------------------------------------------------------

    set line 2 of block at location({_west-sign-x}, {_west-sign-y}, {_west-sign-z}, world of player) to "&e保釈金"
    set line 3 of block at location({_west-sign-x}, {_west-sign-y}, {_west-sign-z}, world of player) to "鉄インゴット × 5"


    # --------------------------------------------------------
    # 東
    # --------------------------------------------------------

    set line 2 of block at location({_east-sign-x}, {_east-sign-y}, {_east-sign-z}, world of player) to "&e保釈金"
    set line 3 of block at location({_east-sign-x}, {_east-sign-y}, {_east-sign-z}, world of player) to "鉄インゴット × 5"


    # ========================================================
    # BossBar
    # ========================================================

    # 新規作成
    execute player command "bossbar add arrest:jail {""text"":""収監中"",""color"":""red""}"


    # 表示対象
    execute player command "bossbar set arrest:jail players @s"


    # 最大値
    execute player command "bossbar set arrest:jail max {@jail-time}"


    # 初期値
    execute player command "bossbar set arrest:jail value {@jail-time}"


    # 色
    execute player command "bossbar set arrest:jail color red"


    # シンプルな進行バー
    execute player command "bossbar set arrest:jail style progress"


    # ========================================================
    # 収監時間
    # ========================================================

    set {_remaining} to {@jail-time}

    while {_remaining} > 0:

        wait 1 second

        subtract 1 from {_remaining}

        execute player command "bossbar set arrest:jail value %{_remaining}%"


    # ========================================================
    # 牢屋解除
    # ========================================================

    # --------------------------------------------------------
    # 牢屋全体を空気にする
    # --------------------------------------------------------

    execute player command "fill %{_x1}% %{_floor}% %{_z1}% %{_x2}% %{_ceiling}% %{_z2}% air"


    # ========================================================
    # 釈放後の足場
    # 5 x 5 の石ブロック
    # ========================================================

    execute player command "fill %{_x1}% %{_floor}% %{_z1}% %{_x2}% %{_floor}% %{_z2}% stone"


    # ========================================================
    # BossBar削除
    # ========================================================

    execute player command "bossbar remove arrest:jail"


    # ========================================================
    # 逮捕状態解除
    # ========================================================

    delete {arrest.jailed.%player%}


    # ========================================================
    # 牢屋情報削除
    # ========================================================

    delete {arrest.jail.world}
    delete {arrest.jail.x1}
    delete {arrest.jail.y1}
    delete {arrest.jail.z1}
    delete {arrest.jail.x2}
    delete {arrest.jail.y2}
    delete {arrest.jail.z2}
    delete {arrest.jail.time}
    delete {arrest.jail.player}
    delete {arrest.jail.reason}


    # ========================================================
    # 収監終了メッセージ
    # ========================================================

    broadcast "&a[ARREST GAME] &f%player%の収監期間が終了しました。"


# ============================================================
# ARREST GAMEの牢屋だけ破壊不可
# ============================================================

on break:

    # --------------------------------------------------------
    # 牢屋が存在しない
    # --------------------------------------------------------

    if {arrest.jail.x1} is not set:
        stop


    # --------------------------------------------------------
    # 対象ワールド以外では保護しない
    # --------------------------------------------------------

    if {arrest.jail.world} is not set:
        stop

    if world of player is not {arrest.jail.world}:
        stop


    # --------------------------------------------------------
    # 破壊しようとしているブロックの座標
    # --------------------------------------------------------

    set {_x} to floor(x-coordinate of event-block)
    set {_y} to floor(y-coordinate of event-block)
    set {_z} to floor(z-coordinate of event-block)


    # --------------------------------------------------------
    # 牢屋範囲内だけ破壊禁止
    # --------------------------------------------------------

    if {_x} is between {arrest.jail.x1} and {arrest.jail.x2}:

        if {_y} is between {arrest.jail.y1} and {arrest.jail.y2}:

            if {_z} is between {arrest.jail.z1} and {arrest.jail.z2}:

                cancel event

                send "&c[ARREST GAME] &f牢屋のブロックは破壊できません。" to player
