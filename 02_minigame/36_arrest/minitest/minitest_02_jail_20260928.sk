# ============================================================
# JAIL MINI TEST
# Version : v0.1.04
#
# /jail       自分の足元を中心に牢屋を生成
# /jail off   牢屋を解除
#
# サイズ : 5 x 5
# 高さ   : 5
#
# ※ プレイヤー自身は囲まない
# ※ プレイヤー実行で /fill を行う
# ============================================================


command /jail [<text>]:

    trigger:

        # ====================================================
        # 解除
        # ====================================================

        if arg-1 is "off":

            if {jail.active} is not true:
                send "&7[JAIL] &f牢屋はありません。"
                stop

            # ------------------------------------------------
            # 保存座標
            # ------------------------------------------------

            set {_x1} to {jail.x1}
            set {_y1} to {jail.y1}
            set {_z1} to {jail.z1}

            set {_x2} to {jail.x2}
            set {_y2} to {jail.y2}
            set {_z2} to {jail.z2}

            # ------------------------------------------------
            # 牢屋全体を消去
            # ------------------------------------------------

            execute player command "fill %{_x1}% %{_y1}% %{_z1}% %{_x2}% %{_y2}% %{_z2}% air"

            # ------------------------------------------------
            # データ削除
            # ------------------------------------------------

            delete {jail.active}

            delete {jail.x1}
            delete {jail.y1}
            delete {jail.z1}

            delete {jail.x2}
            delete {jail.y2}
            delete {jail.z2}

            send "&a[JAIL] &f牢屋を解除しました。"
            stop


        # ====================================================
        # すでに牢屋がある
        # ====================================================

        if {jail.active} is true:
            send "&c[JAIL] &fすでに牢屋があります。"
            send "&7[JAIL] &f解除: &e/jail off"
            stop


        # ====================================================
        # プレイヤー座標取得
        # ====================================================

        set {_x} to floor(x-coordinate of player)
        set {_y} to floor(y-coordinate of player)
        set {_z} to floor(z-coordinate of player)


        # ====================================================
        # X方向
        #
        # 5ブロック
        # 中心を含めて -2 ～ +2
        # ====================================================

        set {_x1} to {_x} - 2
        set {_x2} to {_x} + 2


        # ====================================================
        # Y方向
        #
        # 床     : Y - 1
        # 壁     : Y ～ Y + 3
        # 天井   : Y + 4
        #
        # 全体で5ブロック
        # ====================================================

        set {_y1} to {_y} - 1
        set {_y4} to {_y} + 3
        set {_y2} to {_y} + 4


        # ====================================================
        # Z方向
        #
        # 5ブロック
        # ====================================================

        set {_z1} to {_z} - 2
        set {_z2} to {_z} + 2


        # ====================================================
        # 座標保存
        # ====================================================

        set {jail.x1} to {_x1}
        set {jail.y1} to {_y1}
        set {jail.z1} to {_z1}

        set {jail.x2} to {_x2}
        set {jail.y2} to {_y2}
        set {jail.z2} to {_z2}

        set {jail.active} to true


        # ====================================================
        # 床
        # ====================================================

        execute player command "fill %{_x1}% %{_y1}% %{_z1}% %{_x2}% %{_y1}% %{_z2}% stone"


        # ====================================================
        # 天井
        # ====================================================

        execute player command "fill %{_x1}% %{_y2}% %{_z1}% %{_x2}% %{_y2}% %{_z2}% iron_bars"


        # ====================================================
        # 北
        # ====================================================

        execute player command "fill %{_x1}% %{_y}% %{_z1}% %{_x2}% %{_y4}% %{_z1}% iron_bars"


        # ====================================================
        # 南
        # ====================================================

        execute player command "fill %{_x1}% %{_y}% %{_z2}% %{_x2}% %{_y4}% %{_z2}% iron_bars"


        # ====================================================
        # 西
        # ====================================================

        execute player command "fill %{_x1}% %{_y}% %{_z1}% %{_x1}% %{_y4}% %{_z2}% iron_bars"


        # ====================================================
        # 東
        # ====================================================

        execute player command "fill %{_x2}% %{_y}% %{_z1}% %{_x2}% %{_y4}% %{_z2}% iron_bars"


        # ====================================================
        # 完了
        # ====================================================

        send "&a[JAIL] &f牢屋を生成しました。"
        send "&7[JAIL] &fサイズ: 5 x 5 x 5"
        send "&7[JAIL] &f解除: &e/jail off"
