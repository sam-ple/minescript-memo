# ============================================================
# JAIL MINI TEST
# Version : v0.2.00
#
# 牢屋だけを生成するミニテスト
#
# /jail
#   自分の前に牢屋を生成
#
# /jail off
#   牢屋を強制解除
#
# 解除方法
#   四方の看板を右クリック
#   鉄インゴット5個を消費
#
# ============================================================


options:
    jail-size: 5
    jail-height: 5
    unlock-item: iron ingot
    unlock-amount: 5


# ============================================================
# 牢屋生成
# ============================================================

command /jail:

    trigger:

        if {jail.active} is true:
            send "&c[JAIL] &fすでに牢屋があります。"
            stop


        # ----------------------------------------------------
        # プレイヤーの少し前を牢屋の中心にする
        # ----------------------------------------------------

        set {_loc} to location of player

        # プレイヤーの向いている方向を取得
        set {_v} to direction of player

        # 牢屋をプレイヤーから約8ブロック前に配置
        set {_x} to x-coordinate of {_loc} + (x component of {_v} * 8)
        set {_y} to y-coordinate of {_loc}
        set {_z} to z-coordinate of {_loc} + (z component of {_v} * 8)

        set {_center} to location at {_x}, {_y}, {_z} in world of player

        set {jail.center} to {_center}
        set {jail.world} to world of player
        set {jail.active} to true


        # ----------------------------------------------------
        # 床
        # ----------------------------------------------------

        execute console command "fill %{_center}% ~-5 ~-1 ~-5 ~5 ~-1 ~5 stone"


        # ----------------------------------------------------
        # 天井
        # ----------------------------------------------------

        execute console command "fill %{_center}% ~-5 ~5 ~-5 ~5 ~5 ~5 iron_bars"


        # ----------------------------------------------------
        # 北
        # ----------------------------------------------------

        execute console command "fill %{_center}% ~-5 ~0 ~-5 ~5 ~4 ~-5 iron_bars"


        # ----------------------------------------------------
        # 南
        # ----------------------------------------------------

        execute console command "fill %{_center}% ~-5 ~0 ~5 ~5 ~4 ~5 iron_bars"


        # ----------------------------------------------------
        # 西
        # ----------------------------------------------------

        execute console command "fill %{_center}% ~-5 ~0 ~-5 ~-5 ~4 ~5 iron_bars"


        # ----------------------------------------------------
        # 東
        # ----------------------------------------------------

        execute console command "fill %{_center}% ~5 ~0 ~-5 ~5 ~4 ~5 iron_bars"


        # ====================================================
        # 看板4枚
        # ====================================================

        # 北側
        set {_sign1} to location at x-coordinate of {_center}, y-coordinate of {_center} + 1, z-coordinate of {_center} - 5 in world of player
        set block at {_sign1} to oak sign

        # 南側
        set {_sign2} to location at x-coordinate of {_center}, y-coordinate of {_center} + 1, z-coordinate of {_center} + 5 in world of player
        set block at {_sign2} to oak sign

        # 西側
        set {_sign3} to location at x-coordinate of {_center} - 5, y-coordinate of {_center} + 1, z-coordinate of {_center} in world of player
        set block at {_sign3} to oak sign

        # 東側
        set {_sign4} to location at x-coordinate of {_center} + 5, y-coordinate of {_center} + 1, z-coordinate of {_center} in world of player
        set block at {_sign4} to oak sign


        # 看板位置を記録
        set {jail.sign.1} to {_sign1}
        set {jail.sign.2} to {_sign2}
        set {jail.sign.3} to {_sign3}
        set {jail.sign.4} to {_sign4}


        # ----------------------------------------------------
        # 看板に文字
        # ----------------------------------------------------

        set line 1 of block at {_sign1} to "[ JAIL ]"
        set line 2 of block at {_sign1} to "鉄インゴット"
        set line 3 of block at {_sign1} to "5個"
        set line 4 of block at {_sign1} to "右クリック"

        set line 1 of block at {_sign2} to "[ JAIL ]"
        set line 2 of block at {_sign2} to "鉄インゴット"
        set line 3 of block at {_sign2} to "5個"
        set line 4 of block at {_sign2} to "右クリック"

        set line 1 of block at {_sign3} to "[ JAIL ]"
        set line 2 of block at {_sign3} to "鉄インゴット"
        set line 3 of block at {_sign3} to "5個"
        set line 4 of block at {_sign3} to "右クリック"

        set line 1 of block at {_sign4} to "[ JAIL ]"
        set line 2 of block at {_sign4} to "鉄インゴット"
        set line 3 of block at {_sign4} to "5個"
        set line 4 of block at {_sign4} to "右クリック"


        send "&a[JAIL] &f牢屋を生成しました。"
        send "&7四方の看板を鉄インゴット5個で右クリックすると解除できます。"


# ============================================================
# 看板を右クリック
# ============================================================

on right click on sign:

    if {jail.active} is not true:
        stop

    set {_clicked} to location of event-block

    # --------------------------------------------------------
    # 牢屋の4枚の看板か確認
    # --------------------------------------------------------

    if {_clicked} is {jail.sign.1}:
        set {_isjailsign} to true

    if {_clicked} is {jail.sign.2}:
        set {_isjailsign} to true

    if {_clicked} is {jail.sign.3}:
        set {_isjailsign} to true

    if {_clicked} is {jail.sign.4}:
        set {_isjailsign} to true


    if {_isjailsign} is not true:
        stop


    # --------------------------------------------------------
    # 鉄インゴット5個を持っているか
    # --------------------------------------------------------

    if player does not have 5 iron ingots:
        send "&c[JAIL] &f解除には鉄インゴットが5個必要です。"
        stop


    # --------------------------------------------------------
    # 鉄インゴット5個消費
    # --------------------------------------------------------

    remove 5 iron ingots from player's inventory

    send "&a[JAIL] &f鉄インゴット5個を使用しました。"
    send "&a[JAIL] &f牢屋を解除します。"


    # --------------------------------------------------------
    # 牢屋削除
    # --------------------------------------------------------

    execute console command "fill %{jail.center}% ~-5 ~-1 ~-5 ~5 ~5 ~5 air"


    # --------------------------------------------------------
    # 変数削除
    # --------------------------------------------------------

    delete {jail.center}
    delete {jail.world}

    delete {jail.sign.1}
    delete {jail.sign.2}
    delete {jail.sign.3}
    delete {jail.sign.4}

    set {jail.active} to false


    send "&a[JAIL] &f牢屋を解除しました。"


# ============================================================
# 牢屋を壊せないようにする
# ============================================================

on break:

    if {jail.active} is not true:
        stop

    set {_loc} to location of event-block

    # 牢屋範囲内なら破壊禁止
    if {_loc} is within 6 blocks of {jail.center}:
        cancel event
        send "&c[JAIL] &f牢屋は壊せません。"


# ============================================================
# 強制解除
# ============================================================

command /jail off:

    trigger:

        if {jail.active} is not true:
            send "&7[JAIL] &f牢屋はありません。"
            stop

        execute console command "fill %{jail.center}% ~-5 ~-1 ~-5 ~5 ~5 ~5 air"

        delete {jail.center}
        delete {jail.world}

        delete {jail.sign.1}
        delete {jail.sign.2}
        delete {jail.sign.3}
        delete {jail.sign.4}

        set {jail.active} to false

        send "&a[JAIL] &f牢屋を強制解除しました。"