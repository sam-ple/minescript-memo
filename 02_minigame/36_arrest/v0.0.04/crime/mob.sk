# ============================================================
# ARREST GAME
# File : crime/mob.sk
# Version : v0.0.04
#
# 犯罪：なんかかわいそう罪
#
# プレイヤーに敵対しないモブを攻撃した場合に逮捕
#
# 収監：30秒
# 保釈：銅インゴット × 3
#
# ※ 動物だけではなく魚・イカなども対象
# ============================================================


on damage of entity:

    # ========================================================
    # ARREST GAMEが無効
    # ========================================================

    if {arrest::enabled} is not true:
        stop


    # ========================================================
    # 攻撃したのがプレイヤー以外なら無視
    # ========================================================

    if attacker is not a player:
        stop


    # ========================================================
    # 対象ワールド以外
    # ========================================================

    if world of attacker is not {arrest::world}:
        stop


    # ========================================================
    # すでに収監中
    # ========================================================

    if {arrest::player::%uuid of attacker%::jail} is set:
        stop


    # ========================================================
    # 攻撃されたモブを判定
    # ========================================================

    if victim is not allay:
        if victim is not armadillo:
            if victim is not axolotl:
                if victim is not bat:
                    if victim is not camel:
                        if victim is not cat:
                            if victim is not chicken:
                                if victim is not cod:
                                    if victim is not cow:
                                        if victim is not dolphin:
                                            if victim is not donkey:
                                                if victim is not fox:
                                                    if victim is not frog:
                                                        if victim is not glow squid:
                                                            if victim is not horse:
                                                                if victim is not mooshroom:
                                                                    if victim is not mule:
                                                                        if victim is not ocelot:
                                                                            if victim is not panda:
                                                                                if victim is not parrot:
                                                                                    if victim is not pig:
                                                                                        if victim is not rabbit:
                                                                                            if victim is not salmon:
                                                                                                if victim is not sheep:
                                                                                                    if victim is not skeleton horse:
                                                                                                        if victim is not sniffer:
                                                                                                            if victim is not squid:
                                                                                                                if victim is not strider:
                                                                                                                    if victim is not tadpole:
                                                                                                                        if victim is not tropical fish:
                                                                                                                            if victim is not turtle:
                                                                                                                                if victim is not villager:
                                                                                                                                    if victim is not wandering trader:
                                                                                                                                        stop


    # ========================================================
    # 罪状
    # ========================================================

    set {_reason} to "なんかかわいそう罪"


    # ========================================================
    # 逮捕
    # ========================================================

    arrest_crime(attacker, "mob")
