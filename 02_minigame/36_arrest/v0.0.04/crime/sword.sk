# ============================================================
# ARREST GAME
# File : crime/sword.sk
#
# 犯罪：銃刀法違反
#
# 剣を手に持った場合に逮捕
#
# 収監：60秒
# 保釈：金インゴット × 2
# ============================================================


# ============================================================
# 手に持っているアイテムが変わった
# ============================================================

on held item change:

    # --------------------------------------------------------
    # 手に持ったアイテムを取得
    # --------------------------------------------------------

    set {_item} to event-item

    # --------------------------------------------------------
    # 剣ではない
    # --------------------------------------------------------

    if {_item} is not wooden sword:
        if {_item} is not stone sword:
            if {_item} is not iron sword:
                if {_item} is not copper sword:
                    if {_item} is not golden sword:
                        if {_item} is not diamond sword:
                            if {_item} is not netherite sword:
                                stop

    # --------------------------------------------------------
    # ARREST GAME OFF
    # --------------------------------------------------------

    if {arrest::enabled} is not true:
        stop

    # --------------------------------------------------------
    # 対象ワールド以外
    # --------------------------------------------------------

    if world of player is not {arrest::world}:
        stop

    # --------------------------------------------------------
    # すでに収監中
    # --------------------------------------------------------

    if {arrest::player::%uuid of player%::jail} is set:
        stop

    # --------------------------------------------------------
    # 犯罪発生
    # --------------------------------------------------------

    set {_reason} to "銃刀法違反"

    # --------------------------------------------------------
    # 逮捕
    #
    # 60秒
    # 金インゴット × 2
    # --------------------------------------------------------

    arrest_crime(player, "sword")
