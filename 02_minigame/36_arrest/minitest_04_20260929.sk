# ============================================================
# ARREST GAME
# File : arrest_game.sk
# Version : v0.2.06
#
# 草刈り → 逮捕 → 牢屋 → 収監 → 石の足場
#
# 牢屋
# ・土台 5 x 5
# ・高さ 5
# ・土台：reinforced_deepslate
# ・壁：iron_bars
# ・天井：reinforced_deepslate
# ・内部：air
#
# 座標
# ・プレイヤーが立っているブロック = Y - 1
# ・牢屋の土台 = Y - 1
# ・プレイヤー = Y
# ・鉄格子 = Y ～ Y + 2
# ・天井 = Y + 3
#
# 釈放後
# ・牢屋をすべて撤去
# ・5 x 5 の石ブロックだけ残す
# ============================================================


options:
    jail-time: 30


# ============================================================
# TEST ON / OFF
# ============================================================

command /arresttest [<text>]:
    permission: op
    trigger:

        # ====================================================
        # ON
        # ====================================================

        if arg-1 is "on":

            # 前回のBossBarを削除
            execute player command "bossbar remove arrest:jail"

            # 前回の牢屋が残っている場合
            if {arrest.jail.x1} is set:

                if {arrest.jail.world} is world of player:

                    set {_x1} to {arrest.jail.x1}
                    set {_y1} to {arrest.jail.y1}
                    set {_z1} to {arrest.jail.z1}

                    set {_x2} to {arrest.jail.x2}
                    set {_y2} to {arrest.jail.y2}
                    set {_z2} to {arrest.jail.z2}

                    execute player command "fill %{_x1}% %{_y1}% %{_z1}% %{_x2}% %{_y2}% %{_z2}% air"


            # ARREST GAME関連変数を初期化
            delete {arrest.jailed::*}
            delete {arrest.jail::*}

            # 今いるワールドを対象ワールドとして登録
            set {arresttest.world} to world of player
            set {arresttest.enabled} to true

            send "&a[ARREST TEST] 判定を開始しました。" to player
            send "&7対象ワールド: &f%world of player%" to player
            send "&7ARREST GAME関連の変数を初期化しました。" to player

            stop


        # ====================================================
        # OFF
        # ====================================================

        if arg-1 is "off":

            set {arresttest.enabled} to false

            send "&c[ARREST TEST] 判定を停止しました。" to player

            stop


        # ====================================================
        # HELP
        # ====================================================

        send "&e/arresttest on &7- 現在のワールドで判定開始＋変数初期化" to player
        send "&e/arresttest off &7- 判定停止" to player


# ============================================================
# 草刈り → 逮捕
# ============================================================

on break:

    # テストOFF
    if {arresttest.enabled} is not true:
        stop


    # 対象ワールド以外では何もしない
    if {arresttest.world} is not set:
        stop

    if world of player is not {arresttest.world}:
        stop


    # すでに収監中なら何もしない
    if {arrest.jailed.%player%} is true:
        stop


    # 草以外は何もしない
    if event-block is not short grass:
        if event-block is not tall grass:
            stop


    # ========================================================
    # 逮捕
    # ========================================================

    send title "&c環境破壊罪" with subtitle "&f草を壊したため逮捕されました。" to player

    set {arrest.jailed.%player%} to true


    # ========================================================
    # プレイヤーの現在位置
    # ========================================================

    set {_x} to floor(x-coordinate of player)
    set {_playerY} to floor(y-coordinate of player)
    set {_z} to floor(z-coordinate of player)


    # ========================================================
    # 牢屋座標
    #
    # プレイヤー = Y
    # 土台 = Y - 1
    # 鉄格子 = Y ～ Y + 2
    # 天井 = Y + 3
    # ========================================================

    set {_x1} to {_x} - 2
    set {_x2} to {_x} + 2

    set {_floor} to {_playerY} - 1
    set {_wall-top} to {_playerY} + 2
    set {_ceiling} to {_playerY} + 3

    set {_z1} to {_z} - 2
    set {_z2} to {_z} + 2


    # ========================================================
    # 牢屋情報保存
    # ========================================================

    set {arrest.jail.world} to world of player

    set {arrest.jail.x1} to {_x1}
    set {arrest.jail.y1} to {_floor}
    set {arrest.jail.z1} to {_z1}

    set {arrest.jail.x2} to {_x2}
    set {arrest.jail.y2} to {_ceiling}
    set {arrest.jail.z2} to {_z2}

    set {arrest.jail.time} to {@jail-time}


    # ========================================================
    # 牢屋内部を空気にする
    # ========================================================

    execute player command "fill %{_x1}% %{_playerY}% %{_z1}% %{_x2}% %{_wall-top}% %{_z2}% air"


    # ========================================================
    # 牢屋生成
    # ========================================================

    # 土台 5 x 5
    execute player command "fill %{_x1}% %{_floor}% %{_z1}% %{_x2}% %{_floor}% %{_z2}% reinforced_deepslate"

    # 天井 5 x 5
    execute player command "fill %{_x1}% %{_ceiling}% %{_z1}% %{_x2}% %{_ceiling}% %{_z2}% reinforced_deepslate"

    # 北側
    execute player command "fill %{_x1}% %{_playerY}% %{_z1}% %{_x2}% %{_wall-top}% %{_z1}% iron_bars"

    # 南側
    execute player command "fill %{_x1}% %{_playerY}% %{_z2}% %{_x2}% %{_wall-top}% %{_z2}% iron_bars"

    # 西側
    execute player command "fill %{_x1}% %{_playerY}% %{_z1}% %{_x1}% %{_wall-top}% %{_z2}% iron_bars"

    # 東側
    execute player command "fill %{_x2}% %{_playerY}% %{_z1}% %{_x2}% %{_wall-top}% %{_z2}% iron_bars"


    # ========================================================
    # 2tick後にもう一度生成
    # ========================================================

    wait 2 ticks

    # 内部を空気
    execute player command "fill %{_x1}% %{_playerY}% %{_z1}% %{_x2}% %{_wall-top}% %{_z2}% air"

    # 土台 5 x 5
    execute player command "fill %{_x1}% %{_floor}% %{_z1}% %{_x2}% %{_floor}% %{_z2}% reinforced_deepslate"

    # 天井 5 x 5
    execute player command "fill %{_x1}% %{_ceiling}% %{_z1}% %{_x2}% %{_ceiling}% %{_z2}% reinforced_deepslate"

    # 北側
    execute player command "fill %{_x1}% %{_playerY}% %{_z1}% %{_x2}% %{_wall-top}% %{_z1}% iron_bars"

    # 南側
    execute player command "fill %{_x1}% %{_playerY}% %{_z2}% %{_x2}% %{_wall-top}% %{_z2}% iron_bars"

    # 西側
    execute player command "fill %{_x1}% %{_playerY}% %{_z1}% %{_x1}% %{_wall-top}% %{_z2}% iron_bars"

    # 東側
    execute player command "fill %{_x2}% %{_playerY}% %{_z1}% %{_x2}% %{_wall-top}% %{_z2}% iron_bars"


    # ========================================================
    # BossBar
    # ========================================================

    execute player command "bossbar add arrest:jail {""text"":""収監中"",""color"":""red""}"

    execute player command "bossbar set arrest:jail players @s"

    execute player command "bossbar set arrest:jail max {@jail-time}"

    execute player command "bossbar set arrest:jail value {@jail-time}"

    execute player command "bossbar set arrest:jail color red"

    execute player command "bossbar set arrest:jail style notched_10"


    # ========================================================
    # 収監時間
    # ========================================================

    set {_remaining} to {@jail-time}

    while {_remaining} > 0:

        wait 1 second

        subtract 1 from {_remaining}

        execute player command "bossbar set arrest:jail value %{_remaining}%"


    # ========================================================
    # 牢屋解除
    # ========================================================

    # 牢屋全体を空気にする
    execute player command "fill %{_x1}% %{_floor}% %{_z1}% %{_x2}% %{_ceiling}% %{_z2}% air"

    # ========================================================
    # 釈放後の足場
    # 5 x 5 の石ブロック
    # ========================================================

    execute player command "fill %{_x1}% %{_floor}% %{_z1}% %{_x2}% %{_floor}% %{_z2}% stone"


    # ========================================================
    # BossBar削除
    # ========================================================

    execute player command "bossbar remove arrest:jail"


    # ========================================================
    # 逮捕状態解除
    # ========================================================

    delete {arrest.jailed.%player%}


    # ========================================================
    # 牢屋情報削除
    # ========================================================

    delete {arrest.jail.world}
    delete {arrest.jail.x1}
    delete {arrest.jail.y1}
    delete {arrest.jail.z1}
    delete {arrest.jail.x2}
    delete {arrest.jail.y2}
    delete {arrest.jail.z2}
    delete {arrest.jail.time}


    send "&a[ARREST GAME] &f収監期間が終了しました。" to player


# ============================================================
# ARREST GAMEの牢屋だけ破壊不可
# ============================================================

on break:

    # 牢屋が存在しない
    if {arrest.jail.x1} is not set:
        stop


    # 対象ワールド以外では保護しない
    if {arrest.jail.world} is not set:
        stop

    if world of player is not {arrest.jail.world}:
        stop


    # 破壊しようとしているブロックの座標
    set {_x} to floor(x-coordinate of event-block)
    set {_y} to floor(y-coordinate of event-block)
    set {_z} to floor(z-coordinate of event-block)


    # 牢屋範囲内だけ破壊禁止
    if {_x} is between {arrest.jail.x1} and {arrest.jail.x2}:

        if {_y} is between {arrest.jail.y1} and {arrest.jail.y2}:

            if {_z} is between {arrest.jail.z1} and {arrest.jail.z2}:

                cancel event

                send "&c[ARREST GAME] &f牢屋のブロックは破壊できません。" to player
