# ============================================================
# ARREST GAME
# File : arrest.sk
# Version : v0.0.01
#
# ARREST GAME 全体管理
#
# 現在実装：
# ・対象ワールド設定
# ・ON / OFF
# ・起動時の変数初期化
#
# 現在の罪状：
# ・環境破壊罪
#
# ============================================================


options:

    version: v0.0.01

    # --------------------------------------------------------
    # 現在の基本設定
    # --------------------------------------------------------

    jail-time: 30
    bail-amount: 5

    # BossBar表示範囲
    bossbar-radius: 30


# ============================================================
# /arrest
# ============================================================

command /arrest [<text>]:
    permission: op
    trigger:

        # ====================================================
        # ON
        # ====================================================

        if arg-1 is "on":

            # ------------------------------------------------
            # 前回のARREST状態を完全初期化
            #
            # 今回は「ONした時点」で変数をリセットする。
            # ------------------------------------------------

            delete {arrest::enabled}
            delete {arrest::world}
            delete {arrest::jail::*}
            delete {arrest::player::*}


            # ------------------------------------------------
            # BossBarを削除
            # ------------------------------------------------

            execute player command "bossbar remove arrest:jail_1"
            execute player command "bossbar remove arrest:jail_2"
            execute player command "bossbar remove arrest:jail_3"
            execute player command "bossbar remove arrest:jail_4"
            execute player command "bossbar remove arrest:jail_5"
            execute player command "bossbar remove arrest:jail_6"
            execute player command "bossbar remove arrest:jail_7"
            execute player command "bossbar remove arrest:jail_8"
            execute player command "bossbar remove arrest:jail_9"
            execute player command "bossbar remove arrest:jail_10"


            # ------------------------------------------------
            # 現在のワールドを対象ワールドとして登録
            # ------------------------------------------------

            set {arrest::world} to world of player
            set {arrest::enabled} to true


            send "&a[ARREST GAME] 判定を開始しました。" to player
            send "&7対象ワールド：&f%world of player%" to player
            send "&7Version：&f{@version}" to player

            stop


        # ====================================================
        # OFF
        # ====================================================

        if arg-1 is "off":

            set {arrest::enabled} to false

            send "&c[ARREST GAME] 判定を停止しました。" to player

            stop


        # ====================================================
        # STATUS
        # ====================================================

        if arg-1 is "status":

            if {arrest::enabled} is true:

                send "&a[ARREST GAME] 稼働中" to player

                if {arrest::world} is set:
                    send "&7対象ワールド：&f%{arrest::world}%" to player

                if {arrest::jail::ids::*} is set:
                    send "&7収監人数：&f%size of {arrest::jail::ids::*}%" to player
                else:
                    send "&7収監人数：&f0" to player

            else:

                send "&c[ARREST GAME] 停止中" to player

            stop


        # ====================================================
        # HELP
        # ====================================================

        send "&e/arrest on &7- 現在のワールドで開始＋変数初期化" to player
        send "&e/arrest off &7- 判定停止" to player
        send "&e/arrest status &7- 現在の状態"


# ============================================================
# 共通：
# ARRESTが動作している対象ワールドか
#
# 各crimeファイル側でも必ず
# enabled + world
# を確認する。
# ============================================================