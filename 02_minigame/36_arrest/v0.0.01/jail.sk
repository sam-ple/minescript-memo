# ============================================================
# ARREST GAME
# File : jail.sk
# Version : v0.0.01
#
# 牢屋管理
#
# ・牢屋生成
# ・複数牢屋
# ・収監
# ・保釈
# ・収監時間
# ・保釈看板
# ・牢屋破壊防止
# ・牢屋内へのブロック設置防止
#
# ============================================================


# ============================================================
# 牢屋生成
#
# {_p}      = 収監するプレイヤー
# {_reason} = 罪状
# ============================================================

function arrest_create_jail(p: player, reason: text):

    # --------------------------------------------------------
    # すでに収監中なら何もしない
    # --------------------------------------------------------

    if {arrest::player::%uuid of {_p}%::jail} is set:
        stop


    # --------------------------------------------------------
    # 牢屋IDを探す
    # --------------------------------------------------------

    set {_id} to 1

    while {arrest::jail::%{_id}%::active} is true:
        add 1 to {_id}


    # --------------------------------------------------------
    # 牢屋ID登録
    # --------------------------------------------------------

    add {_id} to {arrest::jail::ids::*}

    set {arrest::jail::%{_id}%::active} to true
    set {arrest::jail::%{_id}%::player} to {_p}
    set {arrest::jail::%{_id}%::player-name} to name of {_p}
    set {arrest::jail::%{_id}%::reason} to {_reason}

    set {arrest::player::%uuid of {_p}%::jail} to {_id}


    # ========================================================
    # プレイヤー位置
    # ========================================================

    set {_x} to floor(x-coordinate of {_p})
    set {_floor} to floor(y-coordinate of {_p})
    set {_z} to floor(z-coordinate of {_p})


    # ========================================================
    # 牢屋座標
    #
    # 土台      = プレイヤーの足元
    # プレイヤー = 土台 + 1
    # 鉄格子    = プレイヤー位置 ～ +2
    # 天井      = プレイヤー位置 +3
    # ========================================================

    set {_x1} to {_x} - 2
    set {_x2} to {_x} + 2

    set {_playerY} to {_floor} + 1
    set {_wall-top} to {_playerY} + 2
    set {_ceiling} to {_playerY} + 3

    set {_z1} to {_z} - 2
    set {_z2} to {_z} + 2


    # --------------------------------------------------------
    # 牢屋情報
    # --------------------------------------------------------

    set {arrest::jail::%{_id}%::world} to world of {_p}

    set {arrest::jail::%{_id}%::x1} to {_x1}
    set {arrest::jail::%{_id}%::y1} to {_floor}
    set {arrest::jail::%{_id}%::z1} to {_z1}

    set {arrest::jail::%{_id}%::x2} to {_x2}
    set {arrest::jail::%{_id}%::y2} to {_ceiling}
    set {arrest::jail::%{_id}%::z2} to {_z2}

    set {arrest::jail::%{_id}%::remaining} to {@jail-time}


    # ========================================================
    # 牢屋内部
    # ========================================================

    execute {_p} command "fill %{_x1}% %{_playerY}% %{_z1}% %{_x2}% %{_wall-top}% %{_z2}% air"


    # ========================================================
    # 土台
    # ========================================================

    execute {_p} command "fill %{_x1}% %{_floor}% %{_z1}% %{_x2}% %{_floor}% %{_z2}% reinforced_deepslate"


    # ========================================================
    # 天井
    # ========================================================

    execute {_p} command "fill %{_x1}% %{_ceiling}% %{_z1}% %{_x2}% %{_ceiling}% %{_z2}% reinforced_deepslate"


    # ========================================================
    # 北
    # ========================================================

    execute {_p} command "fill %{_x1}% %{_playerY}% %{_z1}% %{_x2}% %{_wall-top}% %{_z1}% iron_bars"


    # ========================================================
    # 南
    # ========================================================

    execute {_p} command "fill %{_x1}% %{_playerY}% %{_z2}% %{_x2}% %{_wall-top}% %{_z2}% iron_bars"


    # ========================================================
    # 西
    # ========================================================

    execute {_p} command "fill %{_x1}% %{_playerY}% %{_z1}% %{_x1}% %{_wall-top}% %{_z2}% iron_bars"


    # ========================================================
    # 東
    # ========================================================

    execute {_p} command "fill %{_x2}% %{_playerY}% %{_z1}% %{_x2}% %{_wall-top}% %{_z2}% iron_bars"


    # ========================================================
    # プレイヤーを牢屋中央へ
    # ========================================================

    teleport {_p} to location({_x} + 0.5, {_playerY}, {_z} + 0.5, world of {_p})


    # ========================================================
    # 看板座標
    # ========================================================

    # 北
    set {_north-x} to {_x}
    set {_north-y} to {_floor}
    set {_north-z} to {_z1} - 1

    # 南
    set {_south-x} to {_x}
    set {_south-y} to {_floor}
    set {_south-z} to {_z2} + 1

    # 西
    set {_west-x} to {_x1} - 1
    set {_west-y} to {_floor}
    set {_west-z} to {_z}

    # 東
    set {_east-x} to {_x2} + 1
    set {_east-y} to {_floor}
    set {_east-z} to {_z}


    # ========================================================
    # 看板座標保存
    # ========================================================

    set {arrest::jail::%{_id}%::sign::north::x} to {_north-x}
    set {arrest::jail::%{_id}%::sign::north::y} to {_north-y}
    set {arrest::jail::%{_id}%::sign::north::z} to {_north-z}

    set {arrest::jail::%{_id}%::sign::south::x} to {_south-x}
    set {arrest::jail::%{_id}%::sign::south::y} to {_south-y}
    set {arrest::jail::%{_id}%::sign::south::z} to {_south-z}

    set {arrest::jail::%{_id}%::sign::west::x} to {_west-x}
    set {arrest::jail::%{_id}%::sign::west::y} to {_west-y}
    set {arrest::jail::%{_id}%::sign::west::z} to {_west-z}

    set {arrest::jail::%{_id}%::sign::east::x} to {_east-x}
    set {arrest::jail::%{_id}%::sign::east::y} to {_east-y}
    set {arrest::jail::%{_id}%::sign::east::z} to {_east-z}


    # ========================================================
    # 看板位置を空気にする
    # ========================================================

    execute {_p} command "setblock %{_north-x}% %{_north-y}% %{_north-z}% air"
    execute {_p} command "setblock %{_south-x}% %{_south-y}% %{_south-z}% air"
    execute {_p} command "setblock %{_west-x}% %{_west-y}% %{_west-z}% air"
    execute {_p} command "setblock %{_east-x}% %{_east-y}% %{_east-z}% air"


    # ========================================================
    # 看板設置
    # ========================================================

    execute {_p} command "setblock %{_north-x}% %{_north-y}% %{_north-z}% oak_wall_sign[facing=north]"
    execute {_p} command "setblock %{_south-x}% %{_south-y}% %{_south-z}% oak_wall_sign[facing=south]"
    execute {_p} command "setblock %{_west-x}% %{_west-y}% %{_west-z}% oak_wall_sign[facing=west]"
    execute {_p} command "setblock %{_east-x}% %{_east-y}% %{_east-z}% oak_wall_sign[facing=east]"


    # ========================================================
    # 看板文字
    # ========================================================

    set line 2 of block at location({_north-x}, {_north-y}, {_north-z}, world of {_p}) to "&e&l保釈金"
    set line 3 of block at location({_north-x}, {_north-y}, {_north-z}, world of {_p}) to "&f&l鉄インゴット × 5"

    set line 2 of block at location({_south-x}, {_south-y}, {_south-z}, world of {_p}) to "&e&l保釈金"
    set line 3 of block at location({_south-x}, {_south-y}, {_south-z}, world of {_p}) to "&f&l鉄インゴット × 5"

    set line 2 of block at location({_west-x}, {_west-y}, {_west-z}, world of {_p}) to "&e&l保釈金"
    set line 3 of block at location({_west-x}, {_west-y}, {_west-z}, world of {_p}) to "&f&l鉄インゴット × 5"

    set line 2 of block at location({_east-x}, {_east-y}, {_east-z}, world of {_p}) to "&e&l保釈金"
    set line 3 of block at location({_east-x}, {_east-y}, {_east-z}, world of {_p}) to "&f&l鉄インゴット × 5"


    # ========================================================
    # 逮捕通知
    # ========================================================

    send title "&c%{_reason}%" with subtitle "&f%{_p}%" to {_p}

    broadcast "&c%{_p}%が%{_reason}%で捕まりました。"


# ============================================================
# 牢屋解除
#
# IDだけ指定して解除する。
# ============================================================

function arrest_release_jail(id: number, message: text):

    if {arrest::jail::%{_id}%::active} is not true:
        stop


    set {_p} to {arrest::jail::%{_id}%::player}
    set {_world} to {arrest::jail::%{_id}%::world}

    set {_x1} to {arrest::jail::%{_id}%::x1}
    set {_y1} to {arrest::jail::%{_id}%::y1}
    set {_z1} to {arrest::jail::%{_id}%::z1}

    set {_x2} to {arrest::jail::%{_id}%::x2}
    set {_y2} to {arrest::jail::%{_id}%::y2}
    set {_z2} to {arrest::jail::%{_id}%::z2}


    # ========================================================
    # 看板を先に削除
    # ========================================================

    execute {_p} command "setblock %{arrest::jail::%{_id}%::sign::north::x}% %{arrest::jail::%{_id}%::sign::north::y}% %{arrest::jail::%{_id}%::sign::north::z}% air"

    execute {_p} command "setblock %{arrest::jail::%{_id}%::sign::south::x}% %{arrest::jail::%{_id}%::sign::south::y}% %{arrest::jail::%{_id}%::sign::south::z}% air"

    execute {_p} command "setblock %{arrest::jail::%{_id}%::sign::west::x}% %{arrest::jail::%{_id}%::sign::west::y}% %{arrest::jail::%{_id}%::sign::west::z}% air"

    execute {_p} command "setblock %{arrest::jail::%{_id}%::sign::east::x}% %{arrest::jail::%{_id}%::sign::east::y}% %{arrest::jail::%{_id}%::sign::east::z}% air"


    # ========================================================
    # 牢屋撤去
    # ========================================================

    execute {_p} command "fill %{_x1}% %{_y1}% %{_z1}% %{_x2}% %{_y2}% %{_z2}% air"


    # ========================================================
    # 5 x 5 の石を残す
    # ========================================================

    execute {_p} command "fill %{_x1}% %{_y1}% %{_z1}% %{_x2}% %{_y1}% %{_z2}% stone"


    # ========================================================
    # プレイヤー情報解除
    # ========================================================

    delete {arrest::player::%uuid of {_p}%::jail}


    # ========================================================
    # BossBar
    # ========================================================

    execute {_p} command "bossbar remove arrest:jail_%{_id}%"


    # ========================================================
    # 牢屋情報削除
    # ========================================================

    delete {arrest::jail::%{_id}%::*}
    remove {_id} from {arrest::jail::ids::*}


    # ========================================================
    # メッセージ
    # ========================================================

    broadcast "&a[ARREST GAME] &f%{_p}%の%{_message}%"

    # オフライン等でも変数を残さない
    delete {_p}


# ============================================================
# 収監時間
# ============================================================

every 1 second:

    if {arrest::jail::ids::*} is not set:
        stop

    loop {arrest::jail::ids::*}:

        set {_id} to loop-value

        if {arrest::jail::%{_id}%::active} is not true:
            next loop

        subtract 1 from {arrest::jail::%{_id}%::remaining}

        if {arrest::jail::%{_id}%::remaining} <= 0:

            arrest_release_jail({_id}, "収監期間が終了しました。")


# ============================================================
# 保釈看板
#
# Generic on right click を使用。
# ============================================================

on right click:

    if clicked block is not set:
        stop

    if {arrest::jail::ids::*} is not set:
        stop

    # --------------------------------------------------------
    # 全牢屋を確認
    # --------------------------------------------------------

    loop {arrest::jail::ids::*}:

        set {_id} to loop-value

        if {arrest::jail::%{_id}%::active} is not true:
            next loop

        if world of player is not {arrest::jail::%{_id}%::world}:
            next loop


        # ----------------------------------------------------
        # クリック座標
        # ----------------------------------------------------

        set {_sx} to floor(x-coordinate of clicked block)
        set {_sy} to floor(y-coordinate of clicked block)
        set {_sz} to floor(z-coordinate of clicked block)


        # ----------------------------------------------------
        # 看板判定
        # ----------------------------------------------------

        set {_is-sign} to false

        if {_sx} is {arrest::jail::%{_id}%::sign::north::x}:
            if {_sy} is {arrest::jail::%{_id}%::sign::north::y}:
                if {_sz} is {arrest::jail::%{_id}%::sign::north::z}:
                    set {_is-sign} to true

        if {_sx} is {arrest::jail::%{_id}%::sign::south::x}:
            if {_sy} is {arrest::jail::%{_id}%::sign::south::y}:
                if {_sz} is {arrest::jail::%{_id}%::sign::south::z}:
                    set {_is-sign} to true

        if {_sx} is {arrest::jail::%{_id}%::sign::west::x}:
            if {_sy} is {arrest::jail::%{_id}%::sign::west::y}:
                if {_sz} is {arrest::jail::%{_id}%::sign::west::z}:
                    set {_is-sign} to true

        if {_sx} is {arrest::jail::%{_id}%::sign::east::x}:
            if {_sy} is {arrest::jail::%{_id}%::sign::east::y}:
                if {_sz} is {arrest::jail::%{_id}%::sign::east::z}:
                    set {_is-sign} to true


        if {_is-sign} is not true:
            next loop


        # ----------------------------------------------------
        # ARREST看板なので編集禁止
        # ----------------------------------------------------

        cancel event


        # ----------------------------------------------------
        # 保釈金
        # ----------------------------------------------------

        set {_iron} to number of iron ingots in player's inventory

        if {_iron} < {@bail-amount}:

            send "&c保釈金が足りません。" to player
            stop


        # ----------------------------------------------------
        # 保釈金を消費
        # ----------------------------------------------------

        remove {@bail-amount} iron ingots from player's inventory


        # ----------------------------------------------------
        # 牢屋解除
        # ----------------------------------------------------

        arrest_release_jail({_id}, "保釈されました。")

        stop


# ============================================================
# 牢屋ブロック破壊禁止
# ============================================================

on break:

    if {arrest::jail::ids::*} is not set:
        stop

    loop {arrest::jail::ids::*}:

        set {_id} to loop-value

        if {arrest::jail::%{_id}%::active} is not true:
            next loop

        if world of player is not {arrest::jail::%{_id}%::world}:
            next loop


        set {_bx} to floor(x-coordinate of event-block)
        set {_by} to floor(y-coordinate of event-block)
        set {_bz} to floor(z-coordinate of event-block)


        # ----------------------------------------------------
        # 牢屋本体
        # ----------------------------------------------------

        if {_bx} is between {arrest::jail::%{_id}%::x1} and {arrest::jail::%{_id}%::x2}:
            if {_by} is between {arrest::jail::%{_id}%::y1} and {arrest::jail::%{_id}%::y2}:
                if {_bz} is between {arrest::jail::%{_id}%::z1} and {arrest::jail::%{_id}%::z2}:

                    cancel event
                    stop


        # ----------------------------------------------------
        # 看板
        # ----------------------------------------------------

        if {_bx} is {arrest::jail::%{_id}%::sign::north::x}:
            if {_by} is {arrest::jail::%{_id}%::sign::north::y}:
                if {_bz} is {arrest::jail::%{_id}%::sign::north::z}:
                    cancel event
                    stop

        if {_bx} is {arrest::jail::%{_id}%::sign::south::x}:
            if {_by} is {arrest::jail::%{_id}%::sign::south::y}:
                if {_bz} is {arrest::jail::%{_id}%::sign::south::z}:
                    cancel event
                    stop

        if {_bx} is {arrest::jail::%{_id}%::sign::west::x}:
            if {_by} is {arrest::jail::%{_id}%::sign::west::y}:
                if {_bz} is {arrest::jail::%{_id}%::sign::west::z}:
                    cancel event
                    stop

        if {_bx} is {arrest::jail::%{_id}%::sign::east::x}:
            if {_by} is {arrest::jail::%{_id}%::sign::east::y}:
                if {_bz} is {arrest::jail::%{_id}%::sign::east::z}:
                    cancel event
                    stop


# ============================================================
# 牢屋内へのブロック設置禁止
# ============================================================

on place:

    if {arrest::jail::ids::*} is not set:
        stop

    loop {arrest::jail::ids::*}:

        set {_id} to loop-value

        if {arrest::jail::%{_id}%::active} is not true:
            next loop

        if world of player is not {arrest::jail::%{_id}%::world}:
            next loop


        set {_bx} to floor(x-coordinate of event-block)
        set {_by} to floor(y-coordinate of event-block)
        set {_bz} to floor(z-coordinate of event-block)


        if {_bx} is between {arrest::jail::%{_id}%::x1} and {arrest::jail::%{_id}%::x2}:
            if {_by} is between {arrest::jail::%{_id}%::y1} and {arrest::jail::%{_id}%::y2}:
                if {_bz} is between {arrest::jail::%{_id}%::z1} and {arrest::jail::%{_id}%::z2}:

                    cancel event
                    stop
