# ============================================================
# ARREST GAME
# File : jail.sk
# Version : v0.0.02
#
# 牢屋管理
#
# ・5 x 5
# ・高さ5
# ・reinforced_deepslate
# ・iron_bars
# ・四方向に保釈看板
# ・収監時間管理
# ・BossBarの削除もここで実行
#
# ============================================================


# ============================================================
# 牢屋作成
#
# arrest_create_jail(player, reason)
#
# ============================================================

function arrest_create_jail(p: player, reason: text):

    # --------------------------------------------------------
    # 牢屋ID
    # --------------------------------------------------------

    add 1 to {arrest::jail::next-id}

    set {_id} to {arrest::jail::next-id}


    # --------------------------------------------------------
    # プレイヤー位置
    # --------------------------------------------------------

    set {_x} to floor(x-coordinate of {_p})
    set {_floor} to floor(y-coordinate of {_p})
    set {_z} to floor(z-coordinate of {_p})

    set {_world} to world of {_p}


    # --------------------------------------------------------
    # 牢屋サイズ
    #
    # X -2 ～ +2
    # Z -2 ～ +2
    #
    # 床       = Y
    # プレイヤー = Y+1
    # 壁       = Y+1 ～ Y+3
    # 天井     = Y+4
    # --------------------------------------------------------

    set {_x1} to {_x} - 2
    set {_x2} to {_x} + 2

    set {_z1} to {_z} - 2
    set {_z2} to {_z} + 2

    set {_player-y} to {_floor} + 1
    set {_wall-top} to {_floor} + 3
    set {_ceiling} to {_floor} + 4


    # --------------------------------------------------------
    # 牢屋情報保存
    # --------------------------------------------------------

    add {_id} to {arrest::jail::ids::*}

    set {arrest::jail::%{_id}%::active} to true

    set {arrest::jail::%{_id}%::player} to {_p}
    set {arrest::jail::%{_id}%::uuid} to uuid of {_p}

    set {arrest::jail::%{_id}%::reason} to {_reason}

    set {arrest::jail::%{_id}%::world} to {_world}

    set {arrest::jail::%{_id}%::x1} to {_x1}
    set {arrest::jail::%{_id}%::x2} to {_x2}

    set {arrest::jail::%{_id}%::z1} to {_z1}
    set {arrest::jail::%{_id}%::z2} to {_z2}

    set {arrest::jail::%{_id}%::floor} to {_floor}
    set {arrest::jail::%{_id}%::ceiling} to {_ceiling}

    set {arrest::jail::%{_id}%::time} to {arrest::config::jail-time}
    set {arrest::jail::%{_id}%::max-time} to {arrest::config::jail-time}


    # --------------------------------------------------------
    # プレイヤーと牢屋IDを紐付け
    # --------------------------------------------------------

    set {arrest::player::%uuid of {_p}%::jail} to {_id}


    # ========================================================
    # 牢屋生成
    # ========================================================

    # --------------------------------------------------------
    # 内部を空気
    # --------------------------------------------------------

    execute {_p} command "/fill %{_x1}% %{_player-y}% %{_z1}% %{_x2}% %{_wall-top}% %{_z2}% air"


    # --------------------------------------------------------
    # 床
    # --------------------------------------------------------

    execute {_p} command "/fill %{_x1}% %{_floor}% %{_z1}% %{_x2}% %{_floor}% %{_z2}% reinforced_deepslate"


    # --------------------------------------------------------
    # 天井
    # --------------------------------------------------------

    execute {_p} command "/fill %{_x1}% %{_ceiling}% %{_z1}% %{_x2}% %{_ceiling}% %{_z2}% reinforced_deepslate"


    # --------------------------------------------------------
    # 北壁
    # --------------------------------------------------------

    execute {_p} command "/fill %{_x1}% %{_player-y}% %{_z1}% %{_x2}% %{_wall-top}% %{_z1}% iron_bars"


    # --------------------------------------------------------
    # 南壁
    # --------------------------------------------------------

    execute {_p} command "/fill %{_x1}% %{_player-y}% %{_z2}% %{_x2}% %{_wall-top}% %{_z2}% iron_bars"


    # --------------------------------------------------------
    # 西壁
    # --------------------------------------------------------

    execute {_p} command "/fill %{_x1}% %{_player-y}% %{_z1}% %{_x1}% %{_wall-top}% %{_z2}% iron_bars"


    # --------------------------------------------------------
    # 東壁
    # --------------------------------------------------------

    execute {_p} command "/fill %{_x2}% %{_player-y}% %{_z1}% %{_x2}% %{_wall-top}% %{_z2}% iron_bars"


    # ========================================================
    # 保釈看板
    # ========================================================

    # 北
    set {_north-x} to {_x}
    set {_north-y} to {_floor}
    set {_north-z} to {_z1} - 1

    # 南
    set {_south-x} to {_x}
    set {_south-y} to {_floor}
    set {_south-z} to {_z2} + 1

    # 西
    set {_west-x} to {_x1} - 1
    set {_west-y} to {_floor}
    set {_west-z} to {_z}

    # 東
    set {_east-x} to {_x2} + 1
    set {_east-y} to {_floor}
    set {_east-z} to {_z}


    # --------------------------------------------------------
    # 看板座標保存
    # --------------------------------------------------------

    set {arrest::jail::%{_id}%::sign::north::x} to {_north-x}
    set {arrest::jail::%{_id}%::sign::north::y} to {_north-y}
    set {arrest::jail::%{_id}%::sign::north::z} to {_north-z}

    set {arrest::jail::%{_id}%::sign::south::x} to {_south-x}
    set {arrest::jail::%{_id}%::sign::south::y} to {_south-y}
    set {arrest::jail::%{_id}%::sign::south::z} to {_south-z}

    set {arrest::jail::%{_id}%::sign::west::x} to {_west-x}
    set {arrest::jail::%{_id}%::sign::west::y} to {_west-y}
    set {arrest::jail::%{_id}%::sign::west::z} to {_west-z}

    set {arrest::jail::%{_id}%::sign::east::x} to {_east-x}
    set {arrest::jail::%{_id}%::sign::east::y} to {_east-y}
    set {arrest::jail::%{_id}%::sign::east::z} to {_east-z}


    # --------------------------------------------------------
    # 看板設置
    # --------------------------------------------------------

    # 北
    execute {_p} command "/setblock %{_north-x}% %{_north-y}% %{_north-z}% oak_wall_sign[facing=north]"

    # 南
    execute {_p} command "/setblock %{_south-x}% %{_south-y}% %{_south-z}% oak_wall_sign[facing=south]"

    # 西
    execute {_p} command "/setblock %{_west-x}% %{_west-y}% %{_west-z}% oak_wall_sign[facing=west]"

    # 東
    execute {_p} command "/setblock %{_east-x}% %{_east-y}% %{_east-z}% oak_wall_sign[facing=east]"

    # ========================================================
    # 看板文字
    # ========================================================

    # --------------------------------------------------------
    # 北
    # --------------------------------------------------------

    set line 2 of block at location({_north-x}, {_north-y}, {_north-z}, {_world}) to "&e&l保釈金"
    set line 3 of block at location({_north-x}, {_north-y}, {_north-z}, {_world}) to "&f&l鉄インゴット × 5"


    # --------------------------------------------------------
    # 南
    # --------------------------------------------------------

    set line 2 of block at location({_south-x}, {_south-y}, {_south-z}, {_world}) to "&e&l保釈金"
    set line 3 of block at location({_south-x}, {_south-y}, {_south-z}, {_world}) to "&f&l鉄インゴット × 5"


    # --------------------------------------------------------
    # 西
    # --------------------------------------------------------

    set line 2 of block at location({_west-x}, {_west-y}, {_west-z}, {_world}) to "&e&l保釈金"
    set line 3 of block at location({_west-x}, {_west-y}, {_west-z}, {_world}) to "&f&l鉄インゴット × 5"


    # --------------------------------------------------------
    # 東
    # --------------------------------------------------------

    set line 2 of block at location({_east-x}, {_east-y}, {_east-z}, {_world}) to "&e&l保釈金"
    set line 3 of block at location({_east-x}, {_east-y}, {_east-z}, {_world}) to "&f&l鉄インゴット × 5"

    # ========================================================
    # プレイヤーを牢屋中央へ
    # ========================================================

    teleport {_p} to location({_x} + 0.5, {_player-y}, {_z} + 0.5, {_world})


    # ========================================================
    # 完了メッセージ
    # ========================================================

    send "&c[ARREST] %{_p}% を収監しました。" to all players
    send "&7罪状：%{_reason}%" to all players


# ============================================================
# 収監終了
#
# arrest_release_jail(id)
# ============================================================

function arrest_release_jail(id: number):

    if {arrest::jail::%{_id}%::active} is not true:
        stop


    set {_p} to {arrest::jail::%{_id}%::player}


    # --------------------------------------------------------
    # 牢屋座標
    # --------------------------------------------------------

    set {_x1} to {arrest::jail::%{_id}%::x1}
    set {_x2} to {arrest::jail::%{_id}%::x2}

    set {_z1} to {arrest::jail::%{_id}%::z1}
    set {_z2} to {arrest::jail::%{_id}%::z2}

    set {_floor} to {arrest::jail::%{_id}%::floor}
    set {_ceiling} to {arrest::jail::%{_id}%::ceiling}


    # ========================================================
    # BossBarを先に削除
    # ========================================================

    if {arrest::jail::%{_id}%::bossbar} is set:

        set {_bar} to {arrest::jail::%{_id}%::bossbar}

        remove all players from viewers of {_bar}

        delete {_bar}

        delete {arrest::jail::%{_id}%::bossbar}


    # ========================================================
    # 看板削除
    # ========================================================

    if {_p} is set:

        execute {_p} command "/setblock %{arrest::jail::%{_id}%::sign::north::x}% %{arrest::jail::%{_id}%::sign::north::y}% %{arrest::jail::%{_id}%::sign::north::z}% air"

        execute {_p} command "/setblock %{arrest::jail::%{_id}%::sign::south::x}% %{arrest::jail::%{_id}%::sign::south::y}% %{arrest::jail::%{_id}%::sign::south::z}% air"

        execute {_p} command "/setblock %{arrest::jail::%{_id}%::sign::west::x}% %{arrest::jail::%{_id}%::sign::west::y}% %{arrest::jail::%{_id}%::sign::west::z}% air"

        execute {_p} command "/setblock %{arrest::jail::%{_id}%::sign::east::x}% %{arrest::jail::%{_id}%::sign::east::y}% %{arrest::jail::%{_id}%::sign::east::z}% air"


    # ========================================================
    # 牢屋撤去
    # ========================================================

    if {_p} is set:

        execute {_p} command "/fill %{_x1}% %{_floor}% %{_z1}% %{_x2}% %{_ceiling}% %{_z2}% air"

        # 5 x 5 の床だけ残す
        execute {_p} command "/fill %{_x1}% %{_floor}% %{_z1}% %{_x2}% %{_floor}% %{_z2}% cobblestone"


        # プレイヤーを牢屋中央から出す
        teleport {_p} to location(({_x1} + {_x2}) / 2 + 0.5, {_floor} + 1, ({_z1} + {_z2}) / 2 + 0.5, {arrest::jail::%{_id}%::world})


    # ========================================================
    # プレイヤー状態解除
    # ========================================================

    if {_p} is set:

        delete {arrest::player::%uuid of {_p}%::jail}


    # ========================================================
    # IDを無効化
    # ========================================================

    set {arrest::jail::%{_id}%::active} to false


    # ========================================================
    # 完了メッセージ
    # ========================================================

    if {_p} is set:

        send "&a[ARREST] 収監が終了しました。" to {_p}

    send "&7収監時間が終了しました。" to all players


# ============================================================
# 保釈看板
# ============================================================

on right click:

    if clicked block is not set:
        stop

    if type of clicked block is not oak wall sign:
        stop


    # --------------------------------------------------------
    # すべての牢屋を確認
    # --------------------------------------------------------

    loop {arrest::jail::ids::*}:

        set {_id} to loop-value


        if {arrest::jail::%{_id}%::active} is true:

            if world of player is {arrest::jail::%{_id}%::world}:

                set {_x} to floor(x-coordinate of clicked block)
                set {_y} to floor(y-coordinate of clicked block)
                set {_z} to floor(z-coordinate of clicked block)


                # ------------------------------------------------
                # 北
                # ------------------------------------------------

                if {_x} is {arrest::jail::%{_id}%::sign::north::x}:
                    if {_y} is {arrest::jail::%{_id}%::sign::north::y}:
                        if {_z} is {arrest::jail::%{_id}%::sign::north::z}:

                            cancel event

                            set {_bail} to {arrest::config::bail-amount} of iron ingots

                            if player has {_bail}:

                                remove {_bail} from player's inventory

                                arrest_release_jail({_id})

                            else:

                                send "&c鉄インゴットが足りません。" to player

                            stop


                # ------------------------------------------------
                # 南
                # ------------------------------------------------

                if {_x} is {arrest::jail::%{_id}%::sign::south::x}:
                    if {_y} is {arrest::jail::%{_id}%::sign::south::y}:
                        if {_z} is {arrest::jail::%{_id}%::sign::south::z}:

                            cancel event

                            set {_bail} to {arrest::config::bail-amount} of iron ingots

                            if player has {_bail}:

                                remove {_bail} from player's inventory

                                arrest_release_jail({_id})

                            else:

                                send "&c鉄インゴットが足りません。" to player

                            stop


                # ------------------------------------------------
                # 西
                # ------------------------------------------------

                if {_x} is {arrest::jail::%{_id}%::sign::west::x}:
                    if {_y} is {arrest::jail::%{_id}%::sign::west::y}:
                        if {_z} is {arrest::jail::%{_id}%::sign::west::z}:

                            cancel event

                            set {_bail} to {arrest::config::bail-amount} of iron ingots

                            if player has {_bail}:

                                remove {_bail} from player's inventory

                                arrest_release_jail({_id})

                            else:

                                send "&c鉄インゴットが足りません。" to player

                            stop


                # ------------------------------------------------
                # 東
                # ------------------------------------------------

                if {_x} is {arrest::jail::%{_id}%::sign::east::x}:
                    if {_y} is {arrest::jail::%{_id}%::sign::east::y}:
                        if {_z} is {arrest::jail::%{_id}%::sign::east::z}:

                            cancel event

                            set {_bail} to {arrest::config::bail-amount} of iron ingots

                            if player has {_bail}:

                                remove {_bail} from player's inventory

                                arrest_release_jail({_id})

                            else:

                                send "&c鉄インゴットが足りません。" to player

                            stop

# ============================================================
# 牢屋の破壊禁止
# ・土台
# ・天井
# ・鉄格子
# ・保釈看板
# ============================================================

on break:

    loop {arrest::jail::ids::*}:

        set {_id} to loop-value

        # 牢屋が稼働中か確認
        if {arrest::jail::%{_id}%::active} is true:

            # ワールド確認
            if world of player is {arrest::jail::%{_id}%::world}:

                set {_x1} to {arrest::jail::%{_id}%::x1}
                set {_x2} to {arrest::jail::%{_id}%::x2}
                set {_z1} to {arrest::jail::%{_id}%::z1}
                set {_z2} to {arrest::jail::%{_id}%::z2}
                set {_floor} to {arrest::jail::%{_id}%::floor}
                set {_ceiling} to {arrest::jail::%{_id}%::ceiling}

                set {_bx} to floor(x-coordinate of event-block)
                set {_by} to floor(y-coordinate of event-block)
                set {_bz} to floor(z-coordinate of event-block)

                # ------------------------------------------------
                # 牢屋本体
                # ------------------------------------------------

                if {_bx} is between {_x1} and {_x2}:
                    if {_bz} is between {_z1} and {_z2}:
                        if {_by} is between {_floor} and {_ceiling}:
                            cancel event
                            stop

                # ------------------------------------------------
                # 北側看板
                # ------------------------------------------------

                if {_bx} = {arrest::jail::%{_id}%::sign::north::x}:
                    if {_by} = {arrest::jail::%{_id}%::sign::north::y}:
                        if {_bz} = {arrest::jail::%{_id}%::sign::north::z}:
                            cancel event
                            stop

                # ------------------------------------------------
                # 南側看板
                # ------------------------------------------------

                if {_bx} = {arrest::jail::%{_id}%::sign::south::x}:
                    if {_by} = {arrest::jail::%{_id}%::sign::south::y}:
                        if {_bz} = {arrest::jail::%{_id}%::sign::south::z}:
                            cancel event
                            stop

                # ------------------------------------------------
                # 西側看板
                # ------------------------------------------------

                if {_bx} = {arrest::jail::%{_id}%::sign::west::x}:
                    if {_by} = {arrest::jail::%{_id}%::sign::west::y}:
                        if {_bz} = {arrest::jail::%{_id}%::sign::west::z}:
                            cancel event
                            stop

                # ------------------------------------------------
                # 東側看板
                # ------------------------------------------------

                if {_bx} = {arrest::jail::%{_id}%::sign::east::x}:
                    if {_by} = {arrest::jail::%{_id}%::sign::east::y}:
                        if {_bz} = {arrest::jail::%{_id}%::sign::east::z}:
                            cancel event
                            stop
