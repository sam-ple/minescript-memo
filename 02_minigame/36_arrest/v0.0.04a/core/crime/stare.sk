# ============================================================
# ARREST GAME
# File : crime/stare.sk
# Version : v0.0.04a
#
# 犯罪：凝視罪
#
# 他プレイヤーを15秒間見続けた場合に逮捕
#
# 収監時間・保釈金は config/crimes.sk で管理
# ============================================================


# ============================================================
# 1秒ごとに凝視チェック
# ============================================================

every 1 second:

    loop all players:

        set {_p} to loop-player

        # ----------------------------------------------------
        # ARREST GAME OFF
        # ----------------------------------------------------

        if {arrest::enabled} is not true:
            continue

        # ----------------------------------------------------
        # 対象ワールド以外
        # ----------------------------------------------------

        if world of {_p} is not {arrest::world}:
            delete {arrest::stare::%uuid of {_p}%::*}
            continue

        # ----------------------------------------------------
        # すでに収監中
        # ----------------------------------------------------

        if {arrest::player::%uuid of {_p}%::jail} is set:
            delete {arrest::stare::%uuid of {_p}%::*}
            continue

        # ----------------------------------------------------
        # 見ている対象を取得
        # ----------------------------------------------------

        set {_target} to targeted entity of {_p}

        # ----------------------------------------------------
        # プレイヤーではない
        # ----------------------------------------------------

        if {_target} is not a player:
            delete {arrest::stare::%uuid of {_p}%::*}
            continue

        # ----------------------------------------------------
        # 自分自身
        # ----------------------------------------------------

        if {_target} is {_p}:
            delete {arrest::stare::%uuid of {_p}%::*}
            continue

        # ----------------------------------------------------
        # 見ている相手を記録
        # ----------------------------------------------------

        set {_target-uuid} to uuid of {_target}

        # ----------------------------------------------------
        # 初めて見る
        # ----------------------------------------------------

        if {arrest::stare::%uuid of {_p}%::target} is not {_target-uuid}:

            set {arrest::stare::%uuid of {_p}%::target} to {_target-uuid}
            set {arrest::stare::%uuid of {_p}%::time} to 0

            continue

        # ----------------------------------------------------
        # 同じ相手を見続けている
        # ----------------------------------------------------

        add 1 to {arrest::stare::%uuid of {_p}%::time}

        # ----------------------------------------------------
        # 15秒凝視
        # ----------------------------------------------------

        if {arrest::stare::%uuid of {_p}%::time} >= 15:

            delete {arrest::stare::%uuid of {_p}%::*}

            arrest_crime({_p}, "stare")
