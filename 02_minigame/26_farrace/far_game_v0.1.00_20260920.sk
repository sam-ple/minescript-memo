# ============================================================
# FARRACE
# Distance Race Game
# Version : v0.1.00(v0.0.06)
#
# ============================================================
#
# GAME
#
#   スタート地点からプレイヤーがどれだけ遠くに
#   最終的に到達していたかを競うゲーム。
#
#   最大距離ではなく、
#   制限時間終了時点の「最終地点」の距離を使用する。
#
#   Y座標は距離計算に使用しない。
#
#   Distance =
#   sqrt((X - StartX)^2 + (Z - StartZ)^2)
#
#
# END FLOW
#
#   0:03 → 3
#   0:02 → 2
#   0:01 → 1
#   0:00 → FINISH!
#   Time Up!
#   Final Results
#   Ranking
#   1秒後スタート地点へTP
#   BossBar / Scoreboard 即時Cleanup
#
#
# COMMAND
#
#   /far
#
#   /far set
#   /far time 5
#   /far time 15
#   /far time 30
#   /far time 60
#   /far start
#   /far stop
#   /far status
#   /far result
#   /far debug
#   /far reset
#
# ============================================================


options:
    prefix: &8[&bFarRace&8]&r
    gui-name: &8FarRace
    bossbar-key: far:timer


# ============================================================
# /far
# ============================================================

command /far [<text>] [<number>]:
    permission: op
    trigger:

        # ====================================================
        # GUI
        # ====================================================

        if arg-1 is not set:

            # ------------------------------------------------
            # Default duration
            # ------------------------------------------------

            if {far.duration} is not set:
                set {far.duration} to 300
                set {far.duration.text} to "5:00"

            # ------------------------------------------------
            # GUI
            # ------------------------------------------------

            set {_gui} to chest inventory with 6 rows named "{@gui-name}"

            # ------------------------------------------------
            # Background
            # ------------------------------------------------

            loop 54 times:
                set slot (loop-number - 1) of {_gui} to gray stained glass pane named " "

            # ------------------------------------------------
            # SET
            # ------------------------------------------------

            set slot 10 of {_gui} to compass named "&a&lSET"
            set lore of slot 10 of {_gui} to "&7現在位置をスタート地点に設定します。"

            # ------------------------------------------------
            # START
            # ------------------------------------------------

            set slot 12 of {_gui} to lime concrete named "&a&lSTART"
            set lore of slot 12 of {_gui} to "&7FarRaceを開始します。"

            # ------------------------------------------------
            # STOP
            # ------------------------------------------------

            set slot 14 of {_gui} to red concrete named "&c&lSTOP"
            set lore of slot 14 of {_gui} to "&7現在のゲームを停止します。"

            # ------------------------------------------------
            # RESET
            # ------------------------------------------------

            set slot 16 of {_gui} to barrier named "&c&lRESET"
            set lore of slot 16 of {_gui} to "&7FarRaceをリセットします。"

            # ------------------------------------------------
            # TIME TITLE
            # ------------------------------------------------

            set slot 22 of {_gui} to clock named "&e&lTIME"

            # ------------------------------------------------
            # 5 MIN
            # ------------------------------------------------

            set slot 28 of {_gui} to clock named "&e5 MIN"

            if {far.duration} is 300:
                set slot 28 of {_gui} to clock named "&a&l5 MIN"
                set lore of slot 28 of {_gui} to "&a選択中"

            # ------------------------------------------------
            # 15 MIN
            # ------------------------------------------------

            set slot 29 of {_gui} to clock named "&e15 MIN"

            if {far.duration} is 900:
                set slot 29 of {_gui} to clock named "&a&l15 MIN"
                set lore of slot 29 of {_gui} to "&a選択中"

            # ------------------------------------------------
            # 30 MIN
            # ------------------------------------------------

            set slot 30 of {_gui} to clock named "&e30 MIN"

            if {far.duration} is 1800:
                set slot 30 of {_gui} to clock named "&a&l30 MIN"
                set lore of slot 30 of {_gui} to "&a選択中"

            # ------------------------------------------------
            # 60 MIN
            # ------------------------------------------------

            set slot 31 of {_gui} to clock named "&e60 MIN"

            if {far.duration} is 3600:
                set slot 31 of {_gui} to clock named "&a&l60 MIN"
                set lore of slot 31 of {_gui} to "&a選択中"

            # ------------------------------------------------
            # STATUS
            # ------------------------------------------------

            if {far.running} is true:

                set slot 35 of {_gui} to lime dye named "&a&lRUNNING"
                set lore of slot 35 of {_gui} to "&7FarRace is running."

            else if {far.countdown} is true:

                set slot 35 of {_gui} to yellow dye named "&e&lCOUNTDOWN"
                set lore of slot 35 of {_gui} to "&7Game starting..."

            else if {far.finished} is true:

                set slot 35 of {_gui} to gold ingot named "&6&lFINISHED"
                set lore of slot 35 of {_gui} to "&7Game finished."

            else:

                set slot 35 of {_gui} to gray dye named "&7&lSTOPPED"
                set lore of slot 35 of {_gui} to "&7FarRace is stopped."

            # ------------------------------------------------
            # RESULT
            # ------------------------------------------------

            set slot 44 of {_gui} to gold ingot named "&6&lRESULT"
            set lore of slot 44 of {_gui} to "&7最新の結果を表示します。"

            # ------------------------------------------------
            # DEBUG
            # ------------------------------------------------

            if {far.debug} is true:

                set slot 53 of {_gui} to lime dye named "&a&lDEBUG ON"
                set lore of slot 53 of {_gui} to "&7アクションバー表示: &aON"

            else:

                set slot 53 of {_gui} to gray dye named "&7&lDEBUG OFF"
                set lore of slot 53 of {_gui} to "&7アクションバー表示: &cOFF"

            # ------------------------------------------------
            # START POSITION
            # ------------------------------------------------

            if {far.start.x} is set:

                set slot 49 of {_gui} to emerald named "&aStart Position"
                set lore of slot 49 of {_gui} to "&7X: &f%{far.start.x}%" and "&7Z: &f%{far.start.z}%"

            else:

                set slot 49 of {_gui} to redstone named "&cStart Position"
                set lore of slot 49 of {_gui} to "&c未設定"

            open {_gui} to player
            stop


        # ====================================================
        # SET
        # ====================================================

        if arg-1 is "set":

            if {far.running} is true:
                send "{@prefix} &cGame is running." to player
                stop

            if {far.countdown} is true:
                send "{@prefix} &cGame is starting." to player
                stop

            if {far.finishing} is true:
                send "{@prefix} &cGame is finishing." to player
                stop

            set {far.start.x} to x-coordinate of player
            set {far.start.z} to z-coordinate of player

            set {far.start.location} to location of player
            set {far.start.world} to world of player

            send "{@prefix} &aStart position set!" to player
            send "{@prefix} &7Start X: &f%{far.start.x}%" to player
            send "{@prefix} &7Start Z: &f%{far.start.z}%" to player
            send "{@prefix} &7World: &f%{far.start.world}%" to player

            stop


        # ====================================================
        # TIME
        # ====================================================

        if arg-1 is "time":

            if {far.running} is true:
                send "{@prefix} &cGame is running." to player
                stop

            if {far.countdown} is true:
                send "{@prefix} &cGame is starting." to player
                stop

            if {far.finishing} is true:
                send "{@prefix} &cGame is finishing." to player
                stop

            if arg-2 is not set:
                send "{@prefix} &e/far time <5|15|30|60>" to player
                stop

            if arg-2 is 5:

                set {far.duration} to 300
                set {far.duration.text} to "5:00"

                send "{@prefix} &aTime set to &e5 minutes&a." to player
                stop

            if arg-2 is 15:

                set {far.duration} to 900
                set {far.duration.text} to "15:00"

                send "{@prefix} &aTime set to &e15 minutes&a." to player
                stop

            if arg-2 is 30:

                set {far.duration} to 1800
                set {far.duration.text} to "30:00"

                send "{@prefix} &aTime set to &e30 minutes&a." to player
                stop

            if arg-2 is 60:

                set {far.duration} to 3600
                set {far.duration.text} to "60:00"

                send "{@prefix} &aTime set to &e60 minutes&a." to player
                stop

            send "{@prefix} &cInvalid time." to player
            send "{@prefix} &7Use: &f/far time 5|15|30|60" to player

            stop


        # ====================================================
        # START
        # ====================================================

        if arg-1 is "start":

            # ------------------------------------------------
            # Start check
            # ------------------------------------------------

            if {far.start.x} is not set:

                send "{@prefix} &cStart position is not set." to player
                stop

            if {far.running} is true:

                send "{@prefix} &cFarRace is already running." to player
                stop

            if {far.countdown} is true:

                send "{@prefix} &cFarRace is already starting." to player
                stop

            if {far.finishing} is true:

                send "{@prefix} &cFarRace is finishing." to player
                stop

            # ------------------------------------------------
            # Default time
            # ------------------------------------------------

            if {far.duration} is not set:

                set {far.duration} to 300
                set {far.duration.text} to "5:00"

            # ------------------------------------------------
            # Game ID
            # ------------------------------------------------

            if {far.game.id} is not set:
                set {far.game.id} to 0

            add 1 to {far.game.id}

            set {_gameid} to {far.game.id}

            # ------------------------------------------------
            # State
            # ------------------------------------------------

            set {far.running} to false
            set {far.countdown} to true
            set {far.finishing} to false
            set {far.finished} to false

            set {far.elapsed} to 0
            set {far.remaining} to {far.duration}

            # ------------------------------------------------
            # Players
            # ------------------------------------------------

            delete {far.players::*}
            delete {far.distance::*}
            delete {far.player.name::*}

            loop all players:

                set {_uuid} to uuid of loop-player

                add {_uuid} to {far.players::*}

                set {far.distance::%{_uuid}%} to 0
                set {far.player.name::%{_uuid}%} to name of loop-player

            # ------------------------------------------------
            # Scoreboard
            # ------------------------------------------------

            execute console command "scoreboard objectives remove farDistance"
            execute console command "scoreboard objectives add farDistance dummy Distance"
            execute console command "scoreboard objectives setdisplay sidebar farDistance"

            loop all players:

                execute console command "scoreboard players set %loop-player% farDistance 0"

            # ------------------------------------------------
            # BossBar
            # ------------------------------------------------

            set {_bar} to boss bar with key "{@bossbar-key}"

            if {_bar} is not set:

                set {_bar} to a keyed blue boss bar with key "{@bossbar-key}":
                    set title of event-bossbar to "&bFarRace &f%{far.duration.text}%"
                    set progress of event-bossbar to 100%
                    set style of event-bossbar to solid

            set title of {_bar} to "&bFarRace &f%{far.duration.text}%"
            set progress of {_bar} to 100%
            set style of {_bar} to solid

            loop all players:

                add loop-player to viewers of {_bar}

            # ------------------------------------------------
            # Announcement
            # ------------------------------------------------

            send "" to all players
            send "&8&m--------------------------------" to all players
            send "&b&lFarRace" to all players
            send "" to all players
            send "&7Time: &e%{far.duration.text}%" to all players
            send "&7Players: &e%size of {far.players::*}%" to all players
            send "" to all players
            send "&eGet ready!" to all players
            send "&8&m--------------------------------" to all players

            # =================================================
            # TITLE COUNTDOWN
            # =================================================

            wait 1 second

            if {far.game.id} is not {_gameid}:
                stop

            if {far.countdown} is not true:
                stop

            send title "&e&l5" with subtitle "&7Get Ready!" to all players
            play sound "block.note_block.pling" with volume 1 and pitch 1 to all players

            wait 1 second

            if {far.game.id} is not {_gameid}:
                stop

            if {far.countdown} is not true:
                stop

            send title "&e&l4" with subtitle "&7Get Ready!" to all players
            play sound "block.note_block.pling" with volume 1 and pitch 1 to all players

            wait 1 second

            if {far.game.id} is not {_gameid}:
                stop

            if {far.countdown} is not true:
                stop

            send title "&6&l3" with subtitle "&7Get Ready!" to all players
            play sound "block.note_block.pling" with volume 1 and pitch 1 to all players

            wait 1 second

            if {far.game.id} is not {_gameid}:
                stop

            if {far.countdown} is not true:
                stop

            send title "&c&l2" with subtitle "&7Get Ready!" to all players
            play sound "block.note_block.pling" with volume 1 and pitch 1 to all players

            wait 1 second

            if {far.game.id} is not {_gameid}:
                stop

            if {far.countdown} is not true:
                stop

            send title "&c&l1" with subtitle "&7Get Ready!" to all players
            play sound "block.note_block.pling" with volume 1 and pitch 1 to all players

            wait 1 second

            if {far.game.id} is not {_gameid}:
                stop

            if {far.countdown} is not true:
                stop

            set {far.countdown} to false
            set {far.running} to true
            set {far.finishing} to false

            send title "&a&lSTART!" with subtitle "&7FarRace" to all players
            play sound "entity.player.levelup" with volume 1 and pitch 1 to all players

            stop


        # ====================================================
        # STOP
        # ====================================================

        if arg-1 is "stop":

            # ------------------------------------------------
            # Cancel countdown
            # ------------------------------------------------

            if {far.countdown} is true:

                if {far.game.id} is not set:
                    set {far.game.id} to 0

                add 1 to {far.game.id}

                set {far.countdown} to false
                set {far.running} to false
                set {far.finishing} to false

                send "{@prefix} &cCountdown cancelled." to player
                stop

            # ------------------------------------------------
            # Cancel finishing
            # ------------------------------------------------

            if {far.finishing} is true:

                if {far.game.id} is not set:
                    set {far.game.id} to 0

                add 1 to {far.game.id}

                set {far.finishing} to false
                set {far.running} to false

                send "{@prefix} &cFinish sequence cancelled." to player
                stop

            # ------------------------------------------------
            # Stop running game
            # ------------------------------------------------

            if {far.running} is not true:

                send "{@prefix} &cFarRace is not running." to player
                stop

            if {far.game.id} is not set:
                set {far.game.id} to 0

            add 1 to {far.game.id}

            set {far.running} to false
            set {far.countdown} to false
            set {far.finishing} to false
            set {far.finished} to true

            # ------------------------------------------------
            # BossBar
            # ------------------------------------------------

            set {_bar} to boss bar with key "{@bossbar-key}"

            if {_bar} is set:
                remove all players from viewers of {_bar}

            # ------------------------------------------------
            # Scoreboard
            # ------------------------------------------------

            execute console command "scoreboard objectives remove farDistance"

            send "" to all players
            send "&8&m--------------------------------" to all players
            send "&c&lFarRace STOPPED" to all players
            send "&8&m--------------------------------" to all players

            stop


        # ====================================================
        # STATUS
        # ====================================================

        if arg-1 is "status":

            send "" to player
            send "&8&m--------------------------------" to player
            send "&b&lFarRace STATUS" to player
            send "" to player

            if {far.running} is true:

                send "&7Status: &aRUNNING" to player

            else if {far.countdown} is true:

                send "&7Status: &eCOUNTDOWN" to player

            else if {far.finishing} is true:

                send "&7Status: &6FINISHING" to player

            else if {far.finished} is true:

                send "&7Status: &6FINISHED" to player

            else:

                send "&7Status: &cSTOPPED" to player

            if {far.duration.text} is set:
                send "&7Time: &e%{far.duration.text}%" to player

            if {far.start.x} is set:

                send "&7Start X: &f%{far.start.x}%" to player
                send "&7Start Z: &f%{far.start.z}%" to player
                send "&7World: &f%{far.start.world}%" to player

            if {far.running} is true:

                send "&7Elapsed: &f%{far.elapsed}% sec" to player
                send "&7Remaining: &f%{far.remaining}% sec" to player

            if {far.finishing} is true:

                send "&7Remaining: &f%{far.remaining}% sec" to player

            send "&7Players: &f%size of {far.players::*}%" to player
            send "&7Debug: &f%{far.debug}%" to player

            send "&8&m--------------------------------" to player

            stop


        # ====================================================
        # RESULT
        # ====================================================

        if arg-1 is "result":

            if {far.players::*} is not set:

                send "{@prefix} &cNo game result." to player
                stop

            send "" to player
            send "&8&m--------------------------------" to player
            send "&6&lFarRace RESULT" to player
            send "" to player

            set {_remaining::*} to {far.players::*}

            # ------------------------------------------------
            # 1st
            # ------------------------------------------------

            set {_winner} to none
            set {_max} to -1

            loop {_remaining::*}:

                set {_uuid} to loop-value
                set {_score} to {far.distance::%{_uuid}%}

                if {_score} is not set:
                    set {_score} to 0

                if {_score} > {_max}:

                    set {_max} to {_score}
                    set {_winner} to {_uuid}

            if {_winner} is set:

                set {_name} to {far.player.name::%{_winner}%}

                send "&e&l1st &f%{_name}% &7- &e%{_max}%m" to player

                remove {_winner} from {_remaining::*}


            # ------------------------------------------------
            # 2nd
            # ------------------------------------------------

            if {_remaining::*} is set:

                set {_winner} to none
                set {_max} to -1

                loop {_remaining::*}:

                    set {_uuid} to loop-value
                    set {_score} to {far.distance::%{_uuid}%}

                    if {_score} is not set:
                        set {_score} to 0

                    if {_score} > {_max}:

                        set {_max} to {_score}
                        set {_winner} to {_uuid}

                if {_winner} is set:

                    set {_name} to {far.player.name::%{_winner}%}

                    send "&f&l2nd &f%{_name}% &7- &e%{_max}%m" to player

                    remove {_winner} from {_remaining::*}


            # ------------------------------------------------
            # 3rd
            # ------------------------------------------------

            if {_remaining::*} is set:

                set {_winner} to none
                set {_max} to -1

                loop {_remaining::*}:

                    set {_uuid} to loop-value
                    set {_score} to {far.distance::%{_uuid}%}

                    if {_score} is not set:
                        set {_score} to 0

                    if {_score} > {_max}:

                        set {_max} to {_score}
                        set {_winner} to {_uuid}

                if {_winner} is set:

                    set {_name} to {far.player.name::%{_winner}%}

                    send "&6&l3rd &f%{_name}% &7- &e%{_max}%m" to player

                    remove {_winner} from {_remaining::*}


            # ------------------------------------------------
            # Other players
            # ------------------------------------------------

            if {_remaining::*} is set:

                send "" to player
                send "&7Other players:" to player

                loop {_remaining::*}:

                    set {_uuid} to loop-value

                    set {_name} to {far.player.name::%{_uuid}%}
                    set {_score} to {far.distance::%{_uuid}%}

                    if {_score} is not set:
                        set {_score} to 0

                    send "&7%{_name}% &f- &e%{_score}%m" to player

            send "" to player
            send "&8&m--------------------------------" to player

            stop


        # ====================================================
        # DEBUG
        # ====================================================

        if arg-1 is "debug":

            if {far.debug} is true:

                set {far.debug} to false

                send "{@prefix} &7DEBUG: &cOFF" to player

            else:

                set {far.debug} to true

                send "{@prefix} &7DEBUG: &aON" to player

            stop


        # ====================================================
        # RESET
        # ====================================================

        if arg-1 is "reset":

            # ------------------------------------------------
            # Invalidate old game
            # ------------------------------------------------

            if {far.game.id} is not set:
                set {far.game.id} to 0

            add 1 to {far.game.id}

            set {far.running} to false
            set {far.countdown} to false
            set {far.finishing} to false
            set {far.finished} to false
            set {far.debug} to false

            # ------------------------------------------------
            # BossBar
            # ------------------------------------------------

            set {_bar} to boss bar with key "{@bossbar-key}"

            if {_bar} is set:
                remove all players from viewers of {_bar}

            # ------------------------------------------------
            # Scoreboard
            # ------------------------------------------------

            execute console command "scoreboard objectives remove farDistance"

            # ------------------------------------------------
            # Variables
            # ------------------------------------------------

            delete {far.start.x}
            delete {far.start.z}
            delete {far.start.location}
            delete {far.start.world}

            delete {far.duration}
            delete {far.duration.text}

            delete {far.elapsed}
            delete {far.remaining}

            delete {far.players::*}
            delete {far.distance::*}
            delete {far.player.name::*}

            send "{@prefix} &eFarRace RESET." to player

            stop


        # ====================================================
        # HELP
        # ====================================================

        send "" to player
        send "&8&m--------------------------------" to player
        send "&b&lFarRace" to player
        send "" to player
        send "&f/far &7- Open GUI"
        send "&f/far set &7- Set start position"
        send "&f/far time 5 &7- 5 minutes"
        send "&f/far time 15 &7- 15 minutes"
        send "&f/far time 30 &7- 30 minutes"
        send "&f/far time 60 &7- 60 minutes"
        send "&f/far start &7- Start"
        send "&f/far stop &7- Stop"
        send "&f/far status &7- Status"
        send "&f/far result &7- Result"
        send "&f/far debug &7- Debug"
        send "&f/far reset &7- Reset"
        send "&8&m--------------------------------" to player


# ============================================================
# GUI CLICK
# ============================================================

on inventory click:

    if name of event-inventory is not "{@gui-name}":
        stop

    cancel event

    # ========================================================
    # SET
    # ========================================================

    if clicked slot is 10:

        close player's inventory
        make player execute command "/far set"
        stop


    # ========================================================
    # START
    # ========================================================

    if clicked slot is 12:

        close player's inventory
        make player execute command "/far start"
        stop


    # ========================================================
    # STOP
    # ========================================================

    if clicked slot is 14:

        close player's inventory
        make player execute command "/far stop"
        stop


    # ========================================================
    # RESET
    # ========================================================

    if clicked slot is 16:

        close player's inventory
        make player execute command "/far reset"
        stop


    # ========================================================
    # 5 MIN
    # ========================================================

    if clicked slot is 28:

        make player execute command "/far time 5"

        wait 1 tick

        make player execute command "/far"

        stop


    # ========================================================
    # 15 MIN
    # ========================================================

    if clicked slot is 29:

        make player execute command "/far time 15"

        wait 1 tick

        make player execute command "/far"

        stop


    # ========================================================
    # 30 MIN
    # ========================================================

    if clicked slot is 30:

        make player execute command "/far time 30"

        wait 1 tick

        make player execute command "/far"

        stop


    # ========================================================
    # 60 MIN
    # ========================================================

    if clicked slot is 31:

        make player execute command "/far time 60"

        wait 1 tick

        make player execute command "/far"

        stop


    # ========================================================
    # RESULT
    # ========================================================

    if clicked slot is 44:

        close player's inventory

        make player execute command "/far result"

        stop


    # ========================================================
    # DEBUG
    # ========================================================

    if clicked slot is 53:

        make player execute command "/far debug"

        wait 1 tick

        make player execute command "/far"

        stop


# ============================================================
# GUI DRAG
# ============================================================

on inventory drag:

    if name of event-inventory is not "{@gui-name}":
        stop

    cancel event


# ============================================================
# GAME TIMER
#
# 1秒ごと
# ============================================================

every 1 second:

    if {far.running} is not true:
        stop

    if {far.finishing} is true:
        stop

    if {far.start.x} is not set:
        stop

    if {far.duration} is not set:
        stop


    # ========================================================
    # ELAPSED
    # ========================================================

    add 1 to {far.elapsed}


    # ========================================================
    # REMAINING
    # ========================================================

    set {far.remaining} to {far.duration} - {far.elapsed}

    if {far.remaining} < 0:
        set {far.remaining} to 0


    # ========================================================
    # BOSSBAR
    # ========================================================

    set {_bar} to boss bar with key "{@bossbar-key}"

    if {_bar} is set:

        set {_minutes} to floor({far.remaining} / 60)
        set {_seconds} to {far.remaining} - ({_minutes} * 60)

        if {_seconds} < 10:

            set {_time-text} to "%{_minutes}%:0%{_seconds}%"

        else:

            set {_time-text} to "%{_minutes}%:%{_seconds}%"

        set title of {_bar} to "&bFarRace &f%{_time-text}%"

        set {_progress} to {far.remaining} / {far.duration}

        set progress of {_bar} to {_progress}


    # ========================================================
    # DISTANCE CALCULATION
    #
    # 現在地点の距離
    # ========================================================

    loop all players:

        set {_uuid} to uuid of loop-player
        set {_participant} to false

        loop {far.players::*}:

            if loop-value-2 is {_uuid}:

                set {_participant} to true
                stop loop

        if {_participant} is not true:
            stop


        # ----------------------------------------------------
        # Current position
        # ----------------------------------------------------

        set {_x} to x-coordinate of loop-player
        set {_z} to z-coordinate of loop-player


        # ----------------------------------------------------
        # Difference
        # ----------------------------------------------------

        set {_dx} to {_x} - {far.start.x}
        set {_dz} to {_z} - {far.start.z}


        # ----------------------------------------------------
        # Distance
        # ----------------------------------------------------

        set {_distance} to sqrt(({_dx} * {_dx}) + ({_dz} * {_dz}))

        set {_score} to floor({_distance})


        # ----------------------------------------------------
        # Save current distance
        # ----------------------------------------------------

        set {far.distance::%{_uuid}%} to {_score}


        # ----------------------------------------------------
        # Scoreboard
        # ----------------------------------------------------

        execute console command "scoreboard players set %loop-player% farDistance %{_score}%"


    # ========================================================
    # TIME UP
    #
    # 0:03 → 3
    # 0:02 → 2
    # 0:01 → 1
    # 0:00 → FINISH
    # ========================================================

    if {far.remaining} <= 3:

        set {_gameid} to {far.game.id}

        set {far.running} to false
        set {far.finishing} to true
        set {far.finished} to true


        # ====================================================
        # BOSSBAR 0:03
        # ====================================================

        set {_bar} to boss bar with key "{@bossbar-key}"

        if {_bar} is set:

            set title of {_bar} to "&cFarRace &f0:03"

            set {_progress} to 3 / {far.duration}

            set progress of {_bar} to {_progress}


        # ====================================================
        # 3
        # ====================================================

        send title "&c&l3" with subtitle "&7TIME UP" to all players
        play sound "block.note_block.pling" with volume 1 and pitch 1 to all players

        wait 1 second

        if {far.game.id} is not {_gameid}:
            stop


        # ====================================================
        # BOSSBAR 0:02
        # ====================================================

        set {_bar} to boss bar with key "{@bossbar-key}"

        if {_bar} is set:

            set title of {_bar} to "&6FarRace &f0:02"

            set {_progress} to 2 / {far.duration}

            set progress of {_bar} to {_progress}


        # ====================================================
        # 2
        # ====================================================

        send title "&6&l2" with subtitle "&7TIME UP" to all players
        play sound "block.note_block.pling" with volume 1 and pitch 1 to all players

        wait 1 second

        if {far.game.id} is not {_gameid}:
            stop


        # ====================================================
        # BOSSBAR 0:01
        # ====================================================

        set {_bar} to boss bar with key "{@bossbar-key}"

        if {_bar} is set:

            set title of {_bar} to "&eFarRace &f0:01"

            set {_progress} to 1 / {far.duration}

            set progress of {_bar} to {_progress}


        # ====================================================
        # 1
        # ====================================================

        send title "&e&l1" with subtitle "&7TIME UP" to all players
        play sound "block.note_block.pling" with volume 1 and pitch 1 to all players

        wait 1 second

        if {far.game.id} is not {_gameid}:
            stop


        # ====================================================
        # BOSSBAR 0:00
        # ====================================================

        set {_bar} to boss bar with key "{@bossbar-key}"

        if {_bar} is set:

            set title of {_bar} to "&cFarRace &f0:00"
            set progress of {_bar} to 0%


        set {far.remaining} to 0


        # ====================================================
        # FINAL DISTANCE
        #
        # FINISH表示直前に現在地点を最終スコアとして確定
        # ====================================================

        loop all players:

            set {_uuid} to uuid of loop-player
            set {_participant} to false

            loop {far.players::*}:

                if loop-value-2 is {_uuid}:

                    set {_participant} to true
                    stop loop

            if {_participant} is not true:
                stop


            set {_x} to x-coordinate of loop-player
            set {_z} to z-coordinate of loop-player

            set {_dx} to {_x} - {far.start.x}
            set {_dz} to {_z} - {far.start.z}

            set {_distance} to sqrt(({_dx} * {_dx}) + ({_dz} * {_dz}))

            set {_score} to floor({_distance})


            # ------------------------------------------------
            # 最終地点を保存
            # ------------------------------------------------

            set {far.distance::%{_uuid}%} to {_score}


            # ------------------------------------------------
            # 最終スコアをScoreboardに表示
            # ------------------------------------------------

            execute console command "scoreboard players set %loop-player% farDistance %{_score}%"


        # ====================================================
        # FINISH
        # ====================================================

        send title "&c&lFINISH!" to all players
        play sound "entity.player.levelup" with volume 1 and pitch 1 to all players


        # ====================================================
        # FINAL RESULTS
        # ====================================================

        send "" to all players
        send "&6&l==============================" to all players
        send "&c&l          Time Up!" to all players
        send "&e&l        Final Results" to all players
        send "&6&l==============================" to all players
        send "" to all players


        set {_remaining::*} to {far.players::*}


        # ====================================================
        # 1st
        # ====================================================

        set {_winner} to none
        set {_max} to -1

        loop {_remaining::*}:

            set {_uuid} to loop-value
            set {_score} to {far.distance::%{_uuid}%}

            if {_score} is not set:
                set {_score} to 0

            if {_score} > {_max}:

                set {_max} to {_score}
                set {_winner} to {_uuid}

        if {_winner} is set:

            set {_name} to {far.player.name::%{_winner}%}

            send "&e&l1st &f%{_name}% &7- &e%{_max}%m" to all players

            remove {_winner} from {_remaining::*}


        # ====================================================
        # 2nd
        # ====================================================

        if {_remaining::*} is set:

            set {_winner} to none
            set {_max} to -1

            loop {_remaining::*}:

                set {_uuid} to loop-value
                set {_score} to {far.distance::%{_uuid}%}

                if {_score} is not set:
                    set {_score} to 0

                if {_score} > {_max}:

                    set {_max} to {_score}
                    set {_winner} to {_uuid}

            if {_winner} is set:

                set {_name} to {far.player.name::%{_winner}%}

                send "&f&l2nd &f%{_name}% &7- &e%{_max}%m" to all players

                remove {_winner} from {_remaining::*}


        # ====================================================
        # 3rd
        # ====================================================

        if {_remaining::*} is set:

            set {_winner} to none
            set {_max} to -1

            loop {_remaining::*}:

                set {_uuid} to loop-value
                set {_score} to {far.distance::%{_uuid}%}

                if {_score} is not set:
                    set {_score} to 0

                if {_score} > {_max}:

                    set {_max} to {_score}
                    set {_winner} to {_uuid}

            if {_winner} is set:

                set {_name} to {far.player.name::%{_winner}%}

                send "&6&l3rd &f%{_name}% &7- &e%{_max}%m" to all players

                remove {_winner} from {_remaining::*}


        # ====================================================
        # Other players
        # ====================================================

        if {_remaining::*} is set:

            send "" to all players
            send "&7Other players:" to all players

            loop {_remaining::*}:

                set {_uuid} to loop-value

                set {_name} to {far.player.name::%{_uuid}%}
                set {_score} to {far.distance::%{_uuid}%}

                if {_score} is not set:
                    set {_score} to 0

                send "&7%{_name}% &f- &e%{_score}%m" to all players


        # ====================================================
        # 1秒後にスタート地点へ
        # ====================================================

        wait 1 second

        if {far.game.id} is not {_gameid}:
            stop


        loop all players:

            set {_uuid} to uuid of loop-player
            set {_participant} to false

            loop {far.players::*}:

                if loop-value-2 is {_uuid}:

                    set {_participant} to true
                    stop loop

            if {_participant} is not true:
                stop

            if {far.start.location} is set:

                teleport loop-player to {far.start.location}


        # ====================================================
        # Cleanup
        #
        # TP直後に即Cleanup
        # ====================================================

        set {_bar} to boss bar with key "{@bossbar-key}"

        if {_bar} is set:

            remove all players from viewers of {_bar}

        execute console command "scoreboard objectives remove farDistance"

        set {far.finishing} to false

        stop


# ============================================================
# DEBUG
#
# アクションバー
# ============================================================

every 1 second:

    if {far.debug} is not true:
        stop

    if {far.running} is not true:
        stop

    if {far.start.x} is not set:
        stop

    loop all players:

        set {_uuid} to uuid of loop-player
        set {_participant} to false

        loop {far.players::*}:

            if loop-value-2 is {_uuid}:

                set {_participant} to true
                stop loop

        if {_participant} is not true:
            stop


        # ----------------------------------------------------
        # Position
        # ----------------------------------------------------

        set {_x} to x-coordinate of loop-player
        set {_y} to y-coordinate of loop-player
        set {_z} to z-coordinate of loop-player


        # ----------------------------------------------------
        # Difference
        # ----------------------------------------------------

        set {_dx} to {_x} - {far.start.x}
        set {_dz} to {_z} - {far.start.z}


        # ----------------------------------------------------
        # Distance
        # ----------------------------------------------------

        set {_distance} to sqrt(({_dx} * {_dx}) + ({_dz} * {_dz}))

        set {_score} to floor({_distance})


        # ----------------------------------------------------
        # ActionBar
        # ----------------------------------------------------

        send action bar "&7X:&f %{_x}% &7Y:&f %{_y}% &7Z:&f %{_z}% &8| &7DX:&f %{_dx}% &7DZ:&f %{_dz}% &8| &aDistance:&f %{_distance}%m &8| &eScore:&f %{_score}%" to loop-player
