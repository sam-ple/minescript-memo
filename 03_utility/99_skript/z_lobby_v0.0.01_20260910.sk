```skript
# ============================================================
# LOBBY SYSTEM
# Version : v0.1.00
#
# ============================================================
#
# PURPOSE
#
#   ロビーワールドをゲームサーバーの入口として使用する。
#
#   プレイヤーがロビーに入る
#       ↓
#   「ゲームメニュー」を自動付与
#       ↓
#   右クリック
#       ↓
#   ゲーム選択GUIを表示
#       ↓
#   ゲームを選択
#       ↓
#   メニューアイテムを削除
#       ↓
#   対応するワールドへテレポート
#
#
#   ゲーム終了後
#       ↓
#   /lobby
#       ↓
#   ロビーワールドへ移動
#       ↓
#   「ゲームメニュー」を再付与
#
#
# ============================================================
# WORLD
# ============================================================
#
#   このスクリプトでは以下のワールド名を使用する。
#
#   lobby
#   tetsusen
#   linerace
#   orerace
#   bingo
#
#   Multiverse-Coreで実際に使用しているワールド名に
#   合わせて変更すること。
#
#
# ============================================================
# GAME MENU ITEM
# ============================================================
#
#   ロビーでプレイヤーが持つ専用アイテム。
#
#   右クリックするとゲーム選択GUIを開く。
#
#   今回はコンパスを使用。
#
# ============================================================


# ============================================================
# SETTINGS
# ============================================================

options:

    # --------------------------------------------------------
    # ロビーワールド
    # --------------------------------------------------------

    lobby-world: lobby

    # --------------------------------------------------------
    # ゲームワールド
    # --------------------------------------------------------

    tetsusen-world: tetsusen
    linerace-world: linerace
    orerace-world: orerace
    bingo-world: bingo

    # --------------------------------------------------------
    # メニューアイテム
    # --------------------------------------------------------

    menu-item: compass

    menu-name: &b&lゲームメニュー


# ============================================================
# FUNCTION
# Give Game Menu
#
# ロビーにいるプレイヤーへゲームメニューを渡す。
#
# 重複防止のため、先に同じアイテムを削除してから
# 1個だけ付与する。
#
# ============================================================

function giveLobbyMenu(p: player):

    # --------------------------------------------------------
    # 同じ名前のメニューアイテムを削除
    #
    # ロビーに何度も出入りした場合でも、
    # メニューアイテムが増殖しないようにする。
    # --------------------------------------------------------

    remove all {@menu-item} named "{@menu-name}" from {_p}'s inventory

    # --------------------------------------------------------
    # メニューアイテムを1個付与
    # --------------------------------------------------------

    give 1 {@menu-item} named "{@menu-name}" with lore "&7右クリックでゲームを選択"


# ============================================================
# FUNCTION
# Remove Game Menu
#
# ゲームへ移動する前にメニューアイテムを削除する。
#
# ============================================================

function removeLobbyMenu(p: player):

    remove all {@menu-item} named "{@menu-name}" from {_p}'s inventory


# ============================================================
# PLAYER JOIN
#
# サーバーへログインしたとき。
#
# ロビーがプレイヤーの現在ワールドなら
# メニューアイテムを付与する。
#
# ============================================================

on join:

    wait 2 ticks

    if world of player is world("{@lobby-world}"):

        giveLobbyMenu(player)


# ============================================================
# WORLD CHANGE
#
# プレイヤーがワールドを移動したとき。
#
# ------------------------------------------------------------
# ロビーへ入った
#     ↓
# メニューアイテムを付与
#
# ロビーから出た
#     ↓
# メニューアイテムを削除
#
# ============================================================

on world change:

    # --------------------------------------------------------
    # ロビーへ入った場合
    # --------------------------------------------------------

    if world of player is world("{@lobby-world}"):

        wait 2 ticks

        giveLobbyMenu(player)

        send "&a&lLobby &fへようこそ！" to player
        send "&7「ゲームメニュー」を右クリックしてください。" to player

        stop

    # --------------------------------------------------------
    # ロビーから別ワールドへ移動した場合
    #
    # メニューアイテムを持ち込まない。
    # --------------------------------------------------------

    removeLobbyMenu(player)


# ============================================================
# RIGHT CLICK
#
# ゲームメニューを右クリックしたときにGUIを開く。
#
# ============================================================

on right click:

    # --------------------------------------------------------
    # ロビー以外ではメニューアイテムを使用できない。
    # --------------------------------------------------------

    if world of player is not world("{@lobby-world}"):

        stop

    # --------------------------------------------------------
    # メインハンド・オフハンドのアイテムを確認
    # --------------------------------------------------------

    if player's tool is {@menu-item} named "{@menu-name}":

        cancel event

        open chest inventory with 3 rows named "&8&lGAME MENU" to player

        # ----------------------------------------------------
        # GUI
        #
        # 1段目
        #   ゲーム選択
        #
        # 2段目
        #   各ゲーム
        #
        # 3段目
        #   閉じる
        # ----------------------------------------------------

        # ----------------------------------------------------
        # TETSUSEN
        # ----------------------------------------------------

        set slot 10 of player's current inventory to iron ingot named "&f&l鉄千" with lore "&7鉄千をプレイします。", "&8クリックしてゲームへ移動"

        # ----------------------------------------------------
        # LINERACE
        # ----------------------------------------------------

        set slot 12 of player's current inventory to white wool named "&f&lLineRace" with lore "&7LineRaceをプレイします。", "&8クリックしてゲームへ移動"

        # ----------------------------------------------------
        # ORERACE
        # ----------------------------------------------------

        set slot 14 of player's current inventory to diamond named "&b&lOreRace" with lore "&7OreRaceをプレイします。", "&8クリックしてゲームへ移動"

        # ----------------------------------------------------
        # BINGO
        # ----------------------------------------------------

        set slot 16 of player's current inventory to paper named "&e&lBINGO" with lore "&7BINGOをプレイします。", "&8クリックしてゲームへ移動"

        # ----------------------------------------------------
        # CLOSE
        # ----------------------------------------------------

        set slot 22 of player's current inventory to barrier named "&c&l閉じる"


# ============================================================
# INVENTORY CLICK
#
# GUI内のゲームをクリックしたときの処理。
#
# ============================================================

on inventory click:

    # --------------------------------------------------------
    # GUIタイトルを確認
    #
    # 他のGUIには影響を与えない。
    # --------------------------------------------------------

    if name of event-inventory is "&8&lGAME MENU":

        cancel event

        # ----------------------------------------------------
        # 鉄千
        # ----------------------------------------------------

        if clicked slot is 10:

            close player's inventory

            removeLobbyMenu(player)

            send "&e&l鉄千 &fへ移動します。" to player

            # Multiverse-Coreでワールド移動
            execute console command "mvtp %player% {@tetsusen-world}"

            stop


        # ----------------------------------------------------
        # LineRace
        # ----------------------------------------------------

        if clicked slot is 12:

            close player's inventory

            removeLobbyMenu(player)

            send "&f&lLineRace &fへ移動します。" to player

            execute console command "mvtp %player% {@linerace-world}"

            stop


        # ----------------------------------------------------
        # OreRace
        # ----------------------------------------------------

        if clicked slot is 14:

            close player's inventory

            removeLobbyMenu(player)

            send "&b&lOreRace &fへ移動します。" to player

            execute console command "mvtp %player% {@orerace-world}"

            stop


        # ----------------------------------------------------
        # BINGO
        # ----------------------------------------------------

        if clicked slot is 16:

            close player's inventory

            removeLobbyMenu(player)

            send "&e&lBINGO &fへ移動します。" to player

            execute console command "mvtp %player% {@bingo-world}"

            stop


        # ----------------------------------------------------
        # CLOSE
        # ----------------------------------------------------

        if clicked slot is 22:

            close player's inventory

            stop


# ============================================================
# INVENTORY DRAG
#
# GUIへアイテムをドラッグして入れることを防止。
# ============================================================

on inventory drag:

    if name of event-inventory is "&8&lGAME MENU":

        cancel event


# ============================================================
# /LOBBY
#
# どのゲームワールドからでもロビーへ戻るためのコマンド。
#
# ------------------------------------------------------------
# 例：
#
#   /lobby
#
# ------------------------------------------------------------
#
# ロビーへ移動すると「on world change」が発生し、
# 自動的にゲームメニューが再付与される。
#
# ============================================================

command /lobby:

    trigger:

        # ----------------------------------------------------
        # すでにロビーにいる場合
        # ----------------------------------------------------

        if world of player is world("{@lobby-world}"):

            send "&7すでにロビーにいます。" to player

            giveLobbyMenu(player)

            stop

        # ----------------------------------------------------
        # ゲームメニューを削除
        # ----------------------------------------------------

        removeLobbyMenu(player)

        # ----------------------------------------------------
        # ロビーへ移動
        # ----------------------------------------------------

        execute console command "mvtp %player% {@lobby-world}"


# ============================================================
# /LOBBY RELOAD TEST
#
# 管理者用の簡単な確認コマンド。
#
# /lobbyitem
#
# ロビーにいるプレイヤーへメニューアイテムを再付与する。
#
# ============================================================

command /lobbyitem:

    permission: lobby.admin

    trigger:

        if world of player is world("{@lobby-world}"):

            giveLobbyMenu(player)

            send "&aゲームメニューを再付与しました。" to player

        else:

            send "&cロビーで実行してください。" to player


# ============================================================
# /LOBBY DEBUG
#
# 現在のワールドを確認する簡易デバッグコマンド。
#
# ============================================================

command /lobbydebug:

    permission: lobby.admin

    trigger:

        send "&8------------------------" to player
        send "&bLobby Debug" to player
        send "&7Player: &f%player%" to player
        send "&7World: &f%world of player%" to player
        send "&7Lobby World: &f{@lobby-world}" to player
        send "&8------------------------" to player


# ============================================================
# END
# ============================================================
#
# 今後ゲームを追加する場合：
#
# 1. optionsへワールド名を追加
#
# 2. GUIへアイテムを追加
#
# 3. inventory clickへ処理を追加
#
# という3か所を変更する。
#
# ============================================================
```
